<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BSBA Scanner - Student Attendance</title>
    <script src="https://unpkg.com/html5-qrcode"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            text-align: center; 
            font-family: 'Segoe UI', sans-serif; 
            background: #000; 
            color: #ffcc00; 
            padding: 10px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        h1 { margin-bottom: 5px; font-size: 1.5em; }
        p { margin-bottom: 15px; color: #aaa; }
        #reader { 
            width: 100%; 
            max-width: 500px; 
            border: 3px solid #ffcc00;
            border-radius: 10px;
            margin: 20px auto;
        }
        .session-info {
            background: #222;
            padding: 12px 15px;
            margin-bottom: 15px;
            border-radius: 8px;
            border-left: 5px solid #ffcc00;
            width: 100%;
            max-width: 500px;
        }
        .session-info p { margin: 5px 0; }
        .btn-back { 
            display: inline-block;
            margin-top: 15px; 
            color: #ffcc00; 
            text-decoration: none;
            font-weight: bold;
            border: 2px solid #ffcc00;
            padding: 12px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1em;
            transition: all 0.3s ease;
        }
        .btn-back:hover, .btn-back:active {
            background: #ffcc00;
            color: #000;
        }
        @media (max-width: 768px) {
            body { padding: 5px; }
            h1 { font-size: 1.3em; }
            #reader { max-width: 100%; }
            .btn-back { padding: 12px 15px; }
        }
    </style>
</head>
<body>
    <h1>🔍 Student Scanner</h1>
    <p style="color: #aaa;">Scan student MM-ID QR codes</p>
    
    <div class="session-info" id="sessionInfo" style="display:none;">
        <p>Session: <span id="sessionName"></span></p>
    </div>

    <div id="reader"></div>
    <a href="/dashboard" class="btn-back">✕ Cancel</a>

    <script>
        const sessionId = new URLSearchParams(window.location.search).get('sessionId');
        
        if (sessionId) {
            document.getElementById('sessionInfo').style.display = 'block';
            document.getElementById('sessionName').textContent = sessionId;
        }

        function onScanSuccess(decodedText) {
            // When QR is found, send to server with sessionId
            if (sessionId) {
                window.location.href = "/mark-attendance?code=" + decodedText + "&sessionId=" + sessionId;
            } else {
                window.location.href = "/mark-attendance?code=" + decodedText;
            }
        }

        function onScanError(error) {
            console.log("Scan error: " + error);
        }

        let html5QrcodeScanner = new Html5QrcodeScanner("reader", { 
            fps: 10, 
            qrbox: 250,
            formatsToSupport: [ Html5QrcodeSupportedFormats.QR_CODE ]
        });

        html5QrcodeScanner.render(onScanSuccess, onScanError);
    </script>
</body>
</html>