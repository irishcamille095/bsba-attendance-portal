<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BSBA Scanner - Student Attendance</title>
    <script src="https://unpkg.com/html5-qrcode"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* Scanner-specific overrides */
        body { 
            text-align: center; 
            background: #000; 
            color: #ffcc00;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            position: relative;
        }
        
        .header-container {
            width: 100%;
            padding: 5px 10px;
            text-align: center;
            position: relative;
        }
        
        .btn-back-top {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #ffcc00;
            text-decoration: none;
            font-weight: bold;
            border: 2px solid #ffcc00;
            padding: 6px 10px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.85em;
            transition: all 0.3s ease;
            background: transparent;
        }
        
        .btn-back-top:hover, .btn-back-top:active {
            background: #ffcc00;
            color: #000;
        }
        
        .header-meta {
            font-size: 0.75em;
            color: #aaa;
            margin: 0;
            padding: 0;
            line-height: 1.2;
        }
        
        h1 { 
            margin: 3px 0 0 0; 
            font-size: 1.15em;
            padding: 0;
            color: #ffcc00;
        }
        
        
        .scanner-container {
            width: 100%;
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            padding: 5px;
            overflow: hidden;
        }
        
        #reader { 
            width: 100%; 
            max-width: 500px;
            height: auto;
            flex: 1;
            border: 3px solid #ffcc00;
            border-radius: 10px;
            margin: 0;
            object-fit: cover;
        }
        
        .btn-back { 
            display: none;
        }
        
        /* Success Overlay Styles */
        .success-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            animation: fadeIn 0.3s ease-in;
        }
        
        .success-overlay.show {
            display: flex;
        }
        
        .success-content {
            background: #1a5f1a;
            border: 3px solid #00ff00;
            border-radius: 15px;
            padding: 40px 30px;
            text-align: center;
            animation: scaleIn 0.4s ease-in;
        }
        
        .checkmark {
            font-size: 4em;
            color: #00ff00;
            margin-bottom: 15px;
            animation: pulse 0.5s ease-in-out;
        }
        
        .success-text {
            font-size: 1.5em;
            color: #00ff00;
            font-weight: bold;
            margin: 0;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        @keyframes scaleIn {
            from { transform: scale(0.5); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
        
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }
        
        @media (max-width: 768px) {
            body { padding: 0; }
            .header-container { padding: 5px 50px 5px 10px; }
            h1 { font-size: 1em; }
            .header-meta { font-size: 0.7em; }
            .scanner-container {
                padding: 5px;
                gap: 8px;
            }
            #reader { max-width: 100%; }
            .btn-back { 
                padding: 8px 15px; 
                font-size: 0.85em;
                margin: 5px auto;
            }
            .btn-back-top {
                padding: 6px 10px;
                font-size: 0.8em;
            }
            .camera-select {
                font-size: 0.8em;
                padding: 6px;
            }
            .success-content {
                padding: 30px 20px;
            }
            .checkmark {
                font-size: 3em;
                margin-bottom: 10px;
            }
            .success-text {
                font-size: 1.2em;
            }
        }
    </style>
</head>
<body>
    <div class="header-container">
        <a href="/dashboard" class="btn-back-top">← Back</a>
        <p class="header-meta" id="dateSession"><span id="currentDate"></span></p>
        <h1 id="eventName">Event Scanner</h1>
    </div>
    
    <div class="scanner-container">
        <div id="reader"></div>
    </div>

    <!-- Success Overlay -->
    <div class="success-overlay" id="successOverlay">
        <div class="success-content">
            <div class="checkmark">✓</div>
            <p class="success-text">Success!</p>
        </div>
    </div>

    <script src="/attendance-confirmation.js"></script>
    <script>
        const folderId = new URLSearchParams(window.location.search).get('folderId');
        const eventName = new URLSearchParams(window.location.search).get('eventName') || 'Event Scanner';
        const sessionType = new URLSearchParams(window.location.search).get('sessionType') || '';
        let scanInProgress = false;
        let html5QrcodeScanner = null;
        
        // Set current date
        const today = new Date();
        const dateStr = today.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        
        // Update header
        if (eventName) {
            document.getElementById('dateSession').textContent = `${dateStr} • ${sessionType}`;
            document.getElementById('eventName').textContent = eventName;
        } else {
            document.getElementById('dateSession').textContent = dateStr;
        }

        function playBeep(duration = 200, frequency = 800) {
            try {
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioContext.createOscillator();
                const gainNode = audioContext.createGain();
                
                oscillator.connect(gainNode);
                gainNode.connect(audioContext.destination);
                
                oscillator.frequency.value = frequency;
                oscillator.type = 'sine';
                
                gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + duration / 1000);
                
                oscillator.start(audioContext.currentTime);
                oscillator.stop(audioContext.currentTime + duration / 1000);
            } catch (e) {
                console.log("Audio not available, continuing without sound");
            }
        }

        // Vibration feedback
        function triggerVibration() {
            if (navigator.vibrate) {
                navigator.vibrate(200);
            }
        }

        // Show success overlay
        function showSuccessOverlay() {
            const overlay = document.getElementById('successOverlay');
            overlay.classList.add('show');
            
            // Play feedback
            playBeep(200, 800);
            triggerVibration();
            
            // Hide overlay after 1.5 seconds
            setTimeout(() => {
                overlay.classList.remove('show');
            }, 1500);
        }

        async function markAttendance(code) {
            try {
                const response = await fetch(`/mark-attendance?code=${code}&folderId=${folderId}&eventName=${eventName}&sessionType=${sessionType}`);
                const data = await response.json();

                if (data.success) {
                    // Show success confirmation modal
                    window.attendanceConfirmation.show({
                        title: '✅ Attendance Marked',
                        description: 'Student attendance has been recorded successfully.',
                        studentInfo: {
                            name: data.student.name,
                            mmId: data.student.mmId,
                            session: data.student.session
                        },
                        onConfirm: () => {
                            // Redirect to attendance page when done
                            window.location.href = `/attendance?folderId=${folderId}&eventName=${eventName}&sessionType=${sessionType}`;
                        }
                    });
                } else {
                    // Show error or warning modal
                    let title = '⚠️ ' + data.message;
                    let warning = data.detail || '';
                    
                    window.attendanceConfirmation.show({
                        title: title,
                        description: warning,
                        onConfirm: () => {
                            scanInProgress = false;
                        }
                    });
                    
                    setTimeout(() => {
                        scanInProgress = false;
                    }, 3000);
                }
            } catch (error) {
                console.error('Error marking attendance:', error);
                scanInProgress = false;
            }
        }

        function onScanSuccess(decodedText) {
            // Prevent multiple rapid scans
            if (scanInProgress) return;
            scanInProgress = true;
            
            // Show success feedback
            showSuccessOverlay();
            
            // Mark attendance after showing overlay
            setTimeout(() => {
                markAttendance(decodedText);
            }, 1500);
        }

        function onScanError(error) {
            console.log("Scan error: " + error);
        }

        // Initialize scanner once DOM is ready
        function initializeScanner() {
            html5QrcodeScanner = new Html5QrcodeScanner("reader", { 
                fps: 10, 
                qrbox: 250,
                formatsToSupport: [ Html5QrcodeSupportedFormats.QR_CODE ]
            });

            html5QrcodeScanner.render(onScanSuccess, onScanError);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeScanner);
        } else {
            initializeScanner();
        }
    </script>
<%- include('./_footer.ejs') %>
</body>
</html>