<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student IDs & QR Codes</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        .header p {
            font-size: 1.1em;
            opacity: 0.9;
        }

        .controls {
            background: #f8f9fa;
            padding: 20px;
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
            border-bottom: 2px solid #e0e0e0;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            font-size: 1em;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4);
        }

        .btn-secondary {
            background: #6c757d;
            color: white;
            max-width: 200px;
        }

        .btn-secondary:hover {
            background: #5a6268;
            transform: translateY(-2px);
        }

        .btn-small {
            padding: 8px 16px;
            font-size: 0.9em;
        }

        .students-table {
            width: 100%;
            border-collapse: collapse;
            padding: 20px;
        }

        .students-table thead {
            background: #f8f9fa;
            border-bottom: 2px solid #667eea;
        }

        .students-table th {
            padding: 15px;
            text-align: left;
            font-weight: 600;
            color: #333;
        }

        .students-table tbody tr {
            border-bottom: 1px solid #e0e0e0;
            transition: background 0.3s ease;
        }

        .students-table tbody tr:hover {
            background: #f8f9fa;
        }

        .students-table td {
            padding: 15px;
        }

        .student-name {
            font-weight: 500;
            color: #333;
        }

        .student-id {
            font-family: 'Courier New', monospace;
            font-weight: 600;
            color: #667eea;
            font-size: 1.1em;
        }

        .qr-thumbnail {
            width: 50px;
            height: 50px;
            border: 1px solid #ddd;
            border-radius: 5px;
            cursor: pointer;
            transition: transform 0.3s ease;
        }

        .qr-thumbnail:hover {
            transform: scale(1.1);
        }

        .actions {
            display: flex;
            gap: 10px;
        }

        .btn-download {
            background: #28a745;
            color: white;
            padding: 6px 12px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 0.9em;
            transition: all 0.3s ease;
        }

        .btn-download:hover {
            background: #218838;
            transform: translateY(-1px);
        }

        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            animation: fadeIn 0.3s ease;
        }

        .modal-content {
            background-color: white;
            margin: 10% auto;
            padding: 30px;
            border-radius: 10px;
            width: 80%;
            max-width: 500px;
            text-align: center;
            box-shadow: 0 5px 30px rgba(0, 0, 0, 0.3);
        }

        .modal-content img {
            max-width: 100%;
            height: auto;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
            transition: color 0.3s ease;
        }

        .close:hover {
            color: #000;
        }

        .stats {
            background: #f8f9fa;
            padding: 20px;
            text-align: center;
            color: #666;
            border-top: 2px solid #e0e0e0;
        }

        .stats strong {
            color: #667eea;
            font-size: 1.3em;
        }

        .search-box {
            margin: 20px;
            display: flex;
            gap: 10px;
        }

        .search-box input {
            flex: 1;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 1em;
            transition: border-color 0.3s ease;
        }

        .search-box input:focus {
            outline: none;
            border-color: #667eea;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        @media (max-width: 768px) {
            .header h1 {
                font-size: 1.8em;
            }

            .controls {
                flex-direction: column;
                gap: 8px;
                align-items: center;
            }

            .btn {
                width: 100%;
                padding: 11px 12px;
                font-size: 0.95em;
            }

            .btn-secondary {
                width: auto;
                max-width: 200px;
                padding: 10px 15px;
            }

            .students-table {
                font-size: 0.9em;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

            .students-table thead {
                display: none;
            }

            .students-table tbody {
                display: block;
            }

            .students-table tr {
                display: block;
                margin-bottom: 10px;
                border: 1px solid #ddd;
                border-radius: 5px;
                background: white !important;
                padding: 10px;
            }

            .students-table td {
                display: block;
                text-align: right;
                padding: 8px 0;
                border-bottom: 1px solid #f0f0f0;
                position: relative;
                padding-left: 40%;
            }

            .students-table td:before {
                content: attr(data-label);
                position: absolute;
                left: 0;
                font-weight: bold;
                color: #667eea;
                width: 38%;
                text-align: left;
            }

            .students-table td:last-child {
                border-bottom: none;
            }

            .qr-thumbnail {
                width: 40px;
                height: 40px;
                max-width: 100%;
                height: auto;
            }

            .actions {
                justify-content: flex-end;
                flex-direction: column;
                gap: 5px;
            }

            .btn-download {
                width: 100%;
                padding: 8px;
                font-size: 0.85em;
            }

            .search-box {
                margin: 10px;
                padding: 10px;
            }

            .search-box input {
                padding: 10px;
                font-size: 16px;
            }
        }

        @media (max-width: 480px) {
            .header h1 {
                font-size: 1.4em;
            }

            .students-table, .students-table td {
                font-size: 0.8em;
            }

            .qr-thumbnail {
                width: 30px;
                height: 30px;
            }

            .btn-download {
                padding: 6px;
                font-size: 0.8em;
            }
        }

        @media print {
            body {
                background: white;
            }
            .controls, .search-box, .stats {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📋 Student IDs & QR Codes</h1>
            <p>Manage and view all student identification with QR codes</p>
        </div>

        <div class="controls">
            <a href="/print-student-cards" class="btn btn-primary">🖨️ Print Mini ID Cards</a>
            <a href="/dashboard" class="btn btn-secondary">🏠 Back to Dashboard</a>
        </div>

        <div class="search-box">
            <input 
                type="text" 
                id="searchInput" 
                placeholder="Search by name or student ID (MM-XXX)..."
                onkeyup="filterTable()"
            >
        </div>

        <% if (students.length > 0) { %>
            <table class="students-table" id="studentTable">
                <thead>
                    <tr>
                        <th style="width: 30%;">Student Name</th>
                        <th style="width: 20%;">MM-ID</th>
                        <th style="width: 15%;">QR Code</th>
                        <th style="width: 35%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% students.forEach((student) => { %>
                        <tr class="student-row" data-name="<%= student.name %>" data-id="<%= student.mmId %>">
                            <td class="student-name" data-label="Student Name"><%= student.name %></td>
                            <td class="student-id" data-label="MM-ID"><%= student.mmId %></td>
                            <td data-label="QR Code">
                                <img 
                                    src="<%= student.qrCode %>" 
                                    alt="QR Code for <%= student.mmId %>"
                                    class="qr-thumbnail"
                                    onclick="showModal('<%= student.qrCode %>', '<%= student.mmId %>')"
                                    title="Click to expand"
                                >
                            </td>
                            <td data-label="Actions">
                                <div class="actions">
                                    <button class="btn-download" onclick="downloadQR('<%= student._id %>', '<%= student.name %>')">
                                        ⬇️ Download QR
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>

            <div class="stats">
                Total Students: <strong><%= students.length %></strong> 
                <span id="filteredCount"></span>
            </div>
        <% } else { %>
            <div style="padding: 40px; text-align: center; color: #999;">
                <h3>No students found</h3>
                <p>There are currently no students with QR codes.</p>
            </div>
        <% } %>
    </div>

    <!-- Modal for expanded QR code view -->
    <div id="qrModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal()">&times;</span>
            <h2 id="qrModalTitle"></h2>
            <img id="qrModalImage" src="" alt="Expanded QR Code">
            <p style="color: #666; margin-top: 15px;">Right-click to save image</p>
        </div>
    </div>

    <script>
        function showModal(qrCode, mmId) {
            const modal = document.getElementById('qrModal');
            const img = document.getElementById('qrModalImage');
            const title = document.getElementById('qrModalTitle');
            
            img.src = qrCode;
            title.textContent = `QR Code: ${mmId}`;
            modal.style.display = 'block';
        }

        function closeModal() {
            document.getElementById('qrModal').style.display = 'none';
        }

        window.onclick = function(event) {
            const modal = document.getElementById('qrModal');
            if (event.target === modal) {
                modal.style.display = 'none';
            }
        }

        function downloadQR(studentId, studentName) {
            window.location.href = `/api/download-qr/${studentId}`;
        }

        function filterTable() {
            const input = document.getElementById('searchInput');
            const filter = input.value.toLowerCase();
            const table = document.getElementById('studentTable');
            const rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');
            let visibleCount = 0;

            for (let i = 0; i < rows.length; i++) {
                const name = rows[i].getAttribute('data-name').toLowerCase();
                const id = rows[i].getAttribute('data-id').toLowerCase();
                
                if (name.includes(filter) || id.includes(filter)) {
                    rows[i].style.display = '';
                    visibleCount++;
                } else {
                    rows[i].style.display = 'none';
                }
            }

            const countSpan = document.getElementById('filteredCount');
            if (visibleCount !== rows.length) {
                countSpan.textContent = ` | Showing: ${visibleCount}`;
            } else {
                countSpan.textContent = '';
            }
        }
    </script>
</body>
</html>
