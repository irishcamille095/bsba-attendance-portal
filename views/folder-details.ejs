<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= folder.name %> - Attendance Records</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <script src="/delete-confirmation.js"></script>
    <style>
        /* Folder-details-specific overrides */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body { 
            font-family: 'Inter', 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background-color: #121212;
            display: flex;
        }

        /* Sidebar */
        .sidebar { 
            width: 250px;
            background: #000;
            color: #ffcc00;
            height: 100vh;
            position: fixed;
            padding: 20px;
            border-right: 4px solid #ffcc00;
            overflow-y: auto;
        }

        .sidebar h2 {
            border-bottom: 2px solid #ffcc00;
            padding-bottom: 10px;
            text-align: center;
            margin-bottom: 20px;
        }
        
        /* Sidebar Menu Item Hover Styles */
        .sidebar a:hover,
        .sidebar div[onclick]:hover {
            color: #FFD700 !important;
            background: rgba(255, 204, 0, 0.15) !important;
            padding-left: 16px !important;
            transition: all 0.2s ease !important;
        }

        .sidebar p {
            color: #fff;
            margin-bottom: 8px;
        }

        .logout-btn {
            background: #ffcc00;
            color: #000;
            border: none;
            padding: 12px;
            width: 100%;
            margin-top: 30px;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .logout-btn:hover {
            background: #e6b800;
        }
        
        /* Sidebar Notification Badge */
        .sidebar-notification-badge {
            display: inline-block;
            background: #ff4444;
            color: white;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            line-height: 20px;
            text-align: center;
            font-size: 0.7em;
            font-weight: bold;
            margin-left: 8px;
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(255, 68, 68, 0.7); }
            50% { box-shadow: 0 0 0 8px rgba(255, 68, 68, 0); }
        }

        /* Main Content */
        .content {
            flex: 1;
            margin-left: 290px;
            padding: 30px;
        }

        .container { 
            max-width: 1200px;
            margin: auto;
            background: #1e1e1e;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.3);
            border-left: 5px solid #ffcc00;
            border: 1px solid #2d2d2d;
        }

        .nav-links { 
            margin-bottom: 25px;
            display: flex;
            gap: 20px;
            border-bottom: 2px solid #2d2d2d;
            padding-bottom: 15px;
        }

        .nav-links a { 
            text-decoration: none;
            font-weight: 700;
            font-size: 1em;
            transition: all 0.3s ease;
            color: #ffcc00;
        }

        .nav-links a:hover {
            color: #fff;
        }

        .btn-back { color: #ffcc00; }
        .btn-dash { color: #ffcc00; }

        h1 {
            color: #ffcc00;
            font-size: 2em;
            margin: 20px 0;
        }

        h2 {
            color: #ffcc00;
            font-size: 1.5em;
            margin: 20px 0 15px 0;
            border-bottom: 2px solid #2d2d2d;
            padding-bottom: 10px;
        }

        h3 {
            color: #ffcc00;
            font-size: 1.2em;
            margin: 15px 0;
        }
        
        p {
            color: #e0e0e0;
        }

        .event-row { 
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
        }

        .event-card { 
            flex: 1;
            display: block;
            padding: 16px;
            background: #252525;
            border: 1px solid #2d2d2d;
            border-left: 5px solid #ffcc00;
            text-decoration: none;
            color: #e0e0e0;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .event-card:hover { 
            transform: translateX(5px);
            background: #2a2a2a;
            border-color: #ffcc00;
            box-shadow: 0 4px 12px rgba(255, 204, 0, 0.2);
        }

        .btn-delete-event { 
            background: #fff5f5;
            color: #dc3545;
            padding: 12px 16px;
            border-radius: 8px;
            border: 2px solid #dc3545;
            font-size: 0.95rem;
            cursor: pointer;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .btn-delete-event:hover { 
            background: #dc3545;
            color: white;
            transform: translateY(-2px);
        }

        .btn-download { 
            background: #ffcc00;
            color: #000;
            padding: 12px 20px;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .btn-download:hover {
            background: #e6b800;
            transform: translateY(-2px);
        }

        .search-box { 
            width: 100%;
            padding: 14px;
            margin: 20px 0;
            border: 1px solid #2d2d2d;
            background: #252525;
            color: #e0e0e0;
            border-radius: 8px;
            font-size: 1rem;
            font-family: inherit;
            transition: all 0.3s ease;
        }

        .search-box:focus { 
            outline: none;
            border-color: #ffcc00;
            box-shadow: 0 0 0 3px rgba(255, 204, 0, 0.1);
        }

        .year-level-section {
            margin-top: 30px;
            margin-bottom: 30px;
            border-left: 5px solid #ffcc00;
        }

        .year-level-header {
            background: #252525;
            padding: 16px;
            border-bottom: 2px solid #ffcc00;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .year-level-title {
            color: #ffcc00;
            font-size: 1.2em;
            font-weight: 700;
            margin: 0;
        }

        .attendance-percentage {
            font-size: 0.8rem;
            color: #e0e0e0;
            background: #1e1e1e;
            padding: 8px 12px;
            border-radius: 6px;
            border: 1px solid #2d2d2d;
        }

        table { 
            width: 100%;
            border-collapse: collapse;
            margin-top: 0;
        }

        .table-wrapper {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border-radius: 8px;
        }

        .table-wrapper table {
            min-width: 600px;
        }

        th { 
            background-color: #000;
            color: #ffcc00;
            padding: 16px;
            text-align: left;
            font-size: 0.95rem;
            font-weight: 700;
            border-bottom: 2px solid #ffcc00;
        }

        td { 
            padding: 14px 16px;
            border-bottom: 1px solid #2d2d2d;
            color: #e0e0e0;
        }

        tr:nth-child(even) { 
            background-color: #252525;
        }

        tr:hover {
            background-color: #2a2a2a;
        }

        .action-cell { 
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: center;
        }

        .btn-delete { 
            background: #dc3545;
            color: white;
            padding: 8px 12px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .btn-delete:hover { 
            background: #c82333;
            transform: translateY(-2px);
        }

        .role-select { 
            padding: 8px 12px;
            border: 1px solid #2d2d2d;
            background: #252525;
            color: #ffcc00;
            border-radius: 6px;
            font-size: 0.9rem;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .role-select:focus {
            outline: none;
            border-color: #ffcc00;
            box-shadow: 0 0 0 3px rgba(255, 204, 0, 0.1);
        }
        
        .role-select option {
            background: #1e1e1e;
            color: #e0e0e0;
        }

        .modal { 
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            align-items: center;
            justify-content: center;
        }

        .modal.show { 
            display: flex;
        }

        .modal-content { 
            background-color: #1e1e1e;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
            max-width: 450px;
            width: 90%;
            border: 1px solid #2d2d2d;
            border-left: 5px solid #ffcc00;
        }

        .modal-header { 
            font-size: 1.3rem;
            font-weight: 700;
            color: #ffcc00;
            margin-bottom: 15px;
        }

        .modal-body { 
            margin: 15px 0;
            color: #e0e0e0;
        }

        .modal-buttons { 
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            margin-top: 20px;
        }

        .btn-confirm { 
            background: #ffcc00;
            color: #000;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .btn-confirm:hover { 
            background: #e6b800;
            transform: translateY(-2px);
        }

        .btn-cancel { 
            background: #555;
            color: #e0e0e0;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .btn-cancel:hover { 
            background: #666;
            transform: translateY(-2px);
        }

        .hidden { 
            display: none;
        }

        .success-msg { 
            color: #4ade80;
            font-weight: 700;
            padding: 15px;
            background: #0f3f1f;
            border-radius: 8px;
            margin: 15px 0;
            border: 2px solid #22c55e;
        }

        .error-msg { 
            color: #ff6b6b;
            font-weight: 700;
            padding: 15px;
            background: #3f0f0f;
            border-radius: 8px;
            margin: 15px 0;
            border: 2px solid #dc3545;
        }

        .create-event-section {
            background: #252525;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 8px;
            border-left: 5px solid #ffcc00;
            border: 1px solid #2d2d2d;
        }

        .create-event-section h3 {
            color: #ffcc00;
            margin-top: 0;
        }

        .create-event-section input {
            padding: 12px;
            border-radius: 6px;
            border: 1px solid #2d2d2d;
            background: #1e1e1e;
            color: #e0e0e0;
            font-family: inherit;
            transition: all 0.3s ease;
        }

        .create-event-section input:focus {
            outline: none;
            border-color: #ffcc00;
            box-shadow: 0 0 0 3px rgba(255, 204, 0, 0.1);
        }

        .create-event-section button {
            background: #ffcc00;
            color: #000;
            padding: 12px 20px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 700;
            border: none;
            transition: all 0.3s ease;
        }

        .create-event-section button:hover {
            background: #e6b800;
            color: #000;
        }
        
        .create-event-section p {
            color: #999;
        }
        
        .create-event-section code {
            background: #1e1e1e;
            color: #ffcc00;
            padding: 2px 6px;
            border-radius: 4px;
            border: 1px solid #2d2d2d;
        }

        @media (max-width: 768px) {
            body { 
                display: block; 
            }

            .sidebar {
                position: fixed;
                left: 0;
                top: 50px;
                width: 100%;
                height: auto;
                max-height: calc(100vh - 50px);
                transform: translateX(-100%);
                transition: transform 0.3s ease;
                z-index: 2000;
                padding: 15px;
                border-right: none;
                border-bottom: 2px solid #ffcc00;
                overflow-y: auto;
            }

            .sidebar.active {
                transform: translateX(0);
            }

            .content {
                margin-left: 0 !important;
                width: 100%;
                padding: 15px;
                margin-top: 0;
            }

            .container {
                padding: 15px;
                margin-top: 0;
            }

            .nav-links {
                flex-wrap: wrap;
                gap: 8px;
                margin-bottom: 15px;
            }

            .nav-links a {
                padding: 8px 12px;
                font-size: 0.9em;
            }

            h1 {
                font-size: 1.3em;
                margin: 15px 0;
            }

            h2 {
                font-size: 1.2em;
                margin: 15px 0 10px 0;
            }

            h3 {
                font-size: 1.1em;
            }

            .event-row {
                flex-direction: row;
                gap: 10px;
                margin-bottom: 10px;
                flex-wrap: nowrap;
            }

            .event-card {
                padding: 12px;
                font-size: 0.95em;
                flex: 3;
            }

            .btn-delete-event {
                flex: 1;
                white-space: nowrap;
            }

            .table-wrapper {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                margin-bottom: 15px;
                width: 100%;
            }

            /* Responsive Table */
            table {
                font-size: 0.85em;
                border-collapse: collapse;
                background: #1e1e1e;
                display: table;
                width: 100%;
                min-width: 950px;
            }

            thead {
                display: table-header-group;
            }

            tbody {
                display: table-row-group;
            }

            tr {
                display: table-row;
                border: none;
                margin: 0;
                padding: 0;
            }

            th {
                display: table-cell;
                background-color: #000 !important;
                color: #ffcc00 !important;
                font-weight: 700 !important;
                border-bottom: 2px solid #ffcc00 !important;
                padding: 12px !important;
                text-align: left !important;
                border: none !important;
                margin: 0 !important;
            }

            td {
                display: table-cell;
                padding: 12px;
                border-bottom: 1px solid #2d2d2d;
                text-align: left;
                color: #e0e0e0;
                background: inherit;
                margin: 0;
            }

            tr:nth-child(even) {
                background-color: #252525 !important;
            }

            tr:nth-child(odd) {
                background-color: #1e1e1e !important;
            }

            tr:hover {
                background-color: #2a2a2a !important;
            }

            .action-cell {
                display: table-cell;
                padding: 12px;
                border-bottom: 1px solid #2d2d2d;
                text-align: left;
                color: #e0e0e0;
                align-items: center;
            }

            .btn-delete {
                background: #dc3545;
                color: white;
                padding: 8px 12px;
                border: none;
                border-radius: 6px;
                cursor: pointer;
                font-size: 0.8em;
                font-weight: 700;
                white-space: nowrap;
                transition: all 0.3s ease;
            }

            .btn-delete:hover {
                background: #c82333;
                transform: translateY(-2px);
            }

            .search-box {
                padding: 12px;
                font-size: 16px;
            }

            .create-event-section {
                padding: 15px;
                margin-bottom: 15px;
            }

            .create-event-section form {
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .create-event-section input {
                padding: 11px;
                font-size: 16px;
            }

            .create-event-section button {
                padding: 11px;
                width: 100%;
            }

            .modal-content {
                width: 90%;
                padding: 20px;
            }

            .btn-download {
                padding: 10px 15px;
                font-size: 0.9em;
                width: 100%;
                text-align: center;
            }

            .role-select {
                padding: 8px;
            }
        }

        @media (max-width: 480px) {
            .content {
                padding: 8px;
                margin-top: 0;
            }

            .container {
                padding: 12px;
                margin-top: 0;
            }

            h1 {
                font-size: 1.2em;
                margin: 10px 0;
            }

            h2 {
                font-size: 1.1em;
                margin: 10px 0 8px 0;
            }

            .nav-links {
                margin-bottom: 10px;
                padding-bottom: 10px;
            }

            .nav-links a {
                font-size: 0.85em;
                padding: 6px 10px;
            }

            table {
                font-size: 0.75em;
                display: table;
                border-collapse: collapse;
                background: #1e1e1e;
                min-width: 850px;
                width: 100%;
            }

            thead {
                display: table-header-group;
            }

            tbody {
                display: table-row-group;
            }

            tr {
                display: table-row;
            }

            th {
                display: table-cell;
                background-color: #000 !important;
                color: #ffcc00 !important;
                font-weight: 700 !important;
                border-bottom: 2px solid #ffcc00 !important;
                padding: 10px !important;
                text-align: left !important;
                border: none !important;
            }

            td {
                display: table-cell !important;
                padding: 8px !important;
                border-bottom: 1px solid #2d2d2d !important;
                text-align: left !important;
                color: #e0e0e0 !important;
                background: inherit !important;
                padding-left: 8px !important;
                min-width: auto !important;
            }

            td:last-child {
                min-width: auto !important;
            }

            td:before {
                display: none !important;
                width: auto !important;
            }

            tr:nth-child(even) {
                background-color: #252525 !important;
            }

            tr:nth-child(odd) {
                background-color: #1e1e1e !important;
            }

            tr:hover {
                background-color: #2a2a2a !important;
            }

            .event-card {
                padding: 10px;
                font-size: 0.9em;
            }

            .btn-delete-event {
                padding: 8px 6px;
                font-size: 0.8em;
            }

            .btn-delete {
                background: #dc3545;
                color: white;
                padding: 6px 8px;
                border: none;
                border-radius: 6px;
                cursor: pointer;
                font-size: 0.75em;
                font-weight: 700;
                white-space: nowrap;
                transition: all 0.3s ease;
                display: table-cell;
            }

            .btn-delete:hover {
                background: #c82333;
                transform: translateY(-2px);
            }

            .btn-download {
                padding: 9px 12px;
                font-size: 0.85em;
            }

            .create-event-section {
                padding: 12px;
            }

            .create-event-section input {
                padding: 10px;
            }

            .action-cell {
                display: table-cell !important;
                padding: 8px !important;
                border-bottom: 1px solid #2d2d2d !important;
                text-align: left !important;
                gap: 4px;
            }
        }

        header {
            display: none;
        }

        header.mobile-header {
            display: flex !important;
            position: sticky;
            top: 0;
            left: 0;
            right: 0;
            background: #ffcc00;
            color: #000;
            padding: 10px 12px;
            align-items: center;
            z-index: 1001;
        }

        @media (max-width: 768px) {
            header.mobile-header {
                display: flex !important;
            }
            
            /* Ensure table Actions column doesn't disappear */
            th, td {
                min-width: 60px;
            }
            
            th:last-child, td:last-child {
                min-width: 100px;
            }
        }

        /* Fines and Status Styling */
        .status-present {
            color: #4ade80;
            font-weight: 700;
            padding: 4px 8px;
            background: #0f3f1f;
            border-radius: 4px;
            border: 1px solid #22c55e;
            display: inline-block;
        }

        .status-absent {
            color: #ff6b6b;
            font-weight: 700;
            padding: 4px 8px;
            background: #3f0f0f;
            border-radius: 4px;
            border: 1px solid #dc3545;
            display: inline-block;
        }

        .status-excused {
            color: #fbbf24;
            font-weight: 700;
            padding: 4px 8px;
            background: #3f2d0f;
            border-radius: 4px;
            border: 1px solid #fbbf24;
            display: inline-block;
        }

        .fine-amount {
            color: #ffcc00;
            font-weight: 700;
            padding: 4px 8px;
            background: #2d2d00;
            border-radius: 4px;
            border: 1px solid #ffcc00;
            display: inline-block;
        }

        .btn-excused {
            background: #fbbf24;
            color: #000;
            padding: 8px 12px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .btn-excused:hover {
            background: #f59e0b;
            transform: translateY(-2px);
        }

        .btn-undo-excused {
            background: #6b7280;
            color: white;
            padding: 8px 12px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .btn-undo-excused:hover {
            background: #4b5563;
            transform: translateY(-2px);
        }

        /* Modal Styles for Excused Confirmation */
        .excused-modal {
            display: none;
            position: fixed;
            z-index: 2000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.7);
            align-items: center;
            justify-content: center;
        }

        .excused-modal.show {
            display: flex;
        }

        .excused-modal-content {
            background-color: #1e1e1e;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.5);
            max-width: 500px;
            width: 90%;
            border: 1px solid #2d2d2d;
            border-left: 5px solid #fbbf24;
        }

        .excused-modal-header {
            font-size: 1.3rem;
            font-weight: 700;
            color: #fbbf24;
            margin-bottom: 15px;
        }

        .excused-modal-body {
            margin: 15px 0;
            color: #e0e0e0;
            line-height: 1.6;
        }

        .excused-modal-buttons {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            margin-top: 20px;
        }

        .btn-confirm-excused {
            background: #fbbf24;
            color: #000;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .btn-confirm-excused:hover {
            background: #f59e0b;
            transform: translateY(-2px);
        }

        .btn-cancel-excused {
            background: #555;
            color: #e0e0e0;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .btn-cancel-excused:hover {
            background: #666;
            transform: translateY(-2px);
        }
    </style>
    </style>
</head>
<body>

    <div class="sidebar" id="sidebar">
    <button class="sidebar-close-btn" onclick="toggleSidebar()"><i class="fas fa-times"></i></button>
    
    <hr style="border: 1px solid #FFD700; margin: 50px 0 15px 0;">
    
    <!-- Sidebar Menu Items -->
    <a href="/my-account" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
        <i class="fas fa-user"></i> <span style="font-weight: bold;">Account Profile</span>
    </a>
    
    <a href="/dashboard" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
        <i class="fas fa-camera"></i> <span style="font-weight: bold;">Attendance</span>
    </a>
    
    <% if (user.role === 'officer' || user.role === 'adviser') { %>
    <a href="/admin/students" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
        <i class="fas fa-users"></i> <span style="font-weight: bold;">Master Student List</span>
    </a>
    <% } %>
    
    <% if (user.role === 'officer' || user.role === 'adviser') { %>
    <a href="/fines-management" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
        <i class="fas fa-file-invoice-dollar"></i> <span style="font-weight: bold;">Fines Management</span>
    </a>
    <% } %>
    
    <a href="/my-documents" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
        <i class="fas fa-file-contract"></i> <span style="font-weight: bold;">My Documents</span>
    </a>
    

    

    
    <hr style="border: 1px solid #FFD700; margin: 15px 0;">
    
    <form action="/logout" method="POST" style="margin-top: 15px; display: block !important;">
        <button type="submit" class="back-btn" style="width: 100%; padding: 12px; background: #FFD700; color: #121212; border: none; border-radius: 12px; font-weight: bold; cursor: pointer; display: block;">
            <i class="fas fa-sign-out-alt"></i> Logout
        </button>
    </form>
</div>

    <div class="content">
        <div class="container">
            <div class="nav-links">
                <a href="javascript:history.back()" class="btn-back">← Back</a>
                <a href="/dashboard" class="btn-dash">🏠 Back to Dashboard</a>
            </div>

            <h1>📁 <%= folder.name %></h1>

        <% if (!selectedEvent) { %>
            <% if (user.role === 'officer' || user.role === 'adviser') { %>
                <div style="margin-bottom: 20px;">
                    <button onclick="toggleEventForm()" style="background: #FFD700; color: #121212; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: bold; transition: all 0.3s;">
                        <i class="fas fa-plus"></i> Create New Event
                    </button>
                </div>
                <div id="eventForm" class="create-event-section" style="display: none;">
                    <h3 style="margin-top: 0;">➕ Create New Event</h3>
                    <p style="color: #999; font-size: 0.9em;">📁 Folder ID: <code><%= folder._id %></code></p>
                    <form action="/create-event/<%= folder._id %>" method="POST" style="display: flex; gap: 10px; align-items: flex-end;">
                        <input type="text" name="eventName" placeholder="Event Name (e.g., Christmas Party, Monthly Meeting)" required style="flex: 1; padding: 10px; border-radius: 5px;">
                        <select name="eventType" required style="padding: 10px; border-radius: 5px; background: #1e1e1e; color: #e0e0e0; border: 1px solid #2d2d2d;">
                            <option value="">Select Event Type...</option>
                            <option value="Half Day">Half Day (₱50 per Absent)</option>
                            <option value="Whole Day">Whole Day (₱30 per Absent)</option>
                        </select>
                        <button type="submit" style="padding: 10px 20px; border-radius: 5px; cursor: pointer; font-weight: bold;">✓ Create</button>
                    </form>
                </div>
            <% } %>

            <h3>📅 Events in this Folder:</h3>
            <p style="color: #999; font-size: 0.9em;">Click an event to view attendance records.</p>
            <div style="margin-top: 20px;">
                <% if (sessions && sessions.length > 0) { %>
                    <% sessions.forEach(session => { %>
                        <div class="event-row">
                            <a href="/folder-details/<%= folder._id %>?event=<%= encodeURIComponent(session.eventName) %>" class="event-card">
                                📅 <%= session.eventName %>
                            </a>

                            <% if (user.role === 'officer' || user.role === 'adviser') { %>
                                <button type="button" class="btn-delete-event" onclick="deleteEvent('<%= session._id %>', '<%= folder._id %>', '<%= session.eventName %>')">
                                   🗑️ Delete
                                </button>
                            <% } %>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p style="color: #999; font-style: italic;">No events found in this folder yet.</p>
                <% } %>
            </div>

        <% } else { %>
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #ffcc00; margin-bottom: 15px; padding-bottom: 10px; flex-wrap: wrap; gap: 10px;">
                <h2 style="margin: 0; flex: 1; border: none; padding: 0;">Event: <%= selectedEvent %></h2>

                <% if (user.role === 'officer' || user.role === 'adviser') { %>
                    <a href="/download-attendance/<%= folder._id %>?event=<%= encodeURIComponent(selectedEvent) %>" class="btn-download">
                        📥 Download CSV
                    </a>
                <% } %>
            </div>

            <!-- Search Bar (officers/advisers only) -->
            <% if (user.role === 'officer' || user.role === 'adviser') { %>
                <div style="margin: 15px 0;">
                    <input type="text" id="searchInput" class="search-box" placeholder="🔍 Search by Student Name or ID (MM-XXX)..." onkeyup="filterTable()">
                </div>
            <% } %>

            <div id="message"></div>
            
            <% const isHalfDay = selectedEventType === 'Half Day'; %>
            <% if (user.role === 'student') { %>
                <% const myRecord = (attendanceData || []).find(r => r.studentId === user.mmId); %>
                <% if (myRecord) { %>
                    <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Student ID</th>
                                <th>Student Name</th>
                                <th><%= isHalfDay ? 'IN' : 'AM IN' %></th>
                                <th><%= isHalfDay ? 'OUT' : 'AM OUT' %></th>
                                <% if (!isHalfDay) { %>
                                    <th>PM IN</th>
                                    <th>PM OUT</th>
                                <% } %>
                            </tr>
                        </thead>
                        <tbody id="attendanceTable">
                            <tr class="attendance-row" data-student-id="<%= myRecord.studentId %>" data-student-name="<%= myRecord.studentName %>" data-year-level="<%= myRecord.yearLevel %>">
                                <td data-label="Student ID"><strong><%= myRecord.studentId %></strong></td>
                                <td data-label="Student Name"><%= myRecord.studentName %></td>
                                <td data-label="<%= isHalfDay ? 'IN' : 'AM IN' %>"><%= formatPhilippinesTime(myRecord.amIn) %></td>
                                <td data-label="<%= isHalfDay ? 'OUT' : 'AM OUT' %>"><%= formatPhilippinesTime(myRecord.amOut) %></td>
                                <% if (!isHalfDay) { %>
                                    <td data-label="PM IN"><%= formatPhilippinesTime(myRecord.pmIn) %></td>
                                    <td data-label="PM OUT"><%= formatPhilippinesTime(myRecord.pmOut) %></td>
                                <% } %>
                            </tr>
                        </tbody>
                    </table>
                    </div>
                <% } else { %>
                    <p style="color: #999; font-style: italic; padding: 20px; text-align: center;">You have not recorded your attendance for this event yet.</p>
                <% } %>
            <% } else { %>
                <% if (attendanceData && attendanceData.length > 0) { %>
                    <!-- Year Level Tabs (Like Excel Sheets) -->
                    <% const yearLevelOrder = ['1st Year', '2nd Year', '3rd Year', '4th Year']; %>
                    <% const yearLevelsWithData = yearLevelOrder.filter(yearLevel => attendanceData.some(r => r.yearLevel === yearLevel)); %>
                    
                    <div style="border-bottom: 2px solid #2d2d2d; margin-bottom: 20px; display: flex; gap: 5px; overflow-x: auto; padding-bottom: 0;">
                        <% yearLevelsWithData.forEach((yearLevel, index) => { %>
                            <button 
                                class="year-level-tab" 
                                onclick="switchYearLevel('<%= yearLevel.replace(/ /g, '-') %>')"
                                style="
                                    padding: 12px 20px;
                                    background: <%= index === 0 ? '#800000' : '#252525' %>;
                                    color: <%= index === 0 ? '#FFD700' : '#999' %>;
                                    border: none;
                                    border-bottom: 3px solid <%= index === 0 ? '#FFD700' : 'transparent' %>;
                                    cursor: pointer;
                                    font-weight: 600;
                                    transition: all 0.3s;
                                    white-space: nowrap;
                                    border-radius: 8px 8px 0 0;
                                "
                                onmouseover="if (!this.id.startsWith('active')) this.style.background = '#333333'"
                                onmouseout="if (!this.id.startsWith('active')) this.style.background = '#252525'"
                                id="<%= index === 0 ? 'active-tab' : '' %>"
                            >
                                <%= yearLevel %>
                            </button>
                        <% }) %>
                    </div>

                    <!-- Year Level Content Sections -->
                    <% yearLevelOrder.forEach((yearLevel, mainIndex) => { %>
                        <% const studentsInYear = attendanceData.filter(r => r.yearLevel === yearLevel); %>
                        <% if (studentsInYear.length > 0) { %>
                            <div class="year-level-section" id="tab-<%= yearLevel.replace(/ /g, '-') %>" style="display: <%= yearLevelsWithData.indexOf(yearLevel) === 0 ? 'block' : 'none' %>;">
                                <div class="year-level-header">
                                    <h3 class="year-level-title">📅 <%= yearLevel %></h3>
                                    <div class="attendance-percentage">
                                        <% const presentCount = studentsInYear.filter(r => r.amIn || r.pmIn).length; %>
                                        <% const attendancePercentage = Math.round((presentCount / studentsInYear.length) * 100); %>
                                        <strong style="color: #ffcc00;"><%= yearLevel %> Attendance:</strong> <span style="color: #4ade80;"><%= attendancePercentage %>%</span> (<%= presentCount %>/<%= studentsInYear.length %> Present)
                                    </div>
                                </div>
                                <div class="table-wrapper">
                                    <table>
                                        <thead>
                                            <tr>
                                                <th>Student ID</th>
                                                <th>Student Name</th>
                                                <% if (user.role === 'officer' || user.role === 'adviser') { %>
                                                    <th><%= isHalfDay ? 'IN' : 'AM IN' %></th>
                                                    <th><%= isHalfDay ? 'OUT' : 'AM OUT' %></th>
                                                    <% if (!isHalfDay) { %>
                                                        <th>PM IN</th>
                                                        <th>PM OUT</th>
                                                    <% } %>
                                                    <th>Total Fine</th>
                                                    <th>Actions</th>
                                                <% } else { %>
                                                    <th><%= isHalfDay ? 'IN' : 'AM IN' %></th>
                                                    <th><%= isHalfDay ? 'OUT' : 'AM OUT' %></th>
                                                    <% if (!isHalfDay) { %>
                                                        <th>PM IN</th>
                                                        <th>PM OUT</th>
                                                    <% } %>
                                                <% } %>
                                            </tr>
                                        </thead>
                                        <tbody class="year-level-body">
                                            <% studentsInYear.forEach(record => { %>
                                                <tr class="attendance-row" data-student-id="<%= record.studentId %>" data-student-name="<%= record.studentName %>" data-year-level="<%= record.yearLevel %>">
                                                    <td data-label="Student ID"><strong><%= record.studentId %></strong></td>
                                                    <td data-label="Student Name"><%= record.studentName %></td>
                                                    <% if (user.role === 'officer' || user.role === 'adviser') { %>
                                                        <td data-label="<%= isHalfDay ? 'IN' : 'AM IN' %>" style="text-align: center;">
                                                            <div>
                                                                <% if (record.amInStatus === 'Present' && record.amIn) { %>
                                                                    <small><%= formatPhilippinesTime(record.amIn) %></small>
                                                                <% } else if (record.amInStatus === 'Absent' || record.amInStatus === 'Excused') { %>
                                                                    <span class="status-<%= record.amInStatus.toLowerCase() %>"><%= record.amInStatus %></span><br/>
                                                                    <% if (record.amInStatus === 'Absent') { %>
                                                                        <a href="#" onclick="openExcusedModal('<%= record.amInRecordId %>', '<%= record.studentId %>', '<%= record.studentName %>', 'AM IN', '<%= selectedEvent %>'); return false;" style="color: #fbbf24; text-decoration: underline; cursor: pointer; font-weight: 600;">Excuse</a>
                                                                    <% } else if (record.amInStatus === 'Excused') { %>
                                                                        <a href="#" onclick="undoExcused('<%= record.amInRecordId %>', '<%= selectedEvent %>'); return false;" style="color: #6b7280; text-decoration: underline; cursor: pointer; font-weight: 600;">Undo</a>
                                                                    <% } %>
                                                                <% } %>
                                                            </div>
                                                        </td>
                                                        <td data-label="<%= isHalfDay ? 'OUT' : 'AM OUT' %>" style="text-align: center;">
                                                            <div>
                                                                <% if (record.amOutStatus === 'Present' && record.amOut) { %>
                                                                    <small><%= formatPhilippinesTime(record.amOut) %></small>
                                                                <% } else if (record.amOutStatus === 'Absent' || record.amOutStatus === 'Excused') { %>
                                                                    <span class="status-<%= record.amOutStatus.toLowerCase() %>"><%= record.amOutStatus %></span><br/>
                                                                    <% if (record.amOutStatus === 'Absent') { %>
                                                                        <a href="#" onclick="openExcusedModal('<%= record.amOutRecordId %>', '<%= record.studentId %>', '<%= record.studentName %>', 'AM OUT', '<%= selectedEvent %>'); return false;" style="color: #fbbf24; text-decoration: underline; cursor: pointer; font-weight: 600;">Excuse</a>
                                                                    <% } else if (record.amOutStatus === 'Excused') { %>
                                                                        <a href="#" onclick="undoExcused('<%= record.amOutRecordId %>', '<%= selectedEvent %>'); return false;" style="color: #6b7280; text-decoration: underline; cursor: pointer; font-weight: 600;">Undo</a>
                                                                    <% } %>
                                                                <% } %>
                                                            </div>
                                                        </td>
                                                        <% if (!isHalfDay) { %>
                                                            <td data-label="PM IN" style="text-align: center;">
                                                                <div>
                                                                    <% if (record.pmInStatus === 'Present' && record.pmIn) { %>
                                                                        <small><%= formatPhilippinesTime(record.pmIn) %></small>
                                                                    <% } else if (record.pmInStatus === 'Absent' || record.pmInStatus === 'Excused') { %>
                                                                        <span class="status-<%= record.pmInStatus.toLowerCase() %>"><%= record.pmInStatus %></span><br/>
                                                                        <% if (record.pmInStatus === 'Absent') { %>
                                                                            <a href="#" onclick="openExcusedModal('<%= record.pmInRecordId %>', '<%= record.studentId %>', '<%= record.studentName %>', 'PM IN', '<%= selectedEvent %>'); return false;" style="color: #fbbf24; text-decoration: underline; cursor: pointer; font-weight: 600;">Excuse</a>
                                                                        <% } else if (record.pmInStatus === 'Excused') { %>
                                                                            <a href="#" onclick="undoExcused('<%= record.pmInRecordId %>', '<%= selectedEvent %>'); return false;" style="color: #6b7280; text-decoration: underline; cursor: pointer; font-weight: 600;">Undo</a>
                                                                        <% } %>
                                                                    <% } %>
                                                                </div>
                                                            </td>
                                                            <td data-label="PM OUT" style="text-align: center;">
                                                                <div>
                                                                    <% if (record.pmOutStatus === 'Present' && record.pmOut) { %>
                                                                        <small><%= formatPhilippinesTime(record.pmOut) %></small>
                                                                    <% } else if (record.pmOutStatus === 'Absent' || record.pmOutStatus === 'Excused') { %>
                                                                        <span class="status-<%= record.pmOutStatus.toLowerCase() %>"><%= record.pmOutStatus %></span><br/>
                                                                        <% if (record.pmOutStatus === 'Absent') { %>
                                                                            <a href="#" onclick="openExcusedModal('<%= record.pmOutRecordId %>', '<%= record.studentId %>', '<%= record.studentName %>', 'PM OUT', '<%= selectedEvent %>'); return false;" style="color: #fbbf24; text-decoration: underline; cursor: pointer; font-weight: 600;">Excuse</a>
                                                                        <% } else if (record.pmOutStatus === 'Excused') { %>
                                                                            <a href="#" onclick="undoExcused('<%= record.pmOutRecordId %>', '<%= selectedEvent %>'); return false;" style="color: #6b7280; text-decoration: underline; cursor: pointer; font-weight: 600;">Undo</a>
                                                                        <% } %>
                                                                    <% } %>
                                                                </div>
                                                            </td>
                                                        <% } %>
                                                        <td data-label="Total Fine" style="text-align: center;">
                                                            <span class="fine-amount">₱<%= record.amInFine + record.amOutFine + (isHalfDay ? 0 : record.pmInFine + record.pmOutFine) %></span>
                                                        </td>
                                                        <td class="action-cell" data-label="Actions">
                                                            <button type="button" class="btn-delete" onclick="openDeleteModal('<%= record.studentId %>', '<%= record.studentName %>', '<%= selectedEvent %>')">
                                                                🗑️ Remove
                                                            </button>
                                                        </td>
                                                    <% } else { %>
                                                        <td data-label="<%= isHalfDay ? 'IN' : 'AM IN' %>"><%= formatPhilippinesTime(record.amIn) %></td>
                                                        <td data-label="<%= isHalfDay ? 'OUT' : 'AM OUT' %>"><%= formatPhilippinesTime(record.amOut) %></td>
                                                        <% if (!isHalfDay) { %>
                                                            <td data-label="PM IN"><%= formatPhilippinesTime(record.pmIn) %></td>
                                                            <td data-label="PM OUT"><%= formatPhilippinesTime(record.pmOut) %></td>
                                                        <% } %>
                                                    <% } %>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        <% } %>
                    <% }) %>
                <% } else { %>
                    <p style="color: #999; font-style: italic; padding: 20px; text-align: center;">No attendance records found for this event yet.</p>
                <% } %>
            <% } %>
        <% } %>
        </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal for Students -->
    <!-- Now using universal delete-confirmation modal -->

    <!-- Delete Confirmation Modal for Events -->
    <!-- Now using universal delete-confirmation modal -->

<script>
    function deleteEvent(sessionId, folderId, eventName) {
        showDeleteConfirmation({
            title: '⚠️ Delete Event',
            description: `Are you sure you want to delete the event <strong>"${eventName}"</strong>?`,
            warning: 'This will delete the entire event and ALL student attendance records associated with it. This action cannot be undone.',
            buttonText: 'Yes, Delete Event',
            onConfirm: function() {
                window.location.href = `/delete-event/${sessionId}/${folderId}`;
            }
        });
    }

    function toggleEventForm() {
        const form = document.getElementById('eventForm');
        if (form.style.display === 'none') {
            form.style.display = 'block';
        } else {
            form.style.display = 'none';
        }
    }

    // Switch between year level tabs
    function switchYearLevel(yearLevelId) {
        // Hide all sections
        const allSections = document.querySelectorAll('.year-level-section');
        allSections.forEach(section => {
            section.style.display = 'none';
        });
        
        // Show selected section
        const selectedSection = document.getElementById('tab-' + yearLevelId);
        if (selectedSection) {
            selectedSection.style.display = 'block';
        }
        
        // Update active tab styling
        const allTabs = document.querySelectorAll('.year-level-tab');
        allTabs.forEach(tab => {
            tab.style.background = '#252525';
            tab.style.color = '#999';
            tab.style.borderBottom = '3px solid transparent';
            tab.id = '';
        });
        
        // Highlight active tab
        event.target.style.background = '#800000';
        event.target.style.color = '#FFD700';
        event.target.style.borderBottom = '3px solid #FFD700';
        event.target.id = 'active-tab';
    }

    function openDeleteModal(studentId, studentName, eventName) {
        showDeleteConfirmation({
            title: '⚠️ Remove Attendance',
            description: `Are you sure you want to remove the attendance records for <strong>${studentName}</strong> (${studentId}) from the event <strong>"${eventName}"</strong>?`,
            warning: 'This will only remove the attendance records at this event. The student account will remain in the system. This action cannot be undone.',
            buttonText: 'Yes, Remove Attendance',
            onConfirm: function() {
                confirmDelete(studentId, eventName);
            }
        });
    }

    function confirmDelete(studentId, eventName) {
        fetch(`/remove-attendance`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                studentId: studentId,
                eventName: eventName
            })
        })
        .then(response => response.json())
        .then(result => {
            const msgDiv = document.getElementById('message');
            if (result.success) {
                msgDiv.innerHTML = `<div class="success-msg">✅ ${result.message}</div>`;
                setTimeout(() => {
                    location.reload();
                }, 1500);
            } else {
                msgDiv.innerHTML = `<div class="error-msg">❌ ${result.error}</div>`;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            document.getElementById('message').innerHTML = `<div class="error-msg">❌ An error occurred. Please try again.</div>`;
        });
    }

    function filterTable() {
        const input = document.getElementById('searchInput').value.toUpperCase();
        const allRows = document.querySelectorAll('.attendance-row');
        const allSections = document.querySelectorAll('.year-level-section');
        
        // Filter individual rows
        allRows.forEach(row => {
            const studentId = row.getAttribute('data-student-id').toUpperCase();
            const studentName = row.getAttribute('data-student-name').toUpperCase();
            
            if (studentId.includes(input) || studentName.includes(input) || input === '') {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
        
        // Show/hide sections based on whether they have visible rows
        allSections.forEach(section => {
            const visibleRows = section.querySelectorAll('.attendance-row:not([style*="display: none"])');
            if (visibleRows.length > 0) {
                section.style.display = '';
            } else {
                section.style.display = 'none';
            }
        });
    }

    // Excused Modal Functions
    let currentExcusedData = null;

    function openExcusedModal(recordId, studentId, studentName, sessionType, eventName) {
        currentExcusedData = { recordId, studentId, studentName, sessionType, eventName };
        const modal = document.getElementById('excusedModal');
        document.getElementById('excusedStudentInfo').innerHTML = `<strong>${studentName}</strong> (${studentId}) - ${sessionType}`;
        modal.classList.add('show');
    }

    function closeExcusedModal() {
        const modal = document.getElementById('excusedModal');
        modal.classList.remove('show');
        currentExcusedData = null;
    }

    function confirmExcused() {
        if (!currentExcusedData) return;

        const { recordId, studentId, studentName, sessionType, eventName } = currentExcusedData;

        fetch('/api/update-attendance-status', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                attendanceId: recordId,
                studentId: studentId,
                status: 'Excused',
                eventName: eventName,
                sessionType: sessionType
            })
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                const msgDiv = document.getElementById('message');
                msgDiv.innerHTML = `<div class="success-msg">✅ ${studentName} marked as Excused for ${sessionType}. Fine set to ₱0.</div>`;
                setTimeout(() => {
                    location.reload();
                }, 1500);
            } else {
                alert('Error: ' + result.error);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred. Please try again.');
        });

        closeExcusedModal();
    }

    function undoExcused(recordId, eventName) {
        if (!confirm('Are you sure you want to undo the Excused status? The fine will be recalculated.')) {
            return;
        }

        fetch('/api/update-attendance-status', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                attendanceId: recordId,
                status: 'Absent',
                eventName: eventName,
                sessionType: '' // Will be determined from record
            })
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                const msgDiv = document.getElementById('message');
                msgDiv.innerHTML = `<div class="success-msg">✅ Excused status undone. Attendance record updated.</div>`;
                setTimeout(() => {
                    location.reload();
                }, 1500);
            } else {
                alert('Error: ' + result.error);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred. Please try again.');
        });
    }

    // Close modal when clicking outside it
    window.addEventListener('click', (event) => {
        const modal = document.getElementById('excusedModal');
        if (modal && event.target === modal) {
            closeExcusedModal();
        }
    });
</script>

<!-- Excused Confirmation Modal -->
<div id="excusedModal" class="excused-modal">
    <div class="excused-modal-content">
        <div class="excused-modal-header">📋 Excuse Attendance</div>
        <div class="excused-modal-body">
            <p>Mark <span id="excusedStudentInfo"></span> as <strong>Excused</strong>?</p>
            <p style="color: #ffcc00; font-weight: 700;">The fine for this session will be set to ₱0.</p>
            <p style="color: #aaa; font-size: 0.9em;">This action can be undone later if needed.</p>
        </div>
        <div class="excused-modal-buttons">
            <button type="button" class="btn-cancel-excused" onclick="closeExcusedModal()">Cancel</button>
            <button type="button" class="btn-confirm-excused" onclick="confirmExcused()">Yes, Mark Excused</button>
        </div>
    </div>
</div>

<script src="/document-notifications.js"></script>
<script>
    document.documentElement.setAttribute('data-user-role', '<%= user.role %>');
</script>

</body>
</html>