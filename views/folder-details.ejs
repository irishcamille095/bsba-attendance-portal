<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= folder.name %> - Attendance Records</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <script src="/delete-confirmation.js"></script>
    <style>
        /* Folder-details-specific overrides */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body { 
            font-family: 'Inter', 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background-color: #121212;
            display: flex;
        }

        /* Sidebar */
        .sidebar { 
            width: 250px;
            background: #000;
            color: #ffcc00;
            height: 100vh;
            position: fixed;
            padding: 20px;
            border-right: 4px solid #ffcc00;
            overflow-y: auto;
        }

        .sidebar h2 {
            border-bottom: 2px solid #ffcc00;
            padding-bottom: 10px;
            text-align: center;
            margin-bottom: 20px;
        }

        .sidebar p {
            color: #fff;
            margin-bottom: 8px;
        }

        .logout-btn {
            background: #ffcc00;
            color: #000;
            border: none;
            padding: 12px;
            width: 100%;
            margin-top: 30px;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .logout-btn:hover {
            background: #e6b800;
        }

        /* Main Content */
        .content {
            flex: 1;
            margin-left: 290px;
            padding: 30px;
        }

        .container { 
            max-width: 1200px;
            margin: auto;
            background: #1e1e1e;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.3);
            border-left: 5px solid #ffcc00;
            border: 1px solid #2d2d2d;
        }

        .nav-links { 
            margin-bottom: 25px;
            display: flex;
            gap: 20px;
            border-bottom: 2px solid #2d2d2d;
            padding-bottom: 15px;
        }

        .nav-links a { 
            text-decoration: none;
            font-weight: 700;
            font-size: 1em;
            transition: all 0.3s ease;
            color: #ffcc00;
        }

        .nav-links a:hover {
            color: #fff;
        }

        .btn-back { color: #ffcc00; }
        .btn-dash { color: #ffcc00; }

        h1 {
            color: #ffcc00;
            font-size: 2em;
            margin: 20px 0;
        }

        h2 {
            color: #ffcc00;
            font-size: 1.5em;
            margin: 20px 0 15px 0;
            border-bottom: 2px solid #2d2d2d;
            padding-bottom: 10px;
        }

        h3 {
            color: #ffcc00;
            font-size: 1.2em;
            margin: 15px 0;
        }
        
        p {
            color: #e0e0e0;
        }

        .event-row { 
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
        }

        .event-card { 
            flex: 1;
            display: block;
            padding: 16px;
            background: #252525;
            border: 1px solid #2d2d2d;
            border-left: 5px solid #ffcc00;
            text-decoration: none;
            color: #e0e0e0;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .event-card:hover { 
            transform: translateX(5px);
            background: #2a2a2a;
            border-color: #ffcc00;
            box-shadow: 0 4px 12px rgba(255, 204, 0, 0.2);
        }

        .btn-delete-event { 
            background: #fff5f5;
            color: #dc3545;
            padding: 12px 16px;
            border-radius: 8px;
            border: 2px solid #dc3545;
            font-size: 0.95rem;
            cursor: pointer;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .btn-delete-event:hover { 
            background: #dc3545;
            color: white;
            transform: translateY(-2px);
        }

        .btn-download { 
            background: #ffcc00;
            color: #000;
            padding: 12px 20px;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .btn-download:hover {
            background: #e6b800;
            transform: translateY(-2px);
        }

        .search-box { 
            width: 100%;
            padding: 14px;
            margin: 20px 0;
            border: 1px solid #2d2d2d;
            background: #252525;
            color: #e0e0e0;
            border-radius: 8px;
            font-size: 1rem;
            font-family: inherit;
            transition: all 0.3s ease;
        }

        .search-box:focus { 
            outline: none;
            border-color: #ffcc00;
            box-shadow: 0 0 0 3px rgba(255, 204, 0, 0.1);
        }

        table { 
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        .table-wrapper {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border-radius: 8px;
        }

        .table-wrapper table {
            min-width: 600px;
        }

        th { 
            background-color: #000;
            color: #ffcc00;
            padding: 16px;
            text-align: left;
            font-size: 0.95rem;
            font-weight: 700;
            border-bottom: 2px solid #ffcc00;
        }

        td { 
            padding: 14px 16px;
            border-bottom: 1px solid #2d2d2d;
            color: #e0e0e0;
        }

        tr:nth-child(even) { 
            background-color: #252525;
        }

        tr:hover {
            background-color: #2a2a2a;
        }

        .action-cell { 
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: center;
        }

        .btn-delete { 
            background: #dc3545;
            color: white;
            padding: 8px 12px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .btn-delete:hover { 
            background: #c82333;
            transform: translateY(-2px);
        }

        .role-select { 
            padding: 8px 12px;
            border: 1px solid #2d2d2d;
            background: #252525;
            color: #ffcc00;
            border-radius: 6px;
            font-size: 0.9rem;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .role-select:focus {
            outline: none;
            border-color: #ffcc00;
            box-shadow: 0 0 0 3px rgba(255, 204, 0, 0.1);
        }
        
        .role-select option {
            background: #1e1e1e;
            color: #e0e0e0;
        }

        .modal { 
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            align-items: center;
            justify-content: center;
        }

        .modal.show { 
            display: flex;
        }

        .modal-content { 
            background-color: #1e1e1e;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
            max-width: 450px;
            width: 90%;
            border: 1px solid #2d2d2d;
            border-left: 5px solid #ffcc00;
        }

        .modal-header { 
            font-size: 1.3rem;
            font-weight: 700;
            color: #ffcc00;
            margin-bottom: 15px;
        }

        .modal-body { 
            margin: 15px 0;
            color: #e0e0e0;
        }

        .modal-buttons { 
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            margin-top: 20px;
        }

        .btn-confirm { 
            background: #ffcc00;
            color: #000;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .btn-confirm:hover { 
            background: #e6b800;
            transform: translateY(-2px);
        }

        .btn-cancel { 
            background: #555;
            color: #e0e0e0;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .btn-cancel:hover { 
            background: #666;
            transform: translateY(-2px);
        }

        .hidden { 
            display: none;
        }

        .success-msg { 
            color: #4ade80;
            font-weight: 700;
            padding: 15px;
            background: #0f3f1f;
            border-radius: 8px;
            margin: 15px 0;
            border: 2px solid #22c55e;
        }

        .error-msg { 
            color: #ff6b6b;
            font-weight: 700;
            padding: 15px;
            background: #3f0f0f;
            border-radius: 8px;
            margin: 15px 0;
            border: 2px solid #dc3545;
        }

        .create-event-section {
            background: #252525;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 8px;
            border-left: 5px solid #ffcc00;
            border: 1px solid #2d2d2d;
        }

        .create-event-section h3 {
            color: #ffcc00;
            margin-top: 0;
        }

        .create-event-section input {
            padding: 12px;
            border-radius: 6px;
            border: 1px solid #2d2d2d;
            background: #1e1e1e;
            color: #e0e0e0;
            font-family: inherit;
            transition: all 0.3s ease;
        }

        .create-event-section input:focus {
            outline: none;
            border-color: #ffcc00;
            box-shadow: 0 0 0 3px rgba(255, 204, 0, 0.1);
        }

        .create-event-section button {
            background: #ffcc00;
            color: #000;
            padding: 12px 20px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 700;
            border: none;
            transition: all 0.3s ease;
        }

        .create-event-section button:hover {
            background: #e6b800;
            color: #000;
        }
        
        .create-event-section p {
            color: #999;
        }
        
        .create-event-section code {
            background: #1e1e1e;
            color: #ffcc00;
            padding: 2px 6px;
            border-radius: 4px;
            border: 1px solid #2d2d2d;
        }

        @media (max-width: 768px) {
            body { 
                display: block; 
            }

            .sidebar {
                position: fixed;
                left: 0;
                top: 50px;
                width: 100%;
                height: auto;
                max-height: calc(100vh - 50px);
                transform: translateX(-100%);
                transition: transform 0.3s ease;
                z-index: 2000;
                padding: 15px;
                border-right: none;
                border-bottom: 2px solid #ffcc00;
                overflow-y: auto;
            }

            .sidebar.active {
                transform: translateX(0);
            }

            .content {
                margin-left: 0 !important;
                width: 100%;
                padding: 15px;
                margin-top: 0;
            }

            .container {
                padding: 15px;
                margin-top: 0;
            }

            .nav-links {
                flex-wrap: wrap;
                gap: 8px;
                margin-bottom: 15px;
            }

            .nav-links a {
                padding: 8px 12px;
                font-size: 0.9em;
            }

            h1 {
                font-size: 1.3em;
                margin: 15px 0;
            }

            h2 {
                font-size: 1.2em;
                margin: 15px 0 10px 0;
            }

            h3 {
                font-size: 1.1em;
            }

            .event-row {
                flex-direction: row;
                gap: 10px;
                margin-bottom: 10px;
                flex-wrap: nowrap;
            }

            .event-card {
                padding: 12px;
                font-size: 0.95em;
                flex: 3;
            }

            .btn-delete-event {
                flex: 1;
                white-space: nowrap;
            }

            /* Responsive Table */
            table {
                font-size: 0.85em;
                display: block;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                white-space: nowrap;
            }

            thead {
                display: none;
            }

            tbody {
                display: block;
            }

            tr {
                display: block;
                margin-bottom: 12px;
                border: 1px solid #e0e0e0;
                background: white;
                border-radius: 6px;
                padding: 12px;
                page-break-inside: avoid;
                break-inside: avoid;
            }

            td {
                display: block;
                text-align: right;
                padding: 8px 0;
                border-bottom: 1px solid #f0f0f0;
                position: relative;
                padding-left: 50%;
                min-width: 60px;
            }

            td:last-child {
                min-width: 100px;
            }

            td:before {
                content: attr(data-label);
                position: absolute;
                left: 0;
                font-weight: bold;
                color: #ffcc00;
                width: 48%;
                text-align: left;
            }

            td:last-child {
                border-bottom: none;
            }

            tr:nth-child(even) {
                background-color: white;
            }

            tr:hover {
                background-color: white;
            }

            .action-cell {
                display: flex;
                gap: 6px;
                flex-wrap: wrap;
                justify-content: flex-end;
            }

            .btn-delete {
                padding: 8px 10px;
                font-size: 0.85em;
            }

            .search-box {
                padding: 12px;
                font-size: 16px;
            }

            .create-event-section {
                padding: 15px;
                margin-bottom: 15px;
            }

            .create-event-section form {
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .create-event-section input {
                padding: 11px;
                font-size: 16px;
            }

            .create-event-section button {
                padding: 11px;
                width: 100%;
            }

            .modal-content {
                width: 90%;
                padding: 20px;
            }

            .btn-download {
                padding: 10px 15px;
                font-size: 0.9em;
                width: 100%;
                text-align: center;
            }

            .role-select {
                padding: 8px;
            }
        }

        @media (max-width: 480px) {
            .content {
                padding: 8px;
                margin-top: 0;
            }

            .container {
                padding: 12px;
                margin-top: 0;
            }

            h1 {
                font-size: 1.2em;
                margin: 10px 0;
            }

            h2 {
                font-size: 1.1em;
                margin: 10px 0 8px 0;
            }

            .nav-links {
                margin-bottom: 10px;
                padding-bottom: 10px;
            }

            .nav-links a {
                font-size: 0.85em;
                padding: 6px 10px;
            }

            table {
                font-size: 0.8em;
                display: block;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

            td {
                padding: 6px 0;
                padding-left: 40%;
                min-width: 50px;
            }

            td:last-child {
                min-width: 90px;
            }

            td:before {
                width: 38%;
            }

            .event-card {
                padding: 10px;
                font-size: 0.9em;
            }

            .btn-delete-event {
                padding: 8px 6px;
                font-size: 0.8em;
            }

            .btn-delete {
                padding: 6px 8px;
                font-size: 0.8em;
            }

            .btn-download {
                padding: 9px 12px;
                font-size: 0.85em;
            }

            .create-event-section {
                padding: 12px;
            }

            .create-event-section input {
                padding: 10px;
            }

            .action-cell {
                gap: 4px;
            }
        }

        header {
            display: none;
        }

        header.mobile-header {
            display: flex !important;
            position: sticky;
            top: 0;
            left: 0;
            right: 0;
            background: #ffcc00;
            color: #000;
            padding: 10px 12px;
            align-items: center;
            z-index: 1001;
        }

        @media (max-width: 768px) {
            header.mobile-header {
                display: flex !important;
            }
            
            /* Ensure table Actions column doesn't disappear */
            th, td {
                min-width: 60px;
            }
            
            th:last-child, td:last-child {
                min-width: 100px;
            }
        }
    </style>
    </style>
</head>
<body>

    <div class="sidebar">
        <h2 style="color: #ffcc00;">BSBA-MM</h2>
        <p style="color: #fff;">User: <strong><%= user.name %></strong></p>
        <p style="color: #fff;">Role: <strong><%= user.role %></strong></p>
        
        <% if (user.role === 'adviser' || user.role === 'officer') { %>
        <div style="padding: 10px 20px;">
            <a href="/request-reset" style="text-decoration: none; color: white; display: flex; align-items: center; gap: 10px;">
                <i class="fas fa-lock"></i> <span style="font-weight: bold;">Reset Officer Password</span>
            </a>
        </div>
        <% } %>
        
        <hr style="border: 1px solid #ffcc00;">
        
        <form action="/logout" method="POST" style="margin-top: 30px; display: block !important;">
            <button type="submit" class="logout-btn" style="width: 100%; padding: 12px; background: #ffcc00; color: #000; border: none; border-radius: 5px; font-weight: bold; cursor: pointer; display: block;">
                🚪 Logout
            </button>
        </form>
    </div>

    <div class="content">
        <div class="container">
            <div class="nav-links">
                <a href="javascript:history.back()" class="btn-back">← Back</a>
                <a href="/dashboard" class="btn-dash">🏠 Back to Dashboard</a>
            </div>

            <h1>📁 <%= folder.name %></h1>

            <% if (user.role === 'officer' || user.role === 'adviser') { %>
                <div class="create-event-section">
                    <h3 style="margin-top: 0;">➕ Create New Event</h3>
                    <p style="color: #999; font-size: 0.9em;">📁 Folder ID: <code><%= folder._id %></code></p>
                    <form action="/create-event/<%= folder._id %>" method="POST" style="display: flex; gap: 10px;">
                        <input type="text" name="eventName" placeholder="Event Name (e.g., Christmas Party, Monthly Meeting)" required style="flex: 1; padding: 10px; border-radius: 5px;">
                        <button type="submit" style="padding: 10px 20px; border-radius: 5px; cursor: pointer; font-weight: bold;">✓ Create</button>
                    </form>
                </div>
        <% } %>

        <% if (!selectedEvent) { %>
            <h3>📅 Events in this Folder:</h3>
            <p style="color: #999; font-size: 0.9em;">Click an event to view attendance records.</p>
            <div style="margin-top: 20px;">
                <% if (sessions && sessions.length > 0) { %>
                    <% sessions.forEach(session => { %>
                        <div class="event-row">
                            <a href="/folder-details/<%= folder._id %>?event=<%= encodeURIComponent(session.eventName) %>" class="event-card">
                                📅 <%= session.eventName %>
                            </a>

                            <% if (user.role === 'officer' || user.role === 'adviser') { %>
                                <button type="button" class="btn-delete-event" onclick="deleteEvent('<%= session._id %>', '<%= folder._id %>', '<%= session.eventName %>')">
                                   🗑️ Delete
                                </button>
                            <% } %>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p style="color: #999; font-style: italic;">No events found in this folder yet.</p>
                <% } %>
            </div>

        <% } else { %>
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #ffcc00; margin-bottom: 15px; padding-bottom: 10px; flex-wrap: wrap; gap: 10px;">
                <h2 style="margin: 0; flex: 1; border: none; padding: 0;">Event: <%= selectedEvent %></h2>

                <% if (user.role === 'officer' || user.role === 'adviser') { %>
                    <a href="/download-attendance/<%= folder._id %>?event=<%= encodeURIComponent(selectedEvent) %>" class="btn-download">
                        📥 Download CSV
                    </a>
                <% } %>
            </div>

            <!-- Search Bar (officers/advisers only) -->
            <% if (user.role === 'officer' || user.role === 'adviser') { %>
                <div style="margin: 15px 0;">
                    <input type="text" id="searchInput" class="search-box" placeholder="🔍 Search by Student Name or ID (MM-XXX)..." onkeyup="filterTable()">
                </div>
            <% } %>

            <div id="message"></div>
            
            <% if (user.role === 'student') { %>
                <% const myRecord = (attendanceData || []).find(r => r.studentId === user.studentId); %>
                <% if (myRecord) { %>
                    <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Student ID</th>
                                <th>Student Name</th>
                                <th>AM IN</th>
                                <th>AM OUT</th>
                                <th>PM IN</th>
                                <th>PM OUT</th>
                            </tr>
                        </thead>
                        <tbody id="attendanceTable">
                            <tr class="attendance-row" data-student-id="<%= myRecord.studentId %>" data-student-name="<%= myRecord.studentName %>">
                                <td data-label="Student ID"><strong><%= myRecord.studentId %></strong></td>
                                <td data-label="Student Name"><%= myRecord.studentName %></td>
                                <td data-label="AM IN"><%= myRecord.amIn ? new Date(myRecord.amIn).toLocaleTimeString() : '---' %></td>
                                <td data-label="AM OUT"><%= myRecord.amOut ? new Date(myRecord.amOut).toLocaleTimeString() : '---' %></td>
                                <td data-label="PM IN"><%= myRecord.pmIn ? new Date(myRecord.pmIn).toLocaleTimeString() : '---' %></td>
                                <td data-label="PM OUT"><%= myRecord.pmOut ? new Date(myRecord.pmOut).toLocaleTimeString() : '---' %></td>
                            </tr>
                        </tbody>
                    </table>
                    </div>
                <% } else { %>
                    <p style="color: #999; font-style: italic; padding: 20px; text-align: center;">You have not recorded your attendance for this event yet.</p>
                <% } %>
            <% } else { %>
                <% if (attendanceData && attendanceData.length > 0) { %>
                    <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Student ID</th>
                                <th>Student Name</th>
                                <th>AM IN</th>
                                <th>AM OUT</th>
                                <th>PM IN</th>
                                <th>PM OUT</th>
                                <% if (user.role === 'officer' || user.role === 'adviser') { %>
                                    <th>Actions</th>
                                <% } %>
                            </tr>
                        </thead>
                        <tbody id="attendanceTable">
                            <% attendanceData.forEach(record => { %>
                                <tr class="attendance-row" data-student-id="<%= record.studentId %>" data-student-name="<%= record.studentName %>">
                                    <td data-label="Student ID"><strong><%= record.studentId %></strong></td>
                                    <td data-label="Student Name"><%= record.studentName %></td>
                                    <td data-label="AM IN"><%= record.amIn ? new Date(record.amIn).toLocaleTimeString() : '---' %></td>
                                    <td data-label="AM OUT"><%= record.amOut ? new Date(record.amOut).toLocaleTimeString() : '---' %></td>
                                    <td data-label="PM IN"><%= record.pmIn ? new Date(record.pmIn).toLocaleTimeString() : '---' %></td>
                                    <td data-label="PM OUT"><%= record.pmOut ? new Date(record.pmOut).toLocaleTimeString() : '---' %></td>
                                    <% if (user.role === 'officer' || user.role === 'adviser') { %>
                                        <td class="action-cell" data-label="Actions">
                                            <button type="button" class="btn-delete" onclick="openDeleteModal('<%= record.studentId %>', '<%= record.studentName %>')">
                                                🗑️ Remove
                                            </button>
                                        </td>
                                    <% } %>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                    </div>
                <% } else { %>
                    <p style="color: #999; font-style: italic; padding: 20px; text-align: center;">No attendance records found for this event yet.</p>
                <% } %>
            <% } %>
        <% } %>
        </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal for Students -->
    <!-- Now using universal delete-confirmation modal -->

    <!-- Delete Confirmation Modal for Events -->
    <!-- Now using universal delete-confirmation modal -->

<script>
    function deleteEvent(sessionId, folderId, eventName) {
        showDeleteConfirmation({
            title: '⚠️ Delete Event',
            description: `Are you sure you want to delete the event <strong>"${eventName}"</strong>?`,
            warning: 'This will delete the entire event and ALL student attendance records associated with it. This action cannot be undone.',
            buttonText: 'Yes, Delete Event',
            onConfirm: function() {
                window.location.href = `/delete-event/${sessionId}/${folderId}`;
            }
        });
    }

    function openDeleteModal(studentId, studentName) {
        showDeleteConfirmation({
            title: '⚠️ Delete Student',
            description: `Are you sure you want to remove <strong>${studentName}</strong> (${studentId})?`,
            warning: 'This will delete the student from the database and clear all their attendance records. This action cannot be undone.',
            buttonText: 'Yes, Delete Student',
            onConfirm: function() {
                confirmDelete(studentId);
            }
        });
    }

    function confirmDelete(studentId) {
        fetch(`/delete-student/${studentId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(result => {
            const msgDiv = document.getElementById('message');
            if (result.success) {
                msgDiv.innerHTML = `<div class="success-msg">✅ ${result.message}</div>`;
                setTimeout(() => {
                    location.reload();
                }, 1500);
            } else {
                msgDiv.innerHTML = `<div class="error-msg">❌ ${result.error}</div>`;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            document.getElementById('message').innerHTML = `<div class="error-msg">❌ An error occurred. Please try again.</div>`;
        });
    }

    function filterTable() {
        const input = document.getElementById('searchInput').value.toUpperCase();
        const table = document.getElementById('attendanceTable');
        const rows = table.getElementsByClassName('attendance-row');

        for (let i = 0; i < rows.length; i++) {
            const studentId = rows[i].getAttribute('data-student-id').toUpperCase();
            const studentName = rows[i].getAttribute('data-student-name').toUpperCase();
            
            if (studentId.includes(input) || studentName.includes(input)) {
                rows[i].style.display = '';
            } else {
                rows[i].style.display = 'none';
            }
        }
    }
</script>

</body>
</html>