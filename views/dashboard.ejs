<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BSBA-MM Portal</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        /* THEME: YELLOW & BLACK */
        * { box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; margin: 0; background: #f4f4f4; display: flex; }
        
        /* Sidebar */
        .sidebar { width: 250px; background: #000; color: #ffcc00; height: 100vh; position: fixed; padding: 20px; border-right: 4px solid #ffcc00; overflow-y: auto; }
        .sidebar h2 { border-bottom: 2px solid #ffcc00; padding-bottom: 10px; text-align: center; }
        .sidebar a { color: white; padding: 12px; display: block; text-decoration: none; transition: all 0.2s; }
        .sidebar a:hover { color: #ffcc00; background: rgba(255, 204, 0, 0.1); }
        
        /* Main Content */
        .content { flex: 1; margin-left: 290px; padding: 20px; }
        header { border-bottom: 3px solid #000; margin-bottom: 20px; padding: 10px 15px; }

        /* Button Grid (The Menu) */
        .menu-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px; }
        .menu-card { 
            background: #000; color: #ffcc00; border: 2px solid #ffcc00; padding: 30px 15px; 
            border-radius: 12px; cursor: pointer; text-align: center; font-weight: bold; font-size: 1em;
            transition: all 0.3s ease; min-height: 120px; display: flex; align-items: center; justify-content: center; flex-direction: column;
        }
        .menu-card:hover { background: #ffcc00; color: #000; transform: translateY(-3px); box-shadow: 0 8px 15px rgba(0,0,0,0.2); }
        .menu-card:active { transform: translateY(-1px); }

        /* Sections (Hidden by Default) */
        .portal-section { display: none; background: white; padding: 20px; border-radius: 12px; border: 2px solid #000; box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
        .back-btn { background: #000; color: #ffcc00; border: 2px solid #ffcc00; padding: 12px 20px; cursor: pointer; margin-bottom: 15px; display: inline-block; font-weight: bold; border-radius: 8px; font-size: 1em; transition: all 0.3s; max-width: 200px; }
        .back-btn:hover { background: #ffcc00; color: #000; }
        .back-btn:active { transform: scale(0.98); }

        /* Forms */
        input, textarea, select { width: 100%; padding: 12px; margin: 8px 0; border: 1px solid #ccc; border-radius: 5px; font-family: inherit; font-size: 1em; }
        input:focus, textarea:focus, select:focus { outline: none; border: 2px solid #ffcc00; }
        button { padding: 12px 20px; font-size: 1em; cursor: pointer; border-radius: 5px; transition: all 0.3s; }
        
        /* Images */
        img { max-width: 100%; height: auto; display: block; }
        
        /* Card styling */
        .card { margin: 10px 0; padding: 15px; background: #f9f9f9; border-radius: 8px; }

        /* Folder cards */
        .folder-card { transition: all 0.3s; }
        .folder-card:hover { transform: translateY(-3px); box-shadow: 0 5px 15px rgba(0,0,0,0.1); }

        /* Mobile-first responsive design */
        @media (max-width: 768px) {
            body { display: block; }
            
            .sidebar {
                width: 100%;
                height: auto;
                position: fixed;
                left: 0;
                top: 50px;
                max-height: calc(100vh - 50px);
                transform: translateX(-100%);
                transition: transform 0.3s ease;
                z-index: 2000;
                padding: 15px;
                border-right: none;
                border-bottom: 2px solid #ffcc00;
            }

            .sidebar.active {
                transform: translateX(0);
                overflow-y: auto;
            }

            .content {
                margin-left: 0;
                padding: 10px;
                margin-top: 50px;
            }

            header {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                margin: 0;
                z-index: 1000;
                padding: 10px 12px;
                background: #ffcc00;
            }

            header button {
                display: block !important;
                background: rgba(0,0,0,0.2);
                border: 1px solid rgba(0,0,0,0.3);
                color: #000;
                padding: 8px 12px;
                font-size: 1.3em;
                border-radius: 4px;
                cursor: pointer;
                margin-right: 10px;
            }

            header h1 {
                font-size: 1em;
                margin: 0;
            }

            .menu-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 10px;
            }

            .menu-card {
                padding: 20px 10px;
                font-size: 0.9em;
                min-height: 100px;
            }

            .portal-section {
                padding: 15px;
                border-radius: 8px;
            }

            .back-btn {
                display: inline-block;
                max-width: 200px;
                padding: 10px 15px;
                font-size: 0.95em;
                width: auto;
            }

            input, textarea, select {
                padding: 11px;
                margin: 8px 0;
                font-size: 16px; /* Prevents auto-zoom on iOS */
            }

            button {
                padding: 12px 16px;
                font-size: 1em;
                width: auto;
            }
        }

        @media (max-width: 480px) {
            .menu-grid {
                grid-template-columns: 1fr;
                gap: 8px;
            }

            .menu-card {
                padding: 18px 10px;
                font-size: 0.85em;
                min-height: 90px;
            }

            .content {
                padding: 8px;
            }

            .portal-section {
                padding: 12px;
            }

            header h1 {
                font-size: 0.9em;
            }

            input, textarea, select {
                padding: 10px;
            }

            button {
                padding: 11px 14px;
                font-size: 0.95em;
            }

            .folder-card {
                padding: 12px;
            }
        }

        /* On Desktop: Show sidebar normally */
        @media (min-width: 769px) {
            .sidebar {
                transform: translateX(0) !important;
                position: fixed !important;
            }
            header button {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <div class="sidebar" id="sidebar">
    <h2 style="color: #ffcc00;">BSBA-MM</h2>
    <p style="color: #fff;">User: <strong><%= user.name %></strong></p>
    <p style="color: #fff;">Role: <strong><%= user.role %></strong></p>
    <div style="padding: 10px 20px;">
    <a href="/my-account" style="text-decoration: none; color: white; display: flex; align-items: center; gap: 10px;">
        👤 <span style="font-weight: bold;">My Account</span>
    </a>
</div>
    <hr style="border: 1px solid #ffcc00;">
    
    <form action="/logout" method="POST" style="margin-top: 30px; display: block !important;">
        <button type="submit" class="back-btn" style="width: 100%; padding: 12px; background: #ffcc00; color: #000; border: none; border-radius: 5px; font-weight: bold; cursor: pointer; display: block;">
            🚪 Logout
        </button>
    </form>
</div>

    <div class="content">
      <header style="background: #ffcc00; color: white; padding: 10px 15px; display: flex; align-items: center; position: sticky; top: 0; z-index: 1000;">
    <button onclick="toggleSidebar()" style="background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.4); color: white; padding: 8px 12px; border-radius: 4px; cursor: pointer; margin-right: 15px; font-size: 1.2rem;">
        ☰
    </button>
    <h1 style="margin: 0; font-size: 1.1rem;">Marketing Management Portal</h1>
</header>

        <button id="backBtn" class="back-btn" onclick="showMenu()" style="display: none;">⬅️ Back to Menu</button>

        <div id="mainMenu" class="menu-grid">
            <div class="menu-card" onclick="openSection('announcements')">📢<br>Announcements</div>
            <div class="menu-card" onclick="openSection('attendance')">📸<br>Attendance</div>
            <% if (user.role === 'officer' || user.role === 'adviser') { %>
                <a href="/admin/students" class="menu-card" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">👥<br>Master Student List</a>
            <% } %>
        </div>

        <div id="announcements" class="portal-section">
    <h2>📢 Announcements</h2>

    <% if (user.role === 'officer' || user.role === 'adviser') { %>
        <div style="background: #eee; padding: 15px; border-radius: 10px; margin-bottom: 20px;">
            <h3>Post New Update</h3>
            <form action="/post-announcement" method="POST" enctype="multipart/form-data">
                <input type="text" name="title" placeholder="Announcement Title" required>
                <textarea name="message" placeholder="Write your message here..." required></textarea>
                <input type="file" name="image" accept="image/*">
                <button type="submit" class="post-btn">Post to Portal</button>
            </form>
        </div>
    <% } %>

    <div id="announcementList">
    <% announcements.forEach(post => { %>
        <div class="card" style="border-left: 8px solid #ffcc00; margin-bottom: 15px; position: relative;">
            
            <% if (user.role === 'officer' || user.role === 'adviser') { %>
                <form action="/delete-announcement" method="POST" 
                      onsubmit="return confirm('Delete this announcement?');" 
                      style="position: absolute; top: 10px; right: 10px;">
                    <input type="hidden" name="announcementId" value="<%= post._id %>">
                    <button type="submit" style="background:none; border:none; cursor:pointer; font-size: 1.2em;">🗑️</button>
                </form>
            <% } %>

            <h3><%= post.title %></h3>
            <p><%= post.message %></p>
            
            <% if (post.imageUrl) { %>
                <img src="<%= post.imageUrl %>" style="max-width: 100%; border-radius: 10px; margin-top: 10px;">
            <% } %>

            <p style="font-size: 0.8em; color: #666; margin-top: 10px;">
                Posted by: <strong><%= post.author %></strong> on <%= post.date.toDateString() %>
            </p>
        </div>
    <% }) %> 
    </div>

        
    </div>

<div id="attendance" class="portal-section" style="display: none;">
        <h2>📸 Attendance System</h2>
       <% if (user.role === 'officer' || user.role === 'adviser') { %>
    <form id="scanForm" style="background: white; padding: 20px; border-radius: 8px; border-left: 5px solid #ffcc00; margin-bottom: 20px;">
        <h3 style="color: #1a1a1a; margin-top: 0;">📱 Start Scanning Students</h3>
        
        <div style="display: flex; flex-direction: column; gap: 15px;">
            <div>
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Semester/Folder:</label>
                <select id="folderSelect" required style="width: 100%; padding: 10px; border-radius: 5px; border: 1px solid #ccc;">
                    <option value="" disabled selected>-- Select a Folder --</option>
                    <% folders.forEach(folder => { %>
                        <option value="<%= folder._id %>"><%= folder.name %></option>
                    <% }); %>
                </select>
            </div>

            <div>
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Event:</label>
                <select id="eventSelect" name="eventName" required style="width: 100%; padding: 10px; border-radius: 5px; border: 1px solid #ccc;" disabled>
                    <option value="" disabled selected>-- Select Folder First --</option>
                </select>
            </div>

            <div>
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Session Type:</label>
                <select name="sessionType" required style="width: 100%; padding: 10px; border-radius: 5px; border: 1px solid #ccc;">
                    <option value="AM_IN">Morning Check-In (AM IN)</option>
                    <option value="AM_OUT">Morning Check-Out (AM OUT)</option>
                    <option value="PM_IN">Afternoon Check-In (PM IN)</option>
                    <option value="PM_OUT">Afternoon Check-Out (PM OUT)</option>
                </select>
            </div>

            <input type="hidden" id="folderIdInput" name="folderId">

            <button type="submit" class="menu-card" style="background: #000; color: #ffcc00; padding: 15px; cursor: pointer; border: 2px solid #ffcc00; font-weight: bold; width: 100%; border-radius: 8px; transition: all 0.3s ease;">
                🔍 OPEN SCANNER
            </button>
        </div>
    </form>
                <hr style="border: 1px solid #ffcc00; margin: 20px 0;">
                <a href="/view-active-qr" style="color: #ffcc00; text-decoration: none; font-weight: bold;">🔄 Re-open Active Scanner</a>
    
    <div class="filing-container" style="background: #f4f4f4; padding: 20px; border-radius: 10px; border-left: 5px solid #ffcc00;">
            <h3 style="color: #1a1a1a;">📂 Master Attendance Filing</h3>
            
            <form action="/create-folder" method="POST" style="display: flex; gap: 10px; margin-bottom: 20px;">
                <input type="text" name="folderName" placeholder="New Semester/Folder Name" required style="flex: 1; padding: 10px; border-radius: 5px; border: 2px solid #000;">
                <button type="submit" style="background: #ffcc00; color: #000; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; font-weight: bold;">+ Create</button>
            </form>

            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 15px;">
                <% folders.forEach(folder => { %>
                    <div class="folder-card" style="background: white; border-left: 5px solid #ffcc00; border: 1px solid #ddd; padding: 15px; border-radius: 8px; text-align: center; position: relative;">
                        <span style="font-size: 2.5rem; display: block;">📁</span>
                        <strong style="font-size: 0.9rem;"><%= folder.name %></strong>
                        
                        <div style="margin-top: 10px; display: flex; justify-content: space-between; font-size: 0.8rem;">
                            <a href="/folder-details/<%= folder._id %>" style="color: blue; text-decoration: none;">View</a>
                            <a href="/delete-folder/<%= folder._id %>" style="color: red; text-decoration: none;" onclick="return confirm('Delete this folder?')">Delete</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <% } else { %>
            <div style="text-align: center; padding: 20px; background: #f0f0f0; border-radius: 8px; border-left: 5px solid #ffcc00; margin-bottom: 30px;">
                <h3 style="color: #1a1a1a; margin-top: 0;">📋 How to Mark Attendance</h3>
                <p style="font-size: 1.1em;">Simply show your <strong>MM-ID Card</strong> to the officer when they scan attendance.</p>
                <p style="color: #666; font-size: 0.9em;">Your MM-ID is: <strong style="color: #ffcc00;"><%= user.mmId %></strong></p>
                <p
            
            <div style="text-align: center; padding: 20px; background: white; border-radius: 8px; border-left: 5px solid #ffcc00; margin-bottom: 30px;">
                <h3 style="color: #1a1a1a; margin-top: 0;">📱 Your Attendance QR Code</h3>
                <p style="color: #666; margin-bottom: 15px;">Show this QR code to the officer for scanning:</p>
                <div id="qrCodeContainer" style="display: flex; justify-content: center; padding: 15px; background: #fff;"></div>
            </div> style="color: #666;">An officer will scan your QR code to record your attendance.</p>
            </div>

   <div class="filing-container" style="background: #f4f4f4; padding: 20px; border-radius: 10px; border-left: 5px solid #ffcc00;">
            <h3 style="color: #1a1a1a;">📊 My Attendance Section</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 15px;">
                <% folders.forEach(folder => { %>
                    <div class="folder-card" style="background: white; border-left: 5px solid #ffcc00; border: 1px solid #ddd; padding: 15px; border-radius: 8px; text-align: center;">
                        <span style="font-size: 2.5rem; display: block;">📁</span>
                        <strong style="font-size: 0.9rem;"><%= folder.name %></strong>
                        <a href="/my-attendance/<%= folder._id %>" style="display: block; margin-top: 10px; color: blue; text-decoration: none; font-size: 0.8rem;">View Records</a>
                    </div>
                <% }) %>
            </div>
        </div>
    <% } %>

</div>


</div>

<div id="attendance-records" class="portal-section" style="display: none;">
    <h2 style="color: #ffcc00;">📊 Master Attendance List</h2>
    <table style="width: 100%; border-collapse: collapse; color: white;">
        <thead>
            <tr style="border-bottom: 2px solid #ffcc00;">
                <th>Student Name</th>
                <th>Event</th>
                <th>Time</th>
                <th>Session ID</th>
            </tr>
        </thead>
        <tbody>
            <% allAttendance.forEach(record => { %>
                <tr style="border-bottom: 1px solid #333;">
                    <td><%= record.studentName %></td>
                    <td><%= record.eventName %></td>
                    <td><%= new Date(record.timestamp).toLocaleString() %></td>
                    <td style="font-size: 0.8em; color: #888;"><%= record.sessionId %></td>
                </tr>
            <% }) %>
    </table>
</div>

<% if (user.role === 'officer' || user.role === 'adviser') { %>
<div id="qr-codes" class="portal-section" style="display: none;">
    <h2>🎫 Student IDs & QR Codes</h2>
    <p style="color: #333; margin-bottom: 20px;">Manage, view, and print student QR codes with MM-IDs.</p>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 30px;">
        <a href="/student-ids" style="background: #000; color: #ffcc00; border: 2px solid #ffcc00; padding: 20px; border-radius: 8px; cursor: pointer; font-weight: bold; text-decoration: none; text-align: center; transition: all 0.3s ease;">
            <div style="font-size: 2em; margin-bottom: 10px;">📋</div>
            View Student List
        </a>
        
        <a href="/print-student-cards" style="background: #000; color: #ffcc00; border: 2px solid #ffcc00; padding: 20px; border-radius: 8px; cursor: pointer; font-weight: bold; text-decoration: none; text-align: center; transition: all 0.3s ease;">
            <div style="font-size: 2em; margin-bottom: 10px;">🖨️</div>
            Print Mini ID Cards
        </a>
    </div>

    <button onclick="loadQRCodes()" style="background: #000; color: #ffcc00; border: 2px solid #ffcc00; padding: 12px 25px; border-radius: 8px; cursor: pointer; font-weight: bold; margin-bottom: 20px;">
        🔄 Refresh List
    </button>

    <div id="studentQRList" style="background: white; padding: 20px; border-radius: 8px;">
        <p style="color: #666;">Loading student data...</p>
    </div>
</div>
<% } %>

<div id="my-attendance" class="portal-section" style="display: none;">
    <h2 style="color: #ffcc00;">📅 My Attendance History</h2>
    <div class="attendance-cards">
        <% myAttendance.forEach(record => { %>
            <div style="background: #222; border-left: 5px solid #ffcc00; padding: 10px; margin-bottom: 10px;">
                <h4 style="margin: 0;"><%= record.eventName %></h4>
                <p style="margin: 5px 0; font-size: 0.9em; color: #ccc;">
                    Checked in at: <%= new Date(record.timestamp).toLocaleString() %>
                </p>
                <small style="color: #666;">Ref: <%= record.sessionId %></small>
            </div>
        <% }) %>
    </div>
</div>

<div id="attendance-records" class="portal-section" style="display: none;">
    <h2 style="color: #ffcc00;">📊 Master Attendance List</h2>
    <table style="width: 100%; border-collapse: collapse; color: white; background: #111;">
        <thead>
            <tr style="border-bottom: 2px solid #ffcc00; text-align: left;">
                <th>Student Name</th>
                <th>Event</th>
                <th>Time</th>
            </tr>
        </thead>
        <tbody>
            <% allAttendance.forEach(record => { %>
                <tr style="border-bottom: 1px solid #333;">
                    <td><%= record.studentName %></td>
                    <td><%= record.eventName %></td>
                    <td><%= new Date(record.timestamp).toLocaleString() %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<div id="my-attendance" class="portal-section" style="display: none;">
    <h2 style="color: #ffcc00;">📅 My Attendance History</h2>
    <% myAttendance.forEach(record => { %>
        <div style="background: #222; border-left: 5px solid #ffcc00; padding: 15px; margin-bottom: 10px;">
            <h4 style="margin: 0; color: #ffcc00;"><%= record.eventName %></h4>
            <p style="margin: 5px 0; color: #fff;">Status: Present</p>
            <small style="color: #888;"><%= new Date(record.timestamp).toLocaleString() %></small>
        </div>
    <% }) %>
</div>

 <script>
    function openSection(id) {
        // 1. Hide the main menu grid
        const mainMenu = document.getElementById('mainMenu');
        if (mainMenu) mainMenu.style.setProperty('display', 'none', 'important');

        // 2. Hide ALL portal sections first
        document.querySelectorAll('.portal-section').forEach(section => {
            section.style.setProperty('display', 'none', 'important');
        });

        // 3. Show the specific section we want
        const targetSection = document.getElementById(id);
        if (targetSection) {
            targetSection.style.setProperty('display', 'block', 'important');
            // 4. Show the Back to Menu button
            document.getElementById('backBtn').style.display = 'block';
            
            // 5. Auto-load QR codes when qr-codes section is opened
            if (id === 'qr-codes') {
                loadQRCodes();
            }
            
            // 6. Generate student QR code when attendance section is opened
            if (id === 'attendance') {
                generateStudentQRCode();
            }
        } else {
            console.error("Section with ID " + id + " not found!");
        }
    }

    function showMenu() {
        // Show menu and hide sections
        document.getElementById('mainMenu').style.display = 'grid';
        document.querySelectorAll('.portal-section').forEach(s => s.style.display = 'none');
        document.getElementById('backBtn').style.display = 'none';
    }

    function generateStudentQRCode() {
        const mmId = '<%= user.mmId %>';
        const container = document.getElementById('qrCodeContainer');
        
        if (!mmId || !container) {
            console.warn('QR code container or MM-ID not found');
            return;
        }
        
        // Clear previous QR code
        container.innerHTML = '';
        
        // Generate new QR code
        try {
            new QRCode(container, {
                text: mmId,
                width: 200,
                height: 200,
                colorDark: "#000000",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.H
            });
        } catch (error) {
            console.error('Error generating QR code:', error);
            container.innerHTML = '<p style="color: #c00;">Error generating QR code</p>';
        }
    }

    async function loadQRCodes() {
        try {
            console.log('Loading QR codes...');
            const response = await fetch('/api/student-qr-codes');
            console.log('Response status:', response.status);
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log('Data received:', data);
            
            const studentList = document.getElementById('studentQRList');
            
            if (!data.students || data.students.length === 0) {
                studentList.innerHTML = '<p style="color: #333; padding: 20px;">No students registered yet.</p>';
                console.log('No students found');
                return;
            }

            console.log('Rendering ' + data.students.length + ' students');

            let html = `
                <table style="width: 100%; border-collapse: collapse; margin-top: 20px; background: white;">
                <thead>
                    <tr style="background: #000; color: #ffcc00; padding: 10px; text-align: left;">
                        <th style="padding: 12px; border: 1px solid #ddd;">Student ID</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">Student Name</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">Email</th>
                        <th style="padding: 12px; border: 1px solid #ddd;">Action</th>
                    </tr>
                </thead>
                <tbody>
            `;

            data.students.forEach(student => {
                html += `
                    <tr style="border-bottom: 1px solid #ddd; background: white;">
                        <td style="padding: 12px; font-weight: bold; color: #800000;">${student.mmId || 'N/A'}</td>
                        <td style="padding: 12px; color: #333;">${student.name || 'N/A'}</td>
                        <td style="padding: 12px; color: #333;">${student.username || 'N/A'}</td>
                        <td style="padding: 12px;">
                            <a href="/api/download-qr/${student._id}" class="qr-download-btn" style="background: #ffcc00; color: #000; padding: 8px 15px; border-radius: 5px; text-decoration: none; font-weight: bold; display: inline-block;">
                                📥 Download QR
                            </a>
                        </td>
                    </tr>
                `;
            });

            html += `</tbody></table>`;
            studentList.innerHTML = html;
            console.log('Table rendered successfully');

        } catch (error) {
            console.error('Error loading QR codes:', error);
            document.getElementById('studentQRList').innerHTML = '<p style="color: #c00; padding: 20px; background: #ffe0e0; border-radius: 5px;">Error loading student data: ' + error.message + '</p>';
        }
    }

    </script>
<script>
    function toggleSidebar() {
        // This looks for the div with class="sidebar" and toggles the "active" style
        const sidebar = document.querySelector('.sidebar');
        sidebar.classList.toggle('active');
    }

    // This closes the sidebar if you tap anywhere on the dashboard while it's open
    document.addEventListener('click', function(event) {
        const sidebar = document.querySelector('.sidebar');
        const headerBtn = document.querySelector('header button');
        
        if (window.innerWidth <= 768 && 
            sidebar.classList.contains('active') && 
            !sidebar.contains(event.target) && 
            !headerBtn.contains(event.target)) {
            sidebar.classList.remove('active');
        }
    });

    // Touch swipe detection to close sidebar
    let touchStartX = 0;
    let touchEndX = 0;

    document.addEventListener('touchstart', function(event) {
        touchStartX = event.changedTouches[0].screenX;
    }, false);

    document.addEventListener('touchend', function(event) {
        touchEndX = event.changedTouches[0].screenX;
        const sidebar = document.querySelector('.sidebar');
        
        if (window.innerWidth <= 768 && sidebar.classList.contains('active')) {
            // Detect swipe from left to right (closing swipe)
            if (touchEndX > touchStartX + 50) {
                sidebar.classList.remove('active');
            }
        }
    }, false);

    // Handle folder selection and event loading
    document.getElementById('folderSelect').addEventListener('change', async function() {
        const folderId = this.value;
        const eventSelect = document.getElementById('eventSelect');
        const folderIdInput = document.getElementById('folderIdInput');

        if (!folderId) {
            eventSelect.disabled = true;
            eventSelect.innerHTML = '<option value="" disabled selected>-- Select Folder First --</option>';
            return;
        }

        // Store the folderId in hidden input
        folderIdInput.value = folderId;

        try {
            // Fetch events for this folder
            const response = await fetch(`/api/folder-events/${folderId}`);
            const events = await response.json();

            // Clear and populate event dropdown
            eventSelect.innerHTML = '<option value="" disabled selected>-- Select an Event --</option>';
            
            if (events.length > 0) {
                events.forEach(event => {
                    const option = document.createElement('option');
                    option.value = event.eventName;
                    option.textContent = event.eventName;
                    eventSelect.appendChild(option);
                });
                eventSelect.disabled = false;
            } else {
                eventSelect.innerHTML = '<option value="" disabled selected>No events in this folder yet</option>';
                eventSelect.disabled = true;
            }
        } catch (error) {
            console.error('Error loading events:', error);
            eventSelect.innerHTML = '<option value="" disabled selected>Error loading events</option>';
            eventSelect.disabled = true;
        }
    });

    // Handle form submission
    document.getElementById('scanForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const folderId = document.getElementById('folderIdInput').value;
        const eventName = document.getElementById('eventSelect').value;
        const sessionType = this.querySelector('select[name="sessionType"]').value;

        // Redirect to scanner with data
        window.location.href = `/attendance?folderId=${folderId}&eventName=${eventName}&sessionType=${sessionType}`;
    });
</script>
</body>
<script>
// Notification permission + Push subscription for service worker
(function(){
    if (!('Notification' in window) || !('serviceWorker' in navigator) || !('PushManager' in window)) return;

    const askedKey = 'notification-permission-requested';

    async function registerAndSubscribe() {
        try {
            const reg = await navigator.serviceWorker.register('/sw.js');
            // Get VAPID public key from server
            const r = await fetch('/vapidPublicKey');
            const { publicKey } = await r.json();

            // Convert key
            function urlBase64ToUint8Array(base64String) {
                const padding = '='.repeat((4 - base64String.length % 4) % 4);
                const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
                const rawData = window.atob(base64);
                const outputArray = new Uint8Array(rawData.length);
                for (let i = 0; i < rawData.length; ++i) {
                    outputArray[i] = rawData.charCodeAt(i);
                }
                return outputArray;
            }

            const sub = await reg.pushManager.subscribe({
                userVisibleOnly: true,
                applicationServerKey: urlBase64ToUint8Array(publicKey)
            });

            // Send subscription to server
            await fetch('/subscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(sub)
            });
        } catch (err) {
            console.error('Push registration error:', err);
        }
    }

    // Ask permission only once per browser using localStorage
    (async function maybeAsk() {
        if (localStorage.getItem(askedKey)) return;
        // Only prompt if user hasn't already granted or denied
        if (Notification.permission === 'default') {
            // Wait until DOM is stable (user just logged in)
            try {
                const permission = await Notification.requestPermission();
                localStorage.setItem(askedKey, '1');
                if (permission === 'granted') {
                    await registerAndSubscribe();
                }
            } catch (e) {
                console.error('Notification permission request failed', e);
            }
        } else if (Notification.permission === 'granted') {
            // Already granted: ensure subscription exists
            await registerAndSubscribe();
            localStorage.setItem(askedKey, '1');
        } else {
            // denied
            localStorage.setItem(askedKey, '1');
        }
    })();

})();
</script>
