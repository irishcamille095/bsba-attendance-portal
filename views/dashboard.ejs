<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="BSBA Portal">
    <meta name="theme-color" content="#FFD700">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/assets/img/logo.jpg">
    <title>BSBA-MM Portal</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <script src="/delete-confirmation.js"></script>
    <style>
        /* Dashboard-specific styles (sidebar, content layout, menu cards) */
        
        /* Sidebar */
        .sidebar { width: 250px; background: #000; color: #ffcc00; height: 100vh; position: fixed; padding: 20px; border-right: 4px solid #ffcc00; overflow-y: auto; }
        .sidebar h2 { border-bottom: 2px solid #ffcc00; padding-bottom: 10px; text-align: center; }
        .sidebar a { color: white; padding: 12px; display: block; text-decoration: none; transition: all 0.2s; }
        .sidebar a:hover { color: #ffcc00; background: rgba(255, 204, 0, 0.1); }
        
        /* Sidebar Close Button */
        .sidebar-close-btn {
            background: transparent;
            border: none;
            color: #ffcc00;
            font-size: 1.5em;
            cursor: pointer;
            padding: 4px;
            width: 32px;
            height: 32px;
            display: none;
            position: absolute;
            top: 20px;
            left: 20px;
            z-index: 2001;
            transition: all 0.3s;
            line-height: 1;
            text-align: center;
        }
        
        .sidebar-close-btn:hover {
            color: #fff;
        }
        
        /* Main Content */
        .content { flex: 1; margin-left: 290px; padding: 20px; }
        header { border-bottom: 3px solid #000; margin-bottom: 20px; padding: 10px 15px; }

        /* Button Grid (The Menu) */
        .menu-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px; }
        .menu-card { 
            background: #000; color: #ffcc00; border: 2px solid #ffcc00; padding: 30px 15px; 
            border-radius: 12px; cursor: pointer; text-align: center; font-weight: bold; font-size: 1em;
            transition: all 0.3s ease; min-height: 120px; display: flex; align-items: center; justify-content: center; flex-direction: column;
        }
        .menu-card:hover { background: #ffcc00; color: #000; transform: translateY(-3px); box-shadow: 0 8px 15px rgba(0,0,0,0.2); }
        .menu-card:active { transform: translateY(-1px); }

        /* Notification Badge Styles */
        .notification-badge {
            display: inline-block;
            background: #ff4444;
            color: white;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            line-height: 24px;
            text-align: center;
            font-size: 0.75em;
            font-weight: bold;
            margin-left: 8px;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(255, 68, 68, 0.7); }
            50% { box-shadow: 0 0 0 8px rgba(255, 68, 68, 0); }
        }

        .sidebar-notification-badge {
            display: inline-block;
            background: #ff4444;
            color: white;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            line-height: 20px;
            text-align: center;
            font-size: 0.7em;
            font-weight: bold;
            margin-left: 8px;
            animation: pulse 2s infinite;
        }

        /* Sections (Hidden by Default) */
        .portal-section { display: none; background: white; padding: 20px; border-radius: 12px; border: 2px solid #000; box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
        .back-btn { background: #000; color: #ffcc00; border: 2px solid #ffcc00; padding: 12px 20px; cursor: pointer; margin-bottom: 15px; display: inline-block; font-weight: bold; border-radius: 8px; font-size: 1em; transition: all 0.3s; max-width: 200px; }
        .back-btn:hover { background: #ffcc00; color: #000; }
        .back-btn:active { transform: scale(0.98); }

        /* Forms */
        input, textarea, select { width: 100%; padding: 12px; margin: 8px 0; border: 1px solid #ccc; border-radius: 5px; font-family: inherit; font-size: 1em; }
        input:focus, textarea:focus, select:focus { outline: none; border: 2px solid #ffcc00; }
        button { padding: 12px 20px; font-size: 1em; cursor: pointer; border-radius: 5px; transition: all 0.3s; }
        
        /* Images */
        img { max-width: 100%; height: auto; display: block; }
        
        /* Card styling */
        .card { margin: 10px 0; padding: 15px; background: #f9f9f9; border-radius: 8px; }

        /* Folder cards */
        .folder-card { transition: all 0.3s; }
        .folder-card:hover { transform: translateY(-3px); box-shadow: 0 5px 15px rgba(0,0,0,0.1); }

        /* Mobile-first responsive design */
        @media (max-width: 768px) {
            body { display: block; }
            
            .sidebar {
                width: 66.67% !important;
                height: 100vh !important;
                position: fixed;
                left: 0;
                top: 0;
                transform: translateX(-100%);
                transition: transform 0.3s ease;
                z-index: 2000;
                padding: 20px;
                border-right: 4px solid #FFD700;
                border-bottom: none;
                overflow-y: auto;
            }

            .sidebar.active {
                transform: translateX(0);
                overflow-y: auto;
            }
            
            .sidebar-close-btn {
                display: block !important;
            }

            .content {
                margin-left: 0;
                padding: 10px;
                padding-top: 20px;
                margin-top: 0;
            }

            header {
                position: sticky;
                top: 0;
                left: 0;
                right: 0;
                margin: 0;
                z-index: 1000;
                padding: 10px 12px;
                background: #FFD700;
            }

            header button {
                display: block !important;
                background: rgba(0,0,0,0.2);
                border: 1px solid rgba(0,0,0,0.3);
                color: #000;
                padding: 8px 12px;
                font-size: 1.3em;
                border-radius: 4px;
                cursor: pointer;
                margin-right: 10px;
                position: relative;
            }

            header h1 {
                font-size: 1em;
                margin: 0;
            }

            .menu-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 10px;
            }

            .menu-card {
                padding: 20px 10px;
                font-size: 0.9em;
                min-height: 100px;
            }

            .portal-section {
                padding: 15px;
                border-radius: 8px;
            }

            .back-btn {
                display: inline-block;
                max-width: 200px;
                padding: 10px 15px;
                font-size: 0.95em;
                width: auto;
            }

            input, textarea, select {
                padding: 11px;
                margin: 8px 0;
                font-size: 16px; /* Prevents auto-zoom on iOS */
            }

            button {
                padding: 12px 16px;
                font-size: 1em;
                width: auto;
            }
        }

        @media (max-width: 480px) {
            .menu-grid {
                grid-template-columns: 1fr;
                gap: 8px;
            }

            .menu-card {
                padding: 18px 10px;
                font-size: 0.85em;
                min-height: 90px;
            }

            .content {
                padding: 8px;
                margin-top: 0;
            }

            .portal-section {
                padding: 12px;
            }

            header h1 {
                font-size: 0.9em;
            }

            input, textarea, select {
                padding: 10px;
            }

            button {
                padding: 11px 14px;
                font-size: 0.95em;
            }

            .folder-card {
                padding: 12px;
            }
        }

        /* On Desktop: Show sidebar normally */
        @media (min-width: 769px) {
            .sidebar {
                transform: translateX(0) !important;
                position: fixed !important;
            }
            header button {
                display: none !important;
            }
        }

        /* PWA Install Button */
        .install-btn {
            background: linear-gradient(135deg, #FFD700, #FFC700);
            color: #000;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            font-size: 1em;
            transition: all 0.3s ease;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            display: none;
        }
        
        .install-btn:hover {
            background: linear-gradient(135deg, #FFC700, #FFB700);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
            transform: translateY(-2px);
        }
        
        .install-btn i {
            margin-right: 8px;
        }

        /* Sidebar Menu Item Hover Styles */
        .sidebar a:hover,
        .sidebar div[onclick]:hover {
            color: #FFD700 !important;
            background: rgba(255, 204, 0, 0.15) !important;
            padding-left: 16px !important;
            transition: all 0.2s ease !important;
        }
    </style>
</head>
<body>

    <div class="sidebar" id="sidebar">
    <button class="sidebar-close-btn" onclick="toggleSidebar()"><i class="fas fa-times"></i></button>
    
    <hr style="border: 1px solid #FFD700; margin: 50px 0 15px 0;">
    
    <!-- Sidebar Menu Items -->
    <a href="/my-account" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
        <i class="fas fa-user"></i> <span style="font-weight: bold;">Account Profile</span>
    </a>
    
    <a href="/attendance" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
        <i class="fas fa-camera"></i> <span style="font-weight: bold;">Attendance</span>
    </a>
    
    <% if (user.role === 'officer' || user.role === 'adviser') { %>
    <a href="/admin/students" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
        <i class="fas fa-users"></i> <span style="font-weight: bold;">Master Student List</span>
    </a>
    <% } %>
    
    <% if (user.role === 'officer' || user.role === 'adviser') { %>
    <a href="/fines-management" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
        <i class="fas fa-file-invoice-dollar"></i> <span style="font-weight: bold;">Fines Management</span>
    </a>
    <% } %>
    
    <a href="/my-documents" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
        <i class="fas fa-file-contract"></i> <span style="font-weight: bold;">My Documents</span>
    </a>
    
    <hr style="border: 1px solid #FFD700; margin: 15px 0;">
    
    <form action="/logout" method="POST" style="margin-top: 15px; display: block !important;">
        <button type="submit" class="back-btn" style="width: 100%; padding: 12px; background: #FFD700; color: #121212; border: none; border-radius: 12px; font-weight: bold; cursor: pointer; display: block;">
            <i class="fas fa-sign-out-alt"></i> Logout
        </button>
    </form>
</div>

                <div class="content">
            <header style="background: #FFD700; color: #121212; padding: 12px 15px; display: flex; align-items: center; justify-content: space-between; z-index: 1000; box-shadow: 0 2px 8px rgba(0,0,0,0.2);">
    <div style="display: flex; align-items: center;">
        <button onclick="toggleSidebar()" style="background: rgba(18,18,18,0.15); border: 1px solid rgba(18,18,18,0.3); color: #121212; padding: 8px 12px; border-radius: 8px; cursor: pointer; margin-right: 15px; font-size: 1.2rem; position: relative;">
            <i class="fas fa-bars"></i>
            <span id="hamburgerBadge" style="position: absolute; top: -8px; right: -8px; background: #ff4444; color: white; border-radius: 50%; width: 22px; height: 22px; line-height: 22px; text-align: center; font-size: 0.7em; font-weight: bold; display: none;"></span>
        </button>
        <h1 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: #121212;">Marketing Management Portal</h1>
    </div>
    
    <div style="width: 40px;"></div>
</header>

        <!-- User Profile Header - Visible to All Users -->
        <header style="background: #FFD700; color: #121212; padding: 8px 15px; display: flex; align-items: center; justify-content: space-between; z-index: 999; box-shadow: 0 1px 4px rgba(0,0,0,0.1);">
            <div style="display: flex; align-items: center; gap: 12px;">
                <% if (user.profilePhoto) { %>
                    <img src="<%= user.profilePhoto %>" alt="Profile" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 2px solid #121212;">
                <% } else { %>
                    <div style="width: 40px; height: 40px; border-radius: 50%; background: #ddd; display: flex; align-items: center; justify-content: center; border: 2px solid #121212;">
                        <i class="fas fa-user" style="font-size: 1.2rem; color: #999;"></i>
                    </div>
                <% } %>
                <span style="font-weight: 600; font-size: 0.95rem;"><%= user.firstName %> <%= user.lastName %></span>
            </div>
            <div style="display: flex; align-items: center; gap: 10px;">
                <% if (user.role === 'adviser' || user.role === 'officer') { %>
                    <a href="/admin/reset-requests" style="position: relative; color: #121212; text-decoration: none; font-size: 1.3rem; transition: all 0.3s; padding: 4px 8px; border-radius: 8px;" title="Password Reset Requests">
                        <i class="fas fa-lock"></i>
                        <% if (pendingResetRequestsCount > 0) { %>
                            <span style="position: absolute; top: -8px; right: -8px; background: #ff4444; color: white; border-radius: 50%; width: 22px; height: 22px; line-height: 22px; text-align: center; font-size: 0.7em; font-weight: bold;">
                                <%= pendingResetRequestsCount %>
                            </span>
                        <% } %>
                    </a>
                <% } %>
                <a href="/wallet" style="position: relative; color: #121212; text-decoration: none; font-size: 1.3rem; transition: all 0.3s; padding: 4px 8px; border-radius: 8px;" title="Wallet & Fines">
                    <i class="fas fa-wallet"></i>
                    <% if (studentTotalFine > 0) { %>
                        <span style="position: absolute; top: -8px; right: -8px; background: #ff4444; color: white; border-radius: 50%; width: auto; min-width: 22px; height: 22px; line-height: 22px; text-align: center; font-size: 0.6em; font-weight: bold; padding: 0 4px;">₱<%= studentTotalFine.toFixed(0) %></span>
                    <% } %>
                </a>
            </div>
        </header>

        <button id="backBtn" class="back-btn" onclick="showMenu()" style="display: none; margin-bottom: 15px; background: transparent; color: #FFD700; border: 2px solid #FFD700;"><i class="fas fa-arrow-left"></i> Back to Dashboard</button>

        <!-- Welcome Section -->
        <div id="welcomeSection" style="background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%); color: #FFD700; padding: 30px; border-radius: 12px; margin-bottom: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.3); border-left: 5px solid #FFD700;">
            <h1 style="margin: 0; font-size: 2em; color: #FFD700;">Welcome, <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></h1>
        </div>

        <!-- Latest Announcements Section -->
        <div id="announcementsSection">
            <h2 style="color: #FFD700; margin-bottom: 20px;"><i class="fas fa-bullhorn"></i> Latest Announcements</h2>

    <% if (user.role === 'officer' || user.role === 'adviser') { %>
        <div style="margin-bottom: 20px;">
            <button onclick="toggleAnnouncementForm()" style="background: #FFD700; color: #121212; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: bold; transition: all 0.3s;">
                <i class="fas fa-plus"></i> Post New Update
            </button>
        </div>
        <div id="announcementForm" style="background: #1e1e1e; padding: 15px; border-radius: 12px; margin-bottom: 20px; border: 1px solid #2d2d2d; display: none;">
            <h3 style="color: #FFD700; margin-top: 0;">Post New Update</h3>
            <form action="/post-announcement" method="POST" enctype="multipart/form-data" onsubmit="return validateAnnouncementForm(event)">
                <input type="text" name="title" placeholder="Announcement Title" required style="margin: 8px 0;">
                <textarea name="message" placeholder="Write your message here..." required style="margin: 8px 0;"></textarea>
                <input type="file" name="image" accept="image/*" style="margin: 8px 0;">
                <button type="submit" class="post-btn" id="announceBtn" style="background: #FFD700; color: #121212; margin-top: 10px;">Post to Portal</button>
            </form>
        </div>
    <% } %>

    <div id="announcementList">
    <% announcements.forEach(post => { %>
        <% if (user.role === 'officer' || user.role === 'adviser') { %>
            <div style="display: flex; gap: 10px; margin-bottom: 8px; justify-content: flex-end;">
                <button type="button" 
                        onclick="openEditAnnouncementModal('<%= post._id %>', '<%= post.title.replace(/'/g, "\\'") %>', '<%= post.message.replace(/'/g, "\\'").replace(/\n/g, '\\n') %>')"
                        style="background:none; border:none; cursor:pointer; font-size: 1.2em; color: #e0e0e0; transition: all 0.3s ease; padding: 5px 10px;"
                        onmouseover="this.style.color='#4da6ff'"
                        onmouseout="this.style.color='#e0e0e0'"
                        title="Edit announcement">
                    <i class="fas fa-edit"></i>
                </button>
                <button type="button" 
                        onclick="showDeleteAnnouncementConfirmation('<%= post._id %>')"
                        style="background:none; border:none; cursor:pointer; font-size: 1.2em; color: #e0e0e0; transition: all 0.3s ease; padding: 5px 10px;"
                        onmouseover="this.style.color='#ff6b6b'"
                        onmouseout="this.style.color='#e0e0e0'"
                        title="Delete announcement">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        <% } %>
        <div class="announcement-item">
            <h3><%= post.title %></h3>
            <p style="white-space: pre-wrap; word-wrap: break-word;"><%= post.message %></p>
            
            <% if (post.imageUrl) { %>
                <img src="<%= post.imageUrl %>" style="max-width: 100%; border-radius: 10px; margin-top: 10px;">
            <% } %>

            <p style="font-size: 0.85em; margin-top: 10px;">
                <strong>Posted by:</strong> <%= post.author %> | <strong>Date:</strong> <%= post.date.toDateString() %>
            </p>
        </div>
    <% }) %> 
    </div>

        
    </div>

<div id="attendance" class="portal-section" style="display: none;">
        <h2>📸 Attendance System</h2>
       <% if (user.role === 'officer' || user.role === 'adviser') { %>
    <form id="scanForm" style="background: #1e1e1e; padding: 20px; border-radius: 12px; border-left: 5px solid #FFD700; margin-bottom: 20px; border: 1px solid #2d2d2d;">
        <h3 style="color: #FFD700; margin-top: 0;"><i class="fas fa-mobile-alt"></i> Start Scanning Students</h3>
        
        <div style="display: flex; flex-direction: column; gap: 15px;">
            <div>
                <label style="display: block; font-weight: bold; margin-bottom: 5px; color: #e0e0e0;">Semester/Folder:</label>
                <select id="folderSelect" required style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #2d2d2d; background: #252525; color: #e0e0e0;">
                    <option value="" disabled selected>-- Select a Folder --</option>
                    <% folders.forEach(folder => { %>
                        <option value="<%= folder._id %>"><%= folder.name %></option>
                    <% }); %>
                </select>
            </div>

            <div>
                <label style="display: block; font-weight: bold; margin-bottom: 5px; color: #e0e0e0;">Event:</label>
                <select id="eventSelect" name="eventName" required style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #2d2d2d; background: #252525; color: #e0e0e0;" disabled>
                    <option value="" disabled selected>-- Select Folder First --</option>
                </select>
            </div>

            <div>
                <label style="display: block; font-weight: bold; margin-bottom: 5px; color: #e0e0e0;">Session Type:</label>
                <select name="sessionType" required style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #2d2d2d; background: #252525; color: #e0e0e0;">
                    <option value="AM_IN">Morning Check-In (AM IN)</option>
                    <option value="AM_OUT">Morning Check-Out (AM OUT)</option>
                    <option value="PM_IN">Afternoon Check-In (PM IN)</option>
                    <option value="PM_OUT">Afternoon Check-Out (PM OUT)</option>
                </select>
            </div>

            <input type="hidden" id="folderIdInput" name="folderId">

            <button type="submit" class="menu-card" style="background: #1e1e1e; color: #FFD700; padding: 15px; cursor: pointer; border: 2px solid #FFD700; font-weight: bold; width: 100%; border-radius: 12px; transition: all 0.3s ease;">
                <i class="fas fa-search"></i> OPEN SCANNER
            </button>
        </div>
    </form>
    
    <div class="filing-container" style="background: #1e1e1e; padding: 20px; border-radius: 12px; border-left: 5px solid #FFD700; border: 1px solid #2d2d2d;">
            <h3 style="color: #FFD700;"><i class="fas fa-folder"></i> Master Attendance Filing</h3>
            
            <form action="/create-folder" method="POST" style="display: flex; gap: 10px; margin-bottom: 20px;">
                <input type="text" name="folderName" placeholder="New Semester/Folder Name" required style="flex: 1; padding: 10px; border-radius: 8px; border: 1px solid #2d2d2d; background: #252525; color: #e0e0e0;">
                <button type="submit" style="background: #FFD700; color: #121212; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: bold;">+ Create</button>
            </form>

            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 15px;">
                <% folders.forEach(folder => { %>
                    <div class="folder-card" style="background: #252525; border-left: 5px solid #FFD700; border: 1px solid #2d2d2d; padding: 15px; border-radius: 12px; text-align: center; position: relative;">
                        <span style="font-size: 2.5rem; display: block; color: #FFD700;"><i class="fas fa-folder"></i></span>
                        <strong style="font-size: 0.9rem; color: #e0e0e0;"><%= folder.name %></strong>
                        
                        <div style="margin-top: 10px; display: flex; justify-content: space-between; font-size: 0.8rem;">
                            <a href="/folder-details/<%= folder._id %>" style="color: #FFD700; text-decoration: none;">View</a>
                            <a href="#" style="color: #ff6b6b; text-decoration: none;" onclick="showDeleteFolderConfirmation('<%= folder._id %>', '<%= folder.name %>'); return false;">Delete</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <% } else { %>
            <div style="text-align: center; padding: 20px; background: #1e1e1e; border-radius: 12px; border-left: 5px solid #FFD700; margin-bottom: 30px; border: 1px solid #2d2d2d;">
