// Delete folder confirmation
function showDeleteFolderConfirmation(folderId, folderName) {
    showDeleteConfirmation({
        title: '⚠️ Delete Folder',
        description: `Are you sure you want to delete the folder <strong>"${folderName}"</strong>?`,
        warning: 'This will delete the folder and all its attendance records. This action cannot be undone.',
        buttonText: 'Yes, Delete Folder',
        onConfirm: function() {
            window.location.href = `/delete-folder/${folderId}`;
        }
    });
}

// Validate announcement form before submission
function validateAnnouncementForm(event) {
    const messageField = event.target.querySelector('textarea[name="message"]');
    const messageText = messageField.value.trim();
    
    if (!messageText) {
        event.preventDefault();
        alert('Please fill in the announcement body text before posting.');
        messageField.focus();
        return false;
    }
    return true;
}

// Delete announcement confirmation
function openEditAnnouncementModal(announcementId, title, message) {
    message = message.replace(/\\n/g, '\n');
    
    const modal = document.createElement('div');
    modal.id = 'editAnnouncementModal';
    modal.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
    `;
    
    modal.innerHTML = `
        <div style="background: #1e1e1e; padding: 30px; border-radius: 12px; max-width: 500px; width: 90%; border: 2px solid #FFD700;">
            <h2 style="color: #FFD700; margin-top: 0; margin-bottom: 20px;">Edit Announcement</h2>
            <form id="editForm" onsubmit="submitEditAnnouncement(event, '${announcementId}')">
                <input type="text" id="editTitle" placeholder="Announcement Title" required style="width: 100%; padding: 12px; margin: 8px 0; border: 1px solid #ccc; border-radius: 5px; font-family: inherit; font-size: 1em; color: #000; box-sizing: border-box;" value="${title}">
                <textarea id="editMessage" placeholder="Write your message here..." required style="width: 100%; padding: 12px; margin: 8px 0; border: 1px solid #ccc; border-radius: 5px; font-family: inherit; font-size: 1em; color: #000; box-sizing: border-box; min-height: 120px;">${message}</textarea>
                <div style="display: flex; gap: 10px; margin-top: 20px;">
                    <button type="submit" style="flex: 1; background: #FFD700; color: #121212; border: none; padding: 12px; border-radius: 5px; cursor: pointer; font-weight: bold; transition: all 0.3s;" onmouseover="this.style.background='#FFC700'" onmouseout="this.style.background='#FFD700'">Update Announcement</button>
                    <button type="button" onclick="closeEditAnnouncementModal()" style="flex: 1; background: #555; color: white; border: none; padding: 12px; border-radius: 5px; cursor: pointer; font-weight: bold; transition: all 0.3s;" onmouseover="this.style.background='#777'" onmouseout="this.style.background='#555'">Cancel</button>
                </div>
            </form>
        </div>
    `;
    
    document.body.appendChild(modal);
    
    modal.addEventListener('click', function(e) {
        if (e.target === modal) {
            closeEditAnnouncementModal();
        }
    });
}

function closeEditAnnouncementModal() {
    const modal = document.getElementById('editAnnouncementModal');
    if (modal) {
        modal.remove();
    }
}

function submitEditAnnouncement(e, announcementId) {
    e.preventDefault();
    const title = document.getElementById('editTitle').value;
    const message = document.getElementById('editMessage').value;
    
    const form = document.createElement('form');
    form.action = '/edit-announcement';
    form.method = 'POST';
    form.innerHTML = `
        <input type="hidden" name="announcementId" value="${announcementId}">
        <input type="hidden" name="title" value="${title}">
        <textarea name="message" style="display: none;">${message}</textarea>
    `;
    document.body.appendChild(form);
    form.submit();
}

function showDeleteAnnouncementConfirmation(announcementId) {
    showDeleteConfirmation({
        title: '⚠️ Delete Announcement',
        description: 'Are you sure you want to delete this announcement?',
        warning: 'This announcement will be permanently deleted.',
        buttonText: 'Yes, Delete Announcement',
        onConfirm: function() {
            const form = document.createElement('form');
            form.action = '/delete-announcement';
            form.method = 'POST';
            form.innerHTML = `<input type="hidden" name="announcementId" value="${announcementId}">`;
            document.body.appendChild(form);
            form.submit();
        }
    });
}

// Load student fines
function loadStudentFines() {
    const container = document.getElementById('finesContainer');
    
    fetch('/api/student-fines')
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                let html = '<table style="width: 100%; border-collapse: collapse;">';
                html += '<thead><tr style="background: #000; color: #ffcc00;"><th style="padding: 12px; text-align: left; border-bottom: 2px solid #ffcc00;">Event</th><th style="padding: 12px; text-align: center; border-bottom: 2px solid #ffcc00;">Total Fine</th></tr></thead>';
                html += '<tbody>';
                
                let totalFine = 0;
                data.events.forEach((event, index) => {
                    html += `<tr style="background: ${index % 2 === 0 ? '#252525' : '#1e1e1e'}; border-bottom: 1px solid #2d2d2d;">`;
                    html += `<td style="padding: 12px; color: #e0e0e0;">${event.eventName}</td>`;
                    html += `<td style="padding: 12px; text-align: center; color: #ffcc00; font-weight: 700;">₱${event.totalFine}</td>`;
                    html += '</tr>';
                    totalFine += event.totalFine;
                });
                
                html += `<tr style="background: #000; margin-top: 10px; border-top: 2px solid #ffcc00;"><td style="padding: 12px; color: #ffcc00; font-weight: 700;">TOTAL</td><td style="padding: 12px; text-align: center; color: #ffcc00; font-weight: 700; font-size: 1.2em;">₱${totalFine}</td></tr>`;
                html += '</tbody></table>';
                
                if (data.events.length === 0) {
                    html = '<p style="text-align: center; color: #4ade80; font-weight: 700;">✅ No fines recorded. Great job!</p>';
                }
                
                container.innerHTML = html;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            container.innerHTML = '<p style="color: #ff6b6b;">Error loading fines data.</p>';
        });
}

// Load department fines
function loadDepartmentFines() {
    const container = document.getElementById('departmentFinesContainer');
    
    fetch('/api/all-student-fines')
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                let html = '<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 15px; margin-bottom: 20px;">';
                
                // Stats cards
                html += `<div style="background: #252525; border-left: 5px solid #ffcc00; padding: 15px; border-radius: 8px; border: 1px solid #2d2d2d;">
                    <p style="color: #999; margin: 0; font-size: 0.9em;">Total Students with Fines</p>
                    <h3 style="color: #ffcc00; margin: 10px 0 0 0;">${data.students.length}</h3>
                </div>`;
                
                html += `<div style="background: #252525; border-left: 5px solid #4ade80; padding: 15px; border-radius: 8px; border: 1px solid #2d2d2d;">
                    <p style="color: #999; margin: 0; font-size: 0.9em;">Total Fines Collected</p>
                    <h3 style="color: #4ade80; margin: 10px 0 0 0;">₱${data.totalCollected}</h3>
                </div>`;
                
                html += '</div>';
                
                // Fines table
                html += '<table style="width: 100%; border-collapse: collapse;">';
                html += '<thead><tr style="background: #000; color: #ffcc00;"><th style="padding: 12px; text-align: left; border-bottom: 2px solid #ffcc00;">Student Name</th><th style="padding: 12px; text-align: center; border-bottom: 2px solid #ffcc00;">Year Level</th><th style="padding: 12px; text-align: center; border-bottom: 2px solid #ffcc00;">Absences</th><th style="padding: 12px; text-align: center; border-bottom: 2px solid #ffcc00;">Total Fine</th></tr></thead>';
                html += '<tbody>';
                
                data.students.forEach((student, index) => {
                    html += `<tr style="background: ${index % 2 === 0 ? '#252525' : '#1e1e1e'}; border-bottom: 1px solid #2d2d2d;">`;
                    html += `<td style="padding: 12px; color: #e0e0e0;">${student.studentName}</td>`;
                    html += `<td style="padding: 12px; text-align: center; color: #ffcc00;">${student.yearLevel}</td>`;
                    html += `<td style="padding: 12px; text-align: center; color: #ff6b6b;">${student.absences}</td>`;
                    html += `<td style="padding: 12px; text-align: center; color: #ffcc00; font-weight: 700;">₱${student.totalFine}</td>`;
                    html += '</tr>';
                });
                
                html += '</tbody></table>';
                
                container.innerHTML = html;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            container.innerHTML = '<p style="color: #ff6b6b;">Error loading fines data.</p>';
        });
}

// Override openSection to load fines when section is opened
const originalOpenSection = openSection;
openSection = function(sectionId) {
    originalOpenSection(sectionId);
    
    if (sectionId === 'myFines') {
        loadStudentFines();
    } else if (sectionId === 'departmentFines') {
        loadDepartmentFines();
    }
};

</script>
<script src="/pwa-install.js"></script>
<script src="/document-notifications.js" data-user-role="<%= user.role %>"></script>
<script>
    // Add user role to document element for role-based checks
    document.documentElement.setAttribute('data-user-role', '<%= user.role %>');
</script>
<%- include('./_footer.ejs') %>
</body>
</html>