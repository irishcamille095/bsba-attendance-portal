        </a>
        
        <a href="/print-student-cards" style="background: #1e1e1e; color: #FFD700; border: 2px solid #FFD700; padding: 20px; border-radius: 12px; cursor: pointer; font-weight: bold; text-decoration: none; text-align: center; transition: all 0.3s ease; border: 1px solid #2d2d2d;">
            <div style="font-size: 2em; margin-bottom: 10px;"><i class="fas fa-print"></i></div>
            Print Mini ID Cards
        </a>
    </div>

    <button onclick="loadQRCodes()" style="background: #1e1e1e; color: #FFD700; border: 2px solid #FFD700; padding: 12px 25px; border-radius: 12px; cursor: pointer; font-weight: bold; margin-bottom: 20px;">
        <i class="fas fa-sync-alt"></i> Refresh List
    </button>

    <div id="studentQRList" style="background: #1e1e1e; padding: 20px; border-radius: 12px; border: 1px solid #2d2d2d;">
        <p style="color: #c0c0c0;">Loading student data...</p>
    </div>
</div>
<% } %>

 <script>
    const userRole = '<%= user.role %>';
    
    function openSection(id) {
        // 1. Hide the welcome and announcements section
        const welcomeSection = document.getElementById('welcomeSection');
        if (welcomeSection) welcomeSection.style.setProperty('display', 'none', 'important');
        
        const announcementsSection = document.getElementById('announcementsSection');
        if (announcementsSection) announcementsSection.style.setProperty('display', 'none', 'important');

        // 2. Hide ALL portal sections first
        document.querySelectorAll('.portal-section').forEach(section => {
            section.style.setProperty('display', 'none', 'important');
        });

        // 3. Show the specific section we want
        const targetSection = document.getElementById(id);
        if (targetSection) {
            targetSection.style.setProperty('display', 'block', 'important');
            // 4. Show the Back to Dashboard button
            document.getElementById('backBtn').style.display = 'block';
            
            // 5. Auto-load QR codes when qr-codes section is opened
            if (id === 'qr-codes') {
                loadQRCodes();
            }
            
            // 6. Generate student QR code when attendance section is opened (only for students)
            if (id === 'attendance' && userRole !== 'officer' && userRole !== 'adviser') {
                generateStudentQRCode();
            }

            // 7. Mark announcements as viewed when announcements section is opened
            if (id === 'announcements') {
                fetch('/mark-announcements-viewed', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                }).then(response => {
                    console.log('Mark announcements response status:', response.status);
                    return response.text().then(text => {
                        console.log('Response body:', text);
                        if (response.ok) {
                            // Hide the notification badge immediately on client-side
                            const badge = document.querySelector('.menu-card .notification-badge');
                            console.log('Badge element:', badge);
                            if (badge) {
                                badge.style.display = 'none';
                                console.log('Badge hidden successfully');
                            }
                            return { ok: true };
                        }
                        throw new Error(`Server responded with status ${response.status}: ${text}`);
                    });
                }).catch(err => {
                    console.error('Error marking announcements as viewed:', err);
                });
            }
        } else {
            console.error("Section with ID " + id + " not found!");
        }
    }

    function showMenu() {
        // Show welcome and announcements section and hide other sections
        document.getElementById('welcomeSection').style.display = 'block';
        document.getElementById('announcementsSection').style.display = 'block';
        document.querySelectorAll('.portal-section').forEach(s => s.style.display = 'none');
        document.getElementById('backBtn').style.display = 'none';
    }

    // Fetch and display the QR code tied to the MM ID from the server
    async function generateStudentQRCode() {
        const mmId = '<%= user.mmId %>';
        const container = document.getElementById('qrCodeContainer');
        
        if (!mmId || !container) {
            console.warn('QR code container or MM-ID not found');
            return;
        }
        
        // Clear previous QR code
        container.innerHTML = '';
        
        try {
            // Fetch the QR code from StudentIDPool (server-generated, tied to MM ID)
            const response = await fetch(`/api/student-qr/${mmId}`);
            if (!response.ok) {
                throw new Error('Failed to fetch QR code');
            }
            
            const data = await response.json();
            
            // Display the server-generated QR code as an image
            if (data.qrCode) {
                const img = document.createElement('img');
                img.src = data.qrCode;
                img.alt = `QR Code for ${mmId}`;
                img.style.cssText = 'max-width: 200px; height: auto; border: 2px solid #FFD700; border-radius: 8px;';
                container.appendChild(img);
            } else {
                container.innerHTML = '<p style="color: #ff9999;">QR code not found</p>';
            }
        } catch (error) {
            console.error('Error fetching QR code:', error);
            container.innerHTML = '<p style="color: #ff9999;">Error loading QR code</p>';
        }
    }

    async function loadQRCodes() {
        try {
            console.log('Loading QR codes...');
            const response = await fetch('/api/student-qr-codes');
            console.log('Response status:', response.status);
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log('Data received:', data);
            
            const studentList = document.getElementById('studentQRList');
            
            if (!data.students || data.students.length === 0) {
                studentList.innerHTML = '<p style="color: #333; padding: 20px;">No students registered yet.</p>';
                console.log('No students found');
                return;
            }

            console.log('Rendering ' + data.students.length + ' students');

            let html = `
                <table style="width: 100%; border-collapse: collapse; margin-top: 20px; background: #1e1e1e; border-radius: 12px; overflow: hidden; border: 1px solid #2d2d2d;">
                <thead>
                    <tr style="background: #252525; color: #FFD700; padding: 10px; text-align: left;">
                        <th style="padding: 12px; border: 1px solid #2d2d2d;">Student ID</th>
                        <th style="padding: 12px; border: 1px solid #2d2d2d;">Student Name</th>
                        <th style="padding: 12px; border: 1px solid #2d2d2d;">Email</th>
                        <th style="padding: 12px; border: 1px solid #2d2d2d;">Action</th>
                    </tr>
                </thead>
                <tbody>
            `;

            data.students.forEach(student => {
                html += `
                    <tr style="border-bottom: 1px solid #2d2d2d; background: #1e1e1e;">
                        <td style="padding: 12px; font-weight: bold; color: #FFD700;">${student.mmId || 'N/A'}</td>
                        <td style="padding: 12px; color: #e0e0e0;">${student.name || 'N/A'}</td>
                        <td style="padding: 12px; color: #e0e0e0;">${student.username || 'N/A'}</td>
                        <td style="padding: 12px;">
                            <a href="/api/download-qr/${student._id}" class="qr-download-btn" style="background: #FFD700; color: #121212; padding: 8px 15px; border-radius: 8px; text-decoration: none; font-weight: bold; display: inline-block;">
                                <i class="fas fa-download"></i> Download QR
                            </a>
                        </td>
                    </tr>
                `;
            });

            html += `</tbody></table>`;
            studentList.innerHTML = html;
            console.log('Table rendered successfully');

        } catch (error) {
            console.error('Error loading QR codes:', error);
            document.getElementById('studentQRList').innerHTML = '<p style="color: #ff6b6b; padding: 20px; background: rgba(255,107,107,0.15); border-radius: 8px; border: 1px solid #ff6b6b;">Error loading student data: ' + error.message + '</p>';
        }
    }

    </script>
<script>
    function toggleSidebar() {
        // This looks for the div with class="sidebar" and toggles the "active" style
        const sidebar = document.querySelector('.sidebar');
        sidebar.classList.toggle('active');
    }
    
    function updateHamburgerBadge() {
        const badge = document.getElementById('hamburgerBadge');
        const hasPendingResets = <%= pendingResetRequestsCount || 0 %> > 0;
        const hasStudentFine = <%= studentTotalFine || 0 %> > 0;
        
        if (hasPendingResets || hasStudentFine) {
            badge.style.display = 'block';
            let badgeText = '';
            if (hasPendingResets) badgeText += '<%= pendingResetRequestsCount %>';
            if (hasStudentFine && hasPendingResets) badgeText = '2';
            else if (hasStudentFine) badgeText = '1';
            badge.innerHTML = badgeText;
        }
    }
    
    // Initialize badge on page load
    window.addEventListener('load', updateHamburgerBadge);
    if (document.readyState === 'complete') updateHamburgerBadge();

    function toggleAnnouncementForm() {
        const form = document.getElementById('announcementForm');
        if (form.style.display === 'none') {
            form.style.display = 'block';
        } else {
            form.style.display = 'none';
        }
    }

    // This closes the sidebar if you tap anywhere on the dashboard while it's open
    document.addEventListener('click', function(event) {
        const sidebar = document.querySelector('.sidebar');
        const headerBtn = document.querySelector('header button');
        const closeBtn = document.querySelector('.sidebar-close-btn');
        
        if (window.innerWidth <= 768 && 
            sidebar.classList.contains('active') && 
            !sidebar.contains(event.target) && 
            !headerBtn.contains(event.target)) {
            sidebar.classList.remove('active');
        }
    });

    // Touch swipe detection to close sidebar
    let touchStartX = 0;
    let touchEndX = 0;

    document.addEventListener('touchstart', function(event) {
        touchStartX = event.changedTouches[0].screenX;
    }, false);

    document.addEventListener('touchend', function(event) {
        touchEndX = event.changedTouches[0].screenX;
        const sidebar = document.querySelector('.sidebar');
        
        if (window.innerWidth <= 768 && sidebar.classList.contains('active')) {
            // Detect swipe from left to right (closing swipe)
            if (touchEndX > touchStartX + 50) {
                sidebar.classList.remove('active');
            }
        }
    }, false);

    // Handle folder selection and event loading
    document.getElementById('folderSelect').addEventListener('change', async function() {
        const folderId = this.value;
        const eventSelect = document.getElementById('eventSelect');
        const folderIdInput = document.getElementById('folderIdInput');

        if (!folderId) {
            eventSelect.disabled = true;
            eventSelect.innerHTML = '<option value="" disabled selected>-- Select Folder First --</option>';
            return;
        }

        // Store the folderId in hidden input
        folderIdInput.value = folderId;

        try {
            // Fetch events for this folder
            const response = await fetch(`/api/folder-events/${folderId}`);
            const events = await response.json();

            // Clear and populate event dropdown
            eventSelect.innerHTML = '<option value="" disabled selected>-- Select an Event --</option>';
            
            if (events.length > 0) {
                events.forEach(event => {
                    const option = document.createElement('option');
                    option.value = event.eventName;
                    option.textContent = event.eventName;
                    eventSelect.appendChild(option);
                });
                eventSelect.disabled = false;
            } else {
                eventSelect.innerHTML = '<option value="" disabled selected>No events in this folder yet</option>';
                eventSelect.disabled = true;
            }
        } catch (error) {
            console.error('Error loading events:', error);
            eventSelect.innerHTML = '<option value="" disabled selected>Error loading events</option>';
            eventSelect.disabled = true;
        }
    });

    // Handle form submission
    document.getElementById('scanForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const folderId = document.getElementById('folderIdInput').value;
        const eventName = document.getElementById('eventSelect').value;
        const sessionType = this.querySelector('select[name="sessionType"]').value;

        // Redirect to scanner with data
        window.location.href = `/attendance?folderId=${folderId}&eventName=${eventName}&sessionType=${sessionType}`;
    });
</script>
</body>
