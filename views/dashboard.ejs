<% if (user.role === 'officer' || user.role === 'adviser') { %>
<div id="qr-codes" class="portal-section" style="display: none;">
    <h2><i class="fas fa-ticket-alt"></i> Student IDs & QR Codes</h2>
    <p style="color: #808080; margin-bottom: 20px;">Manage, view, and print student QR codes with MM-IDs.</p>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 30px;">
        <a href="/student-ids" style="background: #1e1e1e; color: #FFD700; border: 2px solid #FFD700; padding: 20px; border-radius: 12px; cursor: pointer; font-weight: bold; text-decoration: none; text-align: center; transition: all 0.3s ease; border: 1px solid #2d2d2d;">
            <div style="font-size: 2em; margin-bottom: 10px;"><i class="fas fa-list"></i></div>
