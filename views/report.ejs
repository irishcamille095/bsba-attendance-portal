<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Master Attendance List</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* Report-specific overrides */
        body { padding: 15px; }
        h2 { color: #800000; }
        th { background: #800000; }
        tr:hover { background: #f0f0f0; }
        .back-btn { display: inline-block; margin-bottom: 15px; text-decoration: none; color: white; font-weight: bold; background: #800000; padding: 10px 15px; border-radius: 8px; transition: background 0.3s; max-width: 200px; border: 2px solid #800000; }
        .back-btn:hover { background: #600000; }
        
        /* Mobile Responsive */
        @media (max-width: 768px) {
            body { padding: 10px; }
            .container { max-width: 100%; }
            table { font-size: 0.9em; overflow-x: auto; display: block; }
            thead { display: none; }
            tbody { display: block; }
            tr { display: block; margin-bottom: 15px; border: 1px solid #ddd; background: white; border-radius: 5px; padding: 10px; }
            td { display: block; padding: 8px 0; border: none; padding-left: 40%; position: relative; }
            td:before { content: attr(data-label); position: absolute; left: 10px; font-weight: bold; color: #800000; }
            tr:nth-child(even) { background: white; }
            tr:hover { background: white; }
        }
        @media (max-width: 480px) {
            body { padding: 8px; }
            h2 { font-size: 1.2em; }
            .back-btn { padding: 8px 12px; font-size: 0.9em; }
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/dashboard" class="back-btn">← Back to Dashboard</a>
        <h2><i class="fas fa-list"></i> Master Attendance List (Real-time Cloud Data)</h2>

        <table>
            <thead>
                <tr>
                    <th>Student Name</th>
                    <th>Student ID</th>
                    <th>Session</th>
                    <th>Date</th>
                    <th>Time</th>
                </tr>
            </thead>
            <tbody>
                <% logs.forEach(log => { %>
                    <tr>
                        <td data-label="Student Name"><%= log.studentName %></td>
                        <td data-label="Student ID"><%= log.studentId %></td>
                        <td data-label="Session"><strong><%= log.sessionType %></strong></td>
                        <td data-label="Date"><%= log.date %></td>
                        <td data-label="Time"><%= log.time %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
<%- include('./_footer.ejs') %>
</body>
</html>