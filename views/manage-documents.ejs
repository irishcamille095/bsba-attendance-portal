<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#FFD700">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/assets/img/logo.jpg">
    <title>Manage Documents - BSBA Portal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body { 
            font-family: 'Segoe UI', sans-serif; 
            background: #121212;
            display: flex;
            margin: 0;
            padding: 0;
        }
        
        /* Sidebar */
        .sidebar { 
            display: none;
            width: 250px;
            background: #000;
            color: #ffcc00;
            height: 100vh;
            position: fixed;
            padding: 20px;
            border-right: 4px solid #ffcc00;
            overflow-y: auto;
        }

/* Sidebar heading removed - using dividers instead */

.sidebar a {
            color: #e0e0e0;
            padding: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            margin-bottom: 8px;
            border-radius: 8px;
            transition: all 0.2s;
        }

        .sidebar a:hover {
            color: #ffcc00;
            background: rgba(255, 204, 0, 0.1);
        }

        .sidebar span {
            font-weight: bold;
        }

.sidebar-close-btn {
            background: none;
            border: none;
            color: #ffcc00;
            font-size: 1.5rem;
            cursor: pointer;
            float: right;
            margin-bottom: 10px;
        }

        .sidebar-close-btn:hover {
            color: #e6b800;
        }

        .logout-btn {
            background: #FFD700;
            color: #121212;
            border: none;
            padding: 12px;
            width: 100%;
            margin-top: 15px;
            border-radius: 12px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .logout-btn:hover {
            background: #e6b800;
        }

        /* Sidebar */
        .sidebar { 
            width: 250px;
            background: #000;
            color: #ffcc00;
            height: 100vh;
            position: fixed;
            left: 0;
            padding: 20px;
            border-right: 4px solid #ffcc00;
            overflow-y: auto;
            top: 0;
            z-index: 1000;
        }

        .content { 
            flex: 1; 
            margin-left: 290px;
            margin-top: 0;
            padding: 30px;
            width: calc(100% - 290px);
            overflow-x: hidden;
            min-height: 100vh;
        }

        header {
            background: #FFD700;
            color: #000;
            padding: 20px;
            border-radius: 8px;
            margin: 0 0 30px 0;
            width: 100%;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        header h1 {
            font-size: 24px;
            margin: 0;
            color: #000;
            font-weight: bold;
        }

        header button {
            background: transparent;
            color: #000;
            border: none;
            cursor: pointer;
            font-size: 24px;
            padding: 0;
            display: none;
        }

        .page-header {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            margin-bottom: 30px;
            gap: 40px;
            margin-top: 50px;
        }

        .page-header h2 {
            color: #FFD700;
            font-size: 28px;
            margin: 0;
        }

        .page-header button {
            background: #FFD700;
            color: #000;
            padding: 10px 15px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
        }

        .page-header button:hover {
            background: #e6b800;
        }

        /* Toggle Section */
        .toggle-section {
            background: #1a1a1a;
            border: 2px solid #FFD700;
            border-radius: 8px;
            margin-bottom: 30px;
            overflow: hidden;
        }

        .toggle-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            background: #800000;
            cursor: pointer;
            transition: all 0.3s;
        }

        .toggle-header h3 {
            color: #FFD700;
            margin: 0;
            font-size: 18px;
        }

        .toggle-header i {
            color: #FFD700;
            transition: transform 0.3s;
        }

        .toggle-header.active i {
            transform: rotate(180deg);
        }

        .toggle-content {
            display: none;
            padding: 20px;
            background: #1a1a1a;
        }

        .toggle-content.active {
            display: block;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            color: #FFD700;
            margin-bottom: 8px;
            font-weight: bold;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 12px;
            background: #252525;
            border: 1px solid #444;
            border-radius: 4px;
            color: #fff;
            font-family: 'Segoe UI', sans-serif;
            font-size: 14px;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #FFD700;
            box-shadow: 0 0 5px rgba(255, 215, 0, 0.3);
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .btn-create {
            background: #FFD700;
            color: #000;
            padding: 12px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            transition: all 0.3s;
            width: 100%;
        }

        .btn-create:hover {
            background: #e6b800;
        }

        .btn-create:disabled {
            background: #666;
            cursor: not-allowed;
        }

        /* Table */
        table {
            width: 100%;
            border-collapse: collapse;
            background: #1a1a1a;
            margin-bottom: 30px;
            border-radius: 8px;
            overflow: hidden;
        }

        table thead {
            background: #800000;
            color: #FFD700;
            text-align: left;
        }

        table th {
            padding: 15px;
            font-weight: bold;
        }

        table td {
            padding: 12px 15px;
            border-bottom: 1px solid #333;
        }

        table tbody tr:hover {
            background: #252525;
        }

        .btn-download {
            background: #4CAF50;
            color: white;
            padding: 8px 12px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
            transition: all 0.3s;
        }

        .btn-download:hover {
            background: #45a049;
        }

        /* Tabs */
        .tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 30px;
            flex-wrap: wrap;
            border-bottom: 3px solid #FFD700;
        }

        .tab {
            padding: 12px 20px;
            background: #222;
            color: #FFD700;
            border: 2px solid #FFD700;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: bold;
            font-size: 14px;
            border-radius: 4px 4px 0 0;
        }

        .tab:hover {
            background: #333;
            transform: translateY(-2px);
        }

        .tab.active {
            background: #FFD700;
            color: #000;
            border-color: #FFD700;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        .alert {
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 4px;
            display: none;
        }

        .alert.success {
            background: #4CAF50;
            color: white;
            display: block;
        }

        .alert.error {
            background: #f44336;
            color: white;
            display: block;
        }

        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            animation: fadeIn 0.3s ease-in;
        }

        .modal.show {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: #111;
            padding: 30px;
            border-radius: 10px;
            width: 90%;
            max-width: 500px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        }

        .modal-content h2 {
            color: #FFD700;
            margin-bottom: 20px;
        }

        .modal-content p {
            color: #e0e0e0;
            margin-bottom: 15px;
            line-height: 1.6;
        }

        .close {
            float: right;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
            color: #e0e0e0;
            transition: color 0.3s;
        }

        .close:hover {
            color: #FFD700;
        }

        .modal-buttons {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .modal-buttons button {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
        }

        .btn-confirm {
            background: #d32f2f;
            color: #fff;
        }

        .btn-confirm:hover {
            background: #c62828;
        }

        .btn-cancel {
            background: #666;
            color: #fff;
        }

        .btn-cancel:hover {
            background: #777;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        /* Document Types List */
        .document-types-list {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            overflow-x: auto;
            overflow-y: hidden;
            scroll-behavior: smooth;
            padding: 10px 0;
            -webkit-overflow-scrolling: touch;
        }

        .document-types-list::-webkit-scrollbar {
            height: 8px;
        }

        .document-types-list::-webkit-scrollbar-track {
            background: #222;
            border-radius: 10px;
        }

        .document-types-list::-webkit-scrollbar-thumb {
            background: #FFD700;
            border-radius: 10px;
        }

        .document-types-list::-webkit-scrollbar-thumb:hover {
            background: #e6b800;
        }

        .document-type-card {
            background: #111;
            padding: 20px;
            border-radius: 10px;
            border-left: 4px solid #FFD700;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-width: 350px;
            flex-shrink: 0;
        }

        .document-type-card h4 {
            color: #FFD700;
            margin: 0 0 10px 0;
            font-size: 16px;
            word-break: break-word;
        }

        .document-type-info {
            margin-bottom: 15px;
        }

        .document-type-info p {
            color: #b0b0b0;
            font-size: 14px;
            margin: 5px 0;
        }

        .pass-rate {
            display: inline-block;
            background: #2196F3;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .btn-delete-type {
            background: #d32f2f;
            color: white;
            padding: 10px 15px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
            transition: all 0.3s;
            align-self: flex-start;
        }

        .btn-delete-type:hover {
            background: #c62828;
            transform: translateY(-2px);
        }


        @media (max-width: 768px) {
            body {
                display: block;
            }

            .sidebar {
                width: 66.67%;
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                transform: translateX(-100%);
                transition: transform 0.3s ease;
                z-index: 2000;
                padding: 20px;
                border-right: 4px solid #FFD700;
                border-bottom: none;
                overflow-y: auto;
            }

            .sidebar.active {
                transform: translateX(0);
                overflow-y: auto;
            }

            .content {
                margin-left: 0;
                width: 100%;
                padding: 10px;
                padding-top: 20px;
                margin-top: 0;
            }

            header {
                background: #FFD700;
                color: #000;
                padding: 12px 15px;
                display: flex;
                align-items: center;
                margin-bottom: 20px;
                border-radius: 0;
            }

            header button {
                background: rgba(0, 0, 0, 0.2);
                border: 1px solid rgba(0, 0, 0, 0.3);
                color: #000;
                padding: 8px 12px;
                border-radius: 4px;
                cursor: pointer;
                margin-right: 10px;
                font-size: 1.3em;
            }

            header h1 {
                font-size: 18px;
                flex: 1;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            table th, table td {
                padding: 8px;
                font-size: 12px;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div id="sidebar" class="sidebar">
        <button class="sidebar-close-btn" onclick="toggleSidebar()"><i class="fas fa-times"></i></button>
        
        <hr style="border: 1px solid #FFD700; margin: 50px 0 15px 0;">
        
        <!-- Sidebar Menu Items -->
        <a href="/my-account" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
            <i class="fas fa-user"></i> <span style="font-weight: bold;">Account Profile</span>
        </a>
        
        <a href="/attendance" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
            <i class="fas fa-camera"></i> <span style="font-weight: bold;">Attendance</span>
        </a>
        
        <% if (user.role === 'officer' || user.role === 'adviser') { %>
        <a href="/scanner" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
            <i class="fas fa-qrcode"></i> <span style="font-weight: bold;">Scanner</span>
        </a>
        
        <a href="/officer-dashboard" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
            <i class="fas fa-chart-bar"></i> <span style="font-weight: bold;">Officer Dashboard</span>
        </a>
        <% } %>
        
        <a href="/my-documents" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
            <i class="fas fa-file-contract"></i> <span style="font-weight: bold;">My Documents</span>
        </a>
        
        <hr style="border: 1px solid #FFD700; margin: 15px 0;">
        
        <form action="/logout" method="POST" style="margin-top: 15px; display: block !important;">
            <button type="submit" class="logout-btn" style="width: 100%; padding: 12px; background: #FFD700; color: #121212; border: none; border-radius: 12px; font-weight: bold; cursor: pointer; display: block;">
                <i class="fas fa-sign-out-alt"></i> Logout
            </button>
        </form>
    </div>

    <!-- Alert Container -->
    <div id="alertContainer"></div>

    <div class="content">
        <!-- Header -->
        <header>
            <button onclick="toggleSidebar()" style="background: rgba(0, 0, 0, 0.2); border: 1px solid rgba(0, 0, 0, 0.3); color: #000; padding: 8px 12px; border-radius: 8px; cursor: pointer; margin-right: 15px; font-size: 1.2rem;">
                <i class="fas fa-bars"></i>
            </button>
            <h1>📄 Manage Documents</h1>
        </header>

        <div class="page-header">
            <button onclick="window.location.href='/my-documents'">
                <i class="fas fa-arrow-left"></i> Back to My Documents
            </button>
        </div>

        <!-- Alert Messages -->
        <div id="alertMessage" class="alert"></div>

        <!-- Toggle Section: Create New Document Type -->
        <div class="toggle-section">
            <div class="toggle-header" onclick="toggleCreateForm()">
                <h3>
                    <i class="fas fa-plus-circle"></i> Create New Document Type
                </h3>
                <i class="fas fa-chevron-down"></i>
            </div>

            <div class="toggle-content" id="createFormContent">
                <form id="createDocumentForm">
                    <div class="form-group">
                        <label for="docTitle">Document Title</label>
                        <input type="text" id="docTitle" name="title" placeholder="e.g., Certificate of Good Moral Character" required>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="docType">File Type</label>
                            <select id="docType" name="fileType" required>
                                <option value="">-- Select --</option>
                                <option value="image">Image Only</option>
                                <option value="file">File Only</option>
                                <option value="both">Image or File</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="maxUploads">Maximum Uploads</label>
                            <input type="number" id="maxUploads" name="maxUploads" min="1" placeholder="e.g., 1" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="docDescription">Description (Optional)</label>
                        <textarea id="docDescription" name="description" rows="3" placeholder="Add any additional instructions or notes"></textarea>
                    </div>

                    <button type="submit" class="btn-create">
                        <i class="fas fa-check-circle"></i> Create Document Type
                    </button>
                </form>
            </div>
        </div>

        <!-- Created Document Types List -->
        <div style="margin-bottom: 30px;">
            <h3 style="color: #FFD700; margin-bottom: 20px; font-size: 20px;">
                <i class="fas fa-file-alt"></i> Created Document Types
            </h3>
            <div class="document-types-list" id="documentTypesList">
                <div style="color: #b0b0b0; font-style: italic;">Loading document types...</div>
            </div>
        </div>

        <!-- Year Level Tabs -->
        <div class="tabs" id="yearLevelTabs"></div>

        <!-- Tables for each Year Level -->
        <div id="tablesContainer"></div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeDeleteModal()">&times;</span>
            <h2>Delete Document Type</h2>
            <p>Are you sure you want to delete<span id="deleteDocTitle"></span>?</p>
            <p style="color: #ff9800; font-weight: bold;">⚠️ This will also delete all student submissions for this document type.</p>
            <div class="modal-buttons">
                <button type="button" class="btn-confirm" onclick="confirmDelete()">Delete</button>
                <button type="button" class="btn-cancel" onclick="closeDeleteModal()">Cancel</button>
            </div>
        </div>
    </div>

    <script>
        let documentTypes = [];
        let yearLevels = ['1st Year', '2nd Year', '3rd Year', '4th Year'];
        let allUsersData = [];
        let deleteTargetId = null;

        // Sidebar Toggle
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('active');
        }

        // Create Form Toggle
        function toggleCreateForm() {
            const header = document.querySelector('.toggle-header');
            const content = document.getElementById('createFormContent');
            header.classList.toggle('active');
            content.classList.toggle('active');
        }

        // Show Alert
        function showAlert(message, type = 'success') {
            const alertDiv = document.getElementById('alertMessage');
            alertDiv.className = `alert ${type}`;
            alertDiv.innerHTML = `<i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'}"></i> ${message}`;
            alertDiv.style.display = 'block';
            if (type === 'success') {
                setTimeout(() => alertDiv.style.display = 'none', 3000);
            }
        }

        // Load Document Types
        async function loadDocumentTypes() {
            try {
                const response = await fetch('/api/get-document-types');
                documentTypes = await response.json();
                renderDocumentTypesList();
                loadUsers();
            } catch (error) {
                console.error('Error loading document types:', error);
                showAlert('Failed to load document types', 'error');
            }
        }

        // Render Document Types List with Pass Rates
        async function renderDocumentTypesList() {
            try {
                const response = await fetch('/api/get-all-users');
                const allUsers = await response.json();
                const totalStudents = allUsers.filter(u => u.role !== 'adviser').length;

                const container = document.getElementById('documentTypesList');

                if (!documentTypes || documentTypes.length === 0) {
                    container.innerHTML = '<div style="color: #b0b0b0; font-style: italic;">No document types created yet.</div>';
                    return;
                }

                const cardsHTML = await Promise.all(documentTypes.map(async (docType) => {
                    // Count how many students have submitted this document type
                    const studentsWithSubmission = allUsers.filter(u => 
                        u.role !== 'adviser' && u.uploadedDocuments && u.uploadedDocuments.some(doc => 
                            doc.documentTypeId === docType._id
                        )
                    ).length;

                    const passRate = totalStudents > 0 ? studentsWithSubmission : 0;
                    const passPercentage = totalStudents > 0 ? Math.round((passRate / totalStudents) * 100) : 0;

                    return `
                        <div class="document-type-card">
                            <div>
                                <h4>${docType.title}</h4>
                                <div class="document-type-info">
                                    <p><strong>File Type:</strong> ${docType.fileType}</p>
                                    <p><strong>Max Uploads:</strong> ${docType.maxUploads}</p>
                                    ${docType.description ? `<p><strong>Description:</strong> ${docType.description}</p>` : ''}
                                    <div class="pass-rate">
                                        <i class="fas fa-users"></i> ${passRate}/${totalStudents} students submitted
                                    </div>
                                </div>
                            </div>
                            <button class="btn-delete-type" onclick="deleteDocumentType('${docType._id}', '${docType.title}')">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                    `;
                }));

                container.innerHTML = cardsHTML.join('');
            } catch (error) {
                console.error('Error rendering document types list:', error);
            }
        }

        // Delete Document Type - Open Modal
        function deleteDocumentType(docTypeId, docTitle) {
            deleteTargetId = docTypeId;
            document.getElementById('deleteDocTitle').textContent = ` "${docTitle}"`;
            openDeleteModal();
        }

        // Open Delete Modal
        function openDeleteModal() {
            document.getElementById('deleteModal').classList.add('show');
        }

        // Close Delete Modal
        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('show');
            deleteTargetId = null;
        }

        // Confirm Delete
        async function confirmDelete() {
            if (!deleteTargetId) return;

            try {
                const response = await fetch(`/api/delete-document-type/${deleteTargetId}`, {
                    method: 'DELETE'
                });

                if (!response.ok) {
                    throw new Error('Failed to delete document type');
                }

                showAlert('Document type deleted successfully', 'success');
                closeDeleteModal();
                loadDocumentTypes();
            } catch (error) {
                console.error('Error deleting document type:', error);
                showAlert('Failed to delete document type: ' + error.message, 'error');
            }
        }

        // Load Users (Students and Officers)
        async function loadUsers() {
            try {
                const response = await fetch('/api/get-all-users');
                const data = await response.json();
                allUsersData = data;
                renderTables();
            } catch (error) {
                console.error('Error loading users:', error);
                showAlert('Failed to load user data', 'error');
            }
        }

        // Render Year Level Tabs and Tables
        function renderTables() {
            const tabsContainer = document.getElementById('yearLevelTabs');
            const tablesContainer = document.getElementById('tablesContainer');
            
            tabsContainer.innerHTML = '';
            tablesContainer.innerHTML = '';

            yearLevels.forEach((level, index) => {
                // Create Tab
                const tab = document.createElement('button');
                tab.className = `tab ${index === 0 ? 'active' : ''}`;
                tab.textContent = level;
                tab.onclick = () => switchTab(level, tab);
                tabsContainer.appendChild(tab);

                // Create Table Content
                const tabContent = document.createElement('div');
                tabContent.className = `tab-content ${index === 0 ? 'active' : ''}`;
                tabContent.id = `tab-${level}`;
                tabContent.innerHTML = renderTable(level);
                tablesContainer.appendChild(tabContent);
            });
        }

        // Render Table for Specific Year Level
        function renderTable(yearLevel) {
            // Filter users by year level and sort
            let users = allUsersData.filter(u => u.yearLevel === yearLevel || (yearLevel === 'Officers' && (u.role === 'officer' || u.role === 'adviser')));
            users.sort((a, b) => {
                const aLast = (a.lastName || '').toUpperCase();
                const bLast = (b.lastName || '').toUpperCase();
                const aFirst = (a.firstName || '').toUpperCase();
                const bFirst = (b.firstName || '').toUpperCase();
                
                if (aLast !== bLast) return aLast.localeCompare(bLast);
                return aFirst.localeCompare(bFirst);
            });

            let html = '<div class="table-wrapper"><table><thead><tr><th>Name</th>';
            
            // Add document type headers
            documentTypes.forEach(doc => {
                html += `<th>${doc.title}</th>`;
            });

            html += '</tr></thead><tbody>';

            // Add rows
            users.forEach(user => {
                const fullName = `${user.lastName || ''}, ${user.firstName || ''}`.trim();
                html += `<tr><td><strong>${fullName}</strong></td>`;

                documentTypes.forEach(doc => {
                    // Check if user has uploaded this document
                    const isUploaded = user.uploadedDocuments && user.uploadedDocuments.some(d => 
                        d.documentTypeId.toString() === doc._id.toString()
                    );
                    html += `<td>`;
                    if (isUploaded) {
                        html += `<button class="btn-download" onclick="downloadDocument('${doc._id}', '${user._id}')">
                            <i class="fas fa-download"></i> Download
                        </button>`;
                    }
                    html += `</td>`;
                });

                html += '</tr>';
            });

            html += '</tbody></table></div>';
            return html;
        }

        // Switch Tab
        function switchTab(level, tabButton) {
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            
            tabButton.classList.add('active');
            document.getElementById(`tab-${level}`).classList.add('active');
        }

        // Download Document
        async function downloadDocument(documentTypeId, userId) {
            try {
                window.location.href = `/download-document?documentTypeId=${documentTypeId}&userId=${userId}`;
            } catch (error) {
                console.error('Error downloading document:', error);
                showAlert('Failed to download document', 'error');
            }
        }

        // Create Document Type
        document.getElementById('createDocumentForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            console.log('[FORM] Document creation form submitted');

            const formData = {
                title: document.getElementById('docTitle').value,
                fileType: document.getElementById('docType').value,
                maxUploads: parseInt(document.getElementById('maxUploads').value),
                description: document.getElementById('docDescription').value
            };

            console.log('[FORM] Sending data:', formData);

            try {
                const response = await fetch('/api/create-document-type', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                console.log('[RESPONSE] Status:', response.status);
                const responseData = await response.json();
                console.log('[RESPONSE] Data:', responseData);

                if (!response.ok) throw new Error(responseData.error || 'Failed to create document type');

                console.log('[SUCCESS] Document created successfully');
                showAlert('Document type created successfully! Redirecting to My Documents...', 'success');
                document.getElementById('createDocumentForm').reset();
                toggleCreateForm();
                
                // Redirect to my-documents after a short delay to ensure DB is updated
                setTimeout(() => {
                    console.log('[REDIRECT] Redirecting to my-documents...');
                    window.location.href = '/my-documents';
                }, 1000);
            } catch (error) {
                console.error('[ERROR] Error creating document type:', error);
                showAlert('Failed to create document type: ' + error.message, 'error');
            }
        });

        // Close modal when clicking outside
        window.addEventListener('click', (event) => {
            const modal = document.getElementById('deleteModal');
            if (event.target === modal) {
                closeDeleteModal();
            }
        });

        // Initial Load
        window.addEventListener('DOMContentLoaded', loadDocumentTypes);
    </script>
<%- include('./_footer.ejs') %>
</body>
</html>
