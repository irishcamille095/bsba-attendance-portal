<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Documents</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #000 0%, #1a1a1a 100%);
            color: #e0e0e0;
            display: flex;
            flex-direction: column;
            margin: 0;
            padding: 0;
        }

        /* Sidebar Styles */
        .sidebar {
            width: 250px;
            background: #000;
            color: #ffcc00;
            height: 100vh;
            position: fixed;
            left: 0;
            padding: 20px;
            border-right: 4px solid #ffcc00;
            overflow-y: auto;
            z-index: 1000;
            top: 0;
        }

        .sidebar-close-btn {
            background: none;
            border: none;
            color: #ffcc00;
            font-size: 1.5rem;
            cursor: pointer;
            display: block;
            margin-bottom: 10px;
        }

        .sidebar-close-btn:hover {
            color: #e6b800;
        }

        .sidebar a {
            color: #e0e0e0;
            padding: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            margin-bottom: 8px;
            border-radius: 8px;
            transition: all 0.2s;
        }

        .sidebar a span {
            font-weight: bold;
        }

        .sidebar a:hover {
            color: #ffcc00;
            background: rgba(255, 204, 0, 0.1);
        }

        .logout-btn {
            background: #FFD700;
            color: #121212;
            border: none;
            padding: 12px;
            width: 100%;
            margin-top: 15px;
            border-radius: 12px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            display: block;
        }

        .logout-btn:hover {
            background: #e6b800;
        }

        .container {
            flex: 1;
            margin-left: 290px;
            width: calc(100% - 290px);
            max-width: none;
            margin: 0;
            padding: 20px;
        }

        header button {
            background: rgba(18, 18, 18, 0.15);
            border: 1px solid rgba(18, 18, 18, 0.3);
            color: #121212;
            padding: 8px 12px;
            border-radius: 8px;
            cursor: pointer;
            display: none;
            font-size: 1.2rem;
        }

        header {
            background: #FFD700;
            color: #121212;
            padding: 12px 15px;
            display: flex;
            align-items: center;
            z-index: 1000;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
            border-radius: 10px;
            margin-bottom: 20px;
        }

        header button {
            background: rgba(18,18,18,0.15);
            border: 1px solid rgba(18,18,18,0.3);
            color: #121212;
            padding: 8px 12px;
            border-radius: 8px;
            cursor: pointer;
            margin-right: 15px;
            font-size: 1.2rem;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding: 20px;
            background: #111;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

        .header h1 {
            color: #FFD700;
            font-size: 2em;
        }


        .progress-info {
            display: flex;
            gap: 30px;
            align-items: center;
        }

        .progress-stat {
            text-align: center;
        }

        .progress-stat .number {
            font-size: 2em;
            color: #FFD700;
            font-weight: bold;
        }

        .progress-stat .label {
            font-size: 0.9em;
            color: #b0b0b0;
        }

        .alert {
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .alert-success {
            background: #4CAF50;
            color: white;
        }

        .alert-error {
            background: #d32f2f;
            color: white;
        }

        .alert-info {
            background: #2196F3;
            color: white;
        }

        #alertContainer {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
            max-width: 400px;
        }

        .alert {
            margin-bottom: 10px;
            animation: slideIn 0.3s ease-out;
        }

        @keyframes slideIn {
            from {
                transform: translateX(400px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        /* Document Requirements */
        .documents-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .document-card {
            background: #111;
            padding: 20px;
            border-radius: 10px;
            border-left: 4px solid #FFD700;
            box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        }

        .document-card h3 {
            color: #FFD700;
            margin-bottom: 15px;
            font-size: 18px;
        }

        .document-card p {
            color: #b0b0b0;
            margin-bottom: 12px;
            font-size: 0.95em;
        }

        .file-type-badge {
            display: inline-block;
            background: #2196F3;
            color: white;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 0.85em;
            margin-bottom: 12px;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 0.9em;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .status-complete {
            background: #4CAF50;
            color: white;
        }

        .status-pending {
            background: #FF9800;
            color: white;
        }

        .status-partial {
            background: #2196F3;
            color: white;
        }

        .upload-section {
            margin-bottom: 15px;
        }

        .upload-input {
            display: none;
        }

        .upload-btn {
            width: 100%;
            padding: 10px;
            background: #4CAF50;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            font-size: 0.9em;
            transition: all 0.3s;
        }

        .upload-btn:hover {
            background: #45a049;
        }

        .uploaded-files {
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid #333;
        }

        .uploaded-files p {
            color: #FFD700;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .file-item {
            background: #222;
            padding: 8px 12px;
            border-radius: 4px;
            margin-bottom: 6px;
            color: #e0e0e0;
            font-size: 0.9em;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .file-actions {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .file-view-btn {
            background: #2196F3;
            color: white;
            border: none;
            padding: 4px 10px;
            border-radius: 3px;
            cursor: pointer;
            font-size: 0.8em;
            transition: all 0.3s;
        }

        .file-view-btn:hover {
            background: #1976D2;
        }

        .file-delete-btn {
            background: #d32f2f;
            color: white;
            border: none;
            padding: 4px 10px;
            border-radius: 3px;
            cursor: pointer;
            font-size: 0.8em;
            transition: all 0.3s;
        }

        .file-delete-btn:hover {
            background: #c62828;
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: #666;
        }

        .empty-state i {
            font-size: 3em;
            margin-bottom: 20px;
            opacity: 0.5;
        }

        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            z-index: 2000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.6);
            animation: fadeIn 0.3s ease-in;
        }

        .modal.show {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: #111;
            padding: 30px;
            border-radius: 10px;
            width: 90%;
            max-width: 400px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        }

        .modal-content h3 {
            color: #FFD700;
            margin-bottom: 15px;
            font-size: 20px;
        }

        .modal-content p {
            color: #e0e0e0;
            margin-bottom: 10px;
            line-height: 1.5;
        }

        .modal-buttons {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .modal-buttons button {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
        }

        .btn-delete-confirm {
            background: #d32f2f;
            color: white;
        }

        .btn-delete-confirm:hover {
            background: #c62828;
        }

        .btn-cancel {
            background: #666;
            color: white;
        }

        .btn-cancel:hover {
            background: #777;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        @media (max-width: 768px) {
            body {
                display: block;
            }

            .sidebar {
                width: 66.67%;
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                transform: translateX(-100%);
                transition: transform 0.3s ease;
                z-index: 2000;
                padding: 20px;
                border-right: 4px solid #FFD700;
                border-bottom: none;
                overflow-y: auto;
            }

            .sidebar.active {
                transform: translateX(0);
                overflow-y: auto;
            }

            .container {
                margin-left: 0;
                width: 100%;
                padding: 10px;
                padding-top: 20px;
                margin-top: 0;
            }

            header {
                position: sticky;
                top: 0;
                left: 0;
                right: 0;
                margin: 0;
                z-index: 1000;
                padding: 10px 12px;
                background: #FFD700;
            }

            header button {
                display: block !important;
                background: rgba(0, 0, 0, 0.2);
                border: 1px solid rgba(0, 0, 0, 0.3);
                color: #000;
                padding: 8px 12px;
                font-size: 1.3em;
                border-radius: 4px;
                cursor: pointer;
                margin-right: 10px;
            }

            .header {
                display: flex;
                flex-direction: column;
                justify-content: flex-start;
                align-items: flex-start;
                gap: 20px;
                padding: 15px;
                margin-bottom: 20px;
            }

            .header > div:first-child {
                display: flex;
                justify-content: flex-start;
                align-items: center;
                gap: 10px;
                width: 100%;
            }

            .header .back-btn {
                padding: 8px 10px;
                font-size: 0.85em;
                white-space: nowrap;
                flex-shrink: 0;
            }

            .header > div:last-child {
                width: 100%;
                text-align: center;
            }

            .header h1 {
                margin: 0 0 8px 0 !important;
                font-size: 1.2em;
            }

            .progress-info {
                flex-direction: column;
                gap: 8px;
                justify-content: center;
            }

            .progress-stat .number {
                font-size: 1.3em;
            }

            .progress-stat .label {
                font-size: 0.8em;
            }

            .documents-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="sidebar" id="sidebar">
        <button class="sidebar-close-btn" onclick="toggleSidebar()"><i class="fas fa-times"></i></button>
        
        <hr style="border: 1px solid #FFD700; margin: 50px 0 15px 0;">
        
        <!-- Sidebar Menu Items -->
        <a href="/my-account" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
            <i class="fas fa-user"></i> <span style="font-weight: bold;">Account Profile</span>
        </a>
        
        <a href="/attendance" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
            <i class="fas fa-camera"></i> <span style="font-weight: bold;">Attendance</span>
        </a>
        
        <% if (user.role === 'officer' || user.role === 'adviser') { %>
        <a href="/admin/students" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
            <i class="fas fa-users"></i> <span style="font-weight: bold;">Master Student List</span>
        </a>
        
        <a href="/fines-management" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
            <i class="fas fa-file-invoice-dollar"></i> <span style="font-weight: bold;">Fines Management</span>
        </a>
        <% } %>
        
        <a href="/my-documents" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
            <i class="fas fa-file-contract"></i> <span style="font-weight: bold;">My Documents</span>
        </a>
        
        <hr style="border: 1px solid #FFD700; margin: 15px 0;">
        
        <form action="/logout" method="POST" style="margin-top: 15px; display: block !important;">
            <button type="submit" class="back-btn" style="width: 100%; padding: 12px; background: #FFD700; color: #121212; border: none; border-radius: 12px; font-weight: bold; cursor: pointer; display: block;">
                <i class="fas fa-sign-out-alt"></i> Logout
            </button>
        </form>
    </div>

    <div id="alertContainer"></div>

    <div class="container">
        <!-- Header with Hamburger Menu -->
        <header>
            <button onclick="toggleSidebar()">
                <i class="fas fa-bars"></i>
            </button>
            <h1 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: #121212;">Marketing Management Portal</h1>
            <div style="width: 40px;"></div>
        </header>

        <!-- Page Header with Back Button and Manage Button -->
        <div class="header" style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 30px;">
            <!-- Top row with Back and Manage buttons -->
            <div style="display: flex; justify-content: flex-start; align-items: center; gap: 20px;">
                <button class="back-btn" onclick="window.location.href='/dashboard'" style="background: transparent; color: #FFD700; border: 2px solid #FFD700; padding: 10px 15px; border-radius: 6px; cursor: pointer; font-weight: bold; transition: all 0.3s; white-space: nowrap;">
                    <i class="fas fa-arrow-left"></i> Back
                </button>
                
                <% if (user.role === 'officer' || user.role === 'adviser') { %>
                <button class="btn" onclick="window.location.href='/manage-documents'" style="background: #FFD700; color: #000; padding: 10px 15px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; transition: all 0.3s; white-space: nowrap;">
                    <i class="fas fa-cog"></i> Manage
                </button>
                <% } %>
            </div>
            
            <!-- Bottom row with title and stats -->
            <div style="text-align: center;">
                <h1 style="margin: 0 0 15px 0;">📄 My Documents</h1>
                <div class="progress-info" style="display: flex; justify-content: center; gap: 30px;">
                    <div class="progress-stat">
                        <div class="number" id="submittedCount">0</div>
                        <div class="label">Submitted</div>
                    </div>
                    <div class="progress-stat">
                        <div class="number" id="pendingCount">0</div>
                        <div class="label">Pending</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Documents Section -->
        <div id="documentsContainer">
            <!-- Loaded via JavaScript -->
        </div>

        <!-- Delete Confirmation Modal -->
        <div id="deleteModal" class="modal">
            <div class="modal-content">
                <h3>Delete Upload?</h3>
                <p>Are you sure you want to delete this document upload?</p>
                <p style="color: #ff9800; font-size: 0.9em;">⚠️ This action cannot be undone.</p>
                <div class="modal-buttons">
                    <button class="btn-delete-confirm" onclick="confirmDelete()">Delete</button>
                    <button class="btn-cancel" onclick="closeDeleteModal()">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // ===== SIMPLE, CLEAN INITIALIZATION =====
        const documentTypes = <%- JSON.stringify(documentTypes) %>;
        let studentDocuments = <%- JSON.stringify(studentDocuments) %>;
        let uploadCounts = {};
        let currentDeleteId = null;

        // Initialize immediately
        console.log('[APP] Initializing my-documents');
        console.log('[APP] documentTypes:', documentTypes);
        console.log('[APP] studentDocuments:', studentDocuments);

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('active');
        }

        function showAlert(msg, type = 'success') {
            const container = document.getElementById('alertContainer');
            const div = document.createElement('div');
            div.className = `alert alert-${type}`;
            div.innerHTML = `<i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'}"></i> ${msg}`;
            container.appendChild(div);
            setTimeout(() => div.remove(), 3000);
        }

        function calculateUploadCounts() {
            uploadCounts = {};
            documentTypes.forEach(doc => {
                uploadCounts[doc._id] = studentDocuments.filter(sd => 
                    String(sd.documentType._id || sd.documentType) === String(doc._id)
                ).length;
            });
        }

        function renderDocuments() {
            const container = document.getElementById('documentsContainer');

            if (!documentTypes || documentTypes.length === 0) {
                container.innerHTML = '<div class="empty-state"><i class="fas fa-file"></i><p>No document requirements</p></div>';
                return;
            }

            let html = '<div class="documents-grid">';
            documentTypes.forEach(doc => {
                const count = uploadCounts[doc._id] || 0;
                const docs = studentDocuments.filter(sd => String(sd.documentType._id || sd.documentType) === String(doc._id));
                const canUpload = count < doc.maxUploads;
                
                let status = 'status-pending', statusText = '⏳ Pending';
                if (count === doc.maxUploads) {
                    status = 'status-complete';
                    statusText = '✓ Complete';
                } else if (count > 0) {
                    status = 'status-partial';
                    statusText = `${count}/${doc.maxUploads}`;
                }

                html += `
                    <div class="document-card">
                        <h3><i class="fas fa-file"></i> ${doc.title}</h3>
                        <span class="file-type-badge">${doc.fileType}</span>
                        <p><strong>Max Uploads:</strong> ${doc.maxUploads}</p>
                        <div class="status-badge ${status}">${statusText}</div>
                        <div class="upload-section">
                            ${canUpload ? `
                                <input type="file" id="file_${doc._id}" class="upload-input">
                                <button class="upload-btn" onclick="uploadDoc('${doc._id}')">
                                    <i class="fas fa-cloud-upload-alt"></i> Upload
                                </button>
                            ` : '<p style="color: #666;">All uploads complete</p>'}
                        </div>
                        ${docs.length > 0 ? `
                            <div class="uploaded-files">
                                <p style="color: #FFD700;">✓ Uploaded:</p>
                                ${docs.map(d => `
                                    <div class="file-item">
                                        <span>${d.fileName || 'Document'}</span>
                                        <div class="file-actions">
                                            <button class="file-view-btn" onclick="viewFile('${d._id}', '${d.fileName || 'Document'}')">
                                                <i class="fas fa-eye"></i> View
                                            </button>
                                            <button class="file-delete-btn" onclick="deleteUpload('${d._id}')">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </div>
                                    </div>
                                `).join('')}
                            </div>
                        ` : ''}
                    </div>
                `;
            });
            html += '</div>';
            container.innerHTML = html;
        }

        function uploadDoc(docId) {
            document.getElementById(`file_${docId}`).click();
            document.getElementById(`file_${docId}`).addEventListener('change', async function() {
                const file = this.files[0];
                if (!file) return;

                const formData = new FormData();
                formData.append('document', file);
                formData.append('documentTypeId', docId);

                try {
                    const res = await fetch('/api/upload-document', { method: 'POST', body: formData });
                    if (res.ok) {
                        const data = await res.json();
                        studentDocuments.push(data.studentDocument);
                        calculateUploadCounts();
                        renderDocuments();
                        updateStats();
                        showAlert('Upload successful!', 'success');
                    } else showAlert('Upload failed', 'error');
                } catch (e) {
                    console.error(e);
                    showAlert('Upload error', 'error');
                }
            });
        }

        function updateStats() {
            const submitted = Object.values(uploadCounts).reduce((a,b) => a+b, 0);
            document.getElementById('submittedCount').textContent = submitted;
            document.getElementById('pendingCount').textContent = documentTypes.length - submitted;
        }

        async function deleteUpload(docId) {
            currentDeleteId = docId;
            openDeleteModal();
        }

        function viewFile(docId, fileName) {
            // Open file in new tab - backend will handle serving the file
            window.open(`/api/download-student-document/${docId}`, '_blank');
        }

        function openDeleteModal() {
            document.getElementById('deleteModal').classList.add('show');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('show');
            currentDeleteId = null;
        }

        async function confirmDelete() {
            if (!currentDeleteId) return;

            try {
                const res = await fetch(`/api/delete-student-document/${currentDeleteId}`, { method: 'DELETE' });
                if (res.ok) {
                    studentDocuments = studentDocuments.filter(d => d._id !== currentDeleteId);
                    calculateUploadCounts();
                    renderDocuments();
                    updateStats();
                    closeDeleteModal();
                    showAlert('Upload deleted successfully', 'success');
                } else {
                    showAlert('Failed to delete upload', 'error');
                }
            } catch (e) {
                console.error('Error deleting upload:', e);
                showAlert('Error deleting upload', 'error');
            }
        }

        // Run on page load
        window.addEventListener('load', () => {
            calculateUploadCounts();
            renderDocuments();
            updateStats();
            console.log('[APP] Page initialized successfully');
        });

        // Also run immediately in case page is already loaded
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            calculateUploadCounts();
            renderDocuments();
         

        // Close modal when clicking outside
        window.addEventListener('click', (event) => {
            const modal = document.getElementById('deleteModal');
            if (event.target === modal) {
                closeDeleteModal();
            }
        });   updateStats();
        }
    </script>

    <script src="/document-notifications.js"></script>
    <script>
        document.documentElement.setAttribute('data-user-role', '<%= user.role %>');
    </script>
</body>
</html>
