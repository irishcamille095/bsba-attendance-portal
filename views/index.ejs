<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="BSBA Portal">
    <meta name="theme-color" content="#FFD700">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/assets/img/logo.jpg">
    <title>BSBA-MM Student Portal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* Index-specific overrides */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: #f4f4f4; }
        
        /* Sidebar Navigation */
        .sidebar { width: 250px; height: 100vh; background: #800000; color: white; padding: 20px; position: fixed; overflow-y: auto; transition: transform 0.3s ease; }
        .sidebar h2 { color: #FFD700; border-bottom: 2px solid #FFD700; padding-bottom: 10px; }
        .sidebar a { display: block; color: white; text-decoration: none; padding: 15px; border-bottom: 1px solid #a00000; font-weight: 500; }
        .sidebar a:hover { color: #FFD700; background: rgba(255, 215, 0, 0.1); }
        
        /* Sidebar Menu Item Hover Styles */
        .sidebar a:hover,
        .sidebar div[onclick]:hover {
            color: #FFD700 !important;
            background: rgba(255, 204, 0, 0.15) !important;
            padding-left: 20px !important;
            transition: all 0.2s ease !important;
        }
        
        .sidebar hr { border: 0.5px solid #555; margin: 10px 0; }
        
        /* Header with hamburger */
        .header-top { display: none; background: #800000; color: white; padding: 12px; position: sticky; top: 0; z-index: 1000; }
        .header-top.mobile-visible { display: flex; align-items: center; justify-content: space-between; }
        .hamburger { background: none; border: none; color: white; font-size: 1.5em; cursor: pointer; padding: 5px; }
        
        /* Sidebar Notification Badge */
        .sidebar-notification-badge {
            display: inline-block;
            background: #ff4444;
            color: white;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            line-height: 20px;
            text-align: center;
            font-size: 0.7em;
            font-weight: bold;
            margin-left: 8px;
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(255, 68, 68, 0.7); }
            50% { box-shadow: 0 0 0 8px rgba(255, 68, 68, 0); }
        }
        
        /* Main Content Area */
        .main { margin-left: 290px; padding: 30px 20px; }
        .header { background: white; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 20px; }
        .header h1 { color: #800000; margin-bottom: 10px; }
        .card { background: white; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 20px; }
        .card h3 { color: #800000; margin-bottom: 15px; }
        .btn-logout { background: #800000; color: white; padding: 10px 15px; border-radius: 5px; text-decoration: none; border: none; cursor: pointer; font-weight: bold; }
        .btn-logout:hover { background: #600000; }
        
        /* Mobile Styles */
        @media (max-width: 768px) {
            .sidebar { width: 66.67%; height: 100vh; position: fixed; top: 0; left: 0; transform: translateX(-100%); border: none; padding: 20px; z-index: 999; }
            .sidebar.active { transform: translateX(0); overflow-y: auto; }
            .sidebar-close-btn { display: none; }
            .sidebar.active .sidebar-close-btn { display: block; }
            .header-top { display: flex; }
            .main { margin-left: 0; padding: 15px 10px; }
            .header { padding: 15px; }
            .header h1 { font-size: 1.3em; }
            .card { padding: 15px; }
        }
        @media (max-width: 480px) {
            .sidebar a { padding: 12px; font-size: 0.95em; }
            .main { padding: 10px 8px; }
            .header { padding: 10px; }
            .card { padding: 12px; }
        }

        /* PWA Install Button */
        .install-btn {
            background: linear-gradient(135deg, #FFD700, #FFC700);
            color: #000;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            font-size: 1em;
            transition: all 0.3s ease;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            display: none;
        }
        
        .install-btn:hover {
            background: linear-gradient(135deg, #FFC700, #FFB700);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
            transform: translateY(-2px);
        }
        
        .install-btn i {
            margin-right: 8px;
        }
    </style>
</head>
<body>
    <div class="header-top mobile-visible" id="headerTop">
        <button class="hamburger" onclick="toggleSidebar()">☰</button>
        <h3 style="margin: 0; flex: 1; text-align: center;">BSBA-MM</h3>
    </div>
    
    <div class="sidebar" id="sidebar">
    <button class="sidebar-close-btn" onclick="toggleSidebar()"><i class="fas fa-times"></i></button>
    
    <hr style="border: 1px solid #FFD700; margin: 50px 0 15px 0;">
    
    <!-- Sidebar Menu Items -->
    <a href="/my-account" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
        <i class="fas fa-user"></i> <span style="font-weight: bold;">Account Profile</span>
    </a>
    
    <a href="/dashboard" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
        <i class="fas fa-camera"></i> <span style="font-weight: bold;">Attendance</span>
    </a>
    
    <% if (user.role === 'officer' || user.role === 'adviser') { %>
    <a href="/admin/students" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
        <i class="fas fa-users"></i> <span style="font-weight: bold;">Master Student List</span>
    </a>
    <% } %>
    
    <% if (user.role === 'officer' || user.role === 'adviser') { %>
    <a href="/fines-management" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
        <i class="fas fa-file-invoice-dollar"></i> <span style="font-weight: bold;">Fines Management</span>
    </a>
    <% } %>
    
    <a href="/my-documents" style="text-decoration: none; color: #e0e0e0; display: flex; align-items: center; gap: 10px; padding: 12px; margin-bottom: 8px; border-radius: 8px; transition: all 0.2s;">
        <i class="fas fa-file-contract"></i> <span style="font-weight: bold;">My Documents</span>
    </a>
    

    

    
    <hr style="border: 1px solid #FFD700; margin: 15px 0;">
    
    <form action="/logout" method="POST" style="margin-top: 15px; display: block !important;">
        <button type="submit" class="back-btn" style="width: 100%; padding: 12px; background: #FFD700; color: #121212; border: none; border-radius: 12px; font-weight: bold; cursor: pointer; display: block;">
            <i class="fas fa-sign-out-alt"></i> Logout
        </button>
    </form>
</div>

    <div class="main">
        <div class="header">
            <a href="/logout" class="btn-logout">Logout</a>
            <h1>Welcome back, <%= user.name %>!</h1>
            <p>Student ID: <b><%= user.id %></b></p>
        </div>

        <div class="card">
            <h3>📢 Latest Announcements</h3>
            <% if (announcements.length > 0) { %>
                <% announcements.forEach(post => { %>
                    <div class="announcement-item">
                        <h4><%= post.title %></h4>
                        <p><%= post.content %></p>
                        <small>Posted on: <%= post.date %></small>
                    </div>
                <% }) %>
            <% } else { %>
                <p>No new announcements for today.</p>
            <% } %>
        </div>
    </div>
    
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('active');
        }
    </script>
    <script src="/pwa-install.js"></script>
    <script src="/document-notifications.js"></script>
    <script>
        document.documentElement.setAttribute('data-user-role', '<%= user.role %>');
    </script>
<%- include('./_footer.ejs') %>

</body>
</html>

<div class="attendance-box" style="text-align: center;">
    <h4>Attendance Portal</h4>

    <% if (qrCodeImage) { %>
        <% if (user.role === 'adviser' || user.role === 'officer') { %>
            <p style="color: green;"><b>Broadcasting: <%= currentSession %></b></p>
            <img src="<%= qrCodeImage %>" style="width: 180px; border: 2px solid #800000;">
            <a href="/close-qr" style="display: block; margin-top: 10px; color: #800000;">Stop Session</a>
        <% } else { %>
            <div style="background: #fff3cd; padding: 15px; border-radius: 8px;">
                <p>🔔 <b><%= currentSession %></b> is now OPEN!</p>
                <a href="/scan" style="background: #800000; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; display: inline-block;">📸 Scan Now</a>
            </div>
        <% } %>

    <% } else { %>
        <% if (user.role === 'adviser' || user.role === 'officer') { %>
            <form action="/generate-event-qr" method="POST">
                <select name="sessionType" style="padding: 8px; width: 100%; margin-bottom: 10px;">
                    <option value="AM IN">Morning - IN</option>
                    <option value="AM OUT">Morning - OUT</option>
                    <option value="PM IN">Afternoon - IN</option>
                    <option value="PM OUT">Afternoon - OUT</option>
                </select>
                <button type="submit" style="background: #800000; color: white; width: 100%; padding: 10px; border: none; cursor: pointer;">Generate Session QR</button>
            </form>
        <% } else { %>
            <p>No active session. Please wait for the Officer.</p>
        <% } %>
    <% } %>
</div>