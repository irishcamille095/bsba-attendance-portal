<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Officer Dashboard</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: #f4f4f4; padding: 15px; }
        .container { max-width: 1000px; margin: 0 auto; }
        h1 { color: #ffcc00; background: #000; padding: 15px; border-radius: 5px; margin-bottom: 15px; }
        h2 { color: #000; margin: 20px 0 15px 0; font-size: 1.3em; border-bottom: 2px solid #ffcc00; padding-bottom: 8px; }
        .info-box { background: #ffcc00; padding: 15px; border-radius: 8px; margin-bottom: 20px; text-align: center; }
        .info-box a { color: #000; text-decoration: none; font-weight: bold; font-size: 1.05em; }
        .info-box a:hover { text-decoration: underline; }
        table { width: 100%; border-collapse: collapse; background: white; margin-bottom: 20px; }
        th, td { padding: 12px; border: 1px solid #ddd; text-align: left; }
        th { background: #ffcc00; color: #000; font-weight: bold; }
        tr:nth-child(even) { background: #f9f9f9; }
        form { display: flex; gap: 10px; flex-wrap: wrap; }
        select, input { padding: 8px; border: 1px solid #ccc; border-radius: 4px; }
        button { padding: 10px 15px; background: #ffcc00; color: #000; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
        button:hover { background: #f3db00; }
        ul { background: white; padding: 15px; border-radius: 8px; margin-bottom: 20px; }
        li { padding: 8px 0; border-bottom: 1px solid #eee; }
        li:last-child { border-bottom: none; }
        .back-link { display: inline-block; margin-bottom: 15px; color: #000; text-decoration: none; font-weight: bold; padding: 8px 12px; background: #ffcc00; border-radius: 4px; }
        .back-link:hover { background: #f3db00; }
        hr { border: 1px solid #ffcc00; margin: 20px 0; }
        @media (max-width: 768px) {
            body { padding: 10px; }
            h1 { font-size: 1.3em; padding: 10px; }
            h2 { font-size: 1.1em; }
            table { 
                font-size: 0.9em;
                display: block;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }
            thead { display: none; }
            tbody { display: block; }
            tr { 
                display: block;
                margin-bottom: 12px;
                border: 1px solid #ddd;
                background: white;
                border-radius: 6px;
                padding: 12px;
            }
            th, td { 
                padding: 8px;
                display: block;
                text-align: right;
                border-bottom: 1px solid #f0f0f0;
                position: relative;
                padding-left: 50%;
            }
            td:before {
                content: attr(data-label);
                position: absolute;
                left: 0;
                font-weight: bold;
                color: #ffcc00;
                width: 48%;
                text-align: left;
            }
            td:last-child { border-bottom: none; }
            tr:nth-child(even) { background: white; }
            form { flex-direction: column; }
            select, input { width: 100%; }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Officer Management Portal</h1>
        
        <div class="info-box">
            <a href="/admin/students">👥 View Master Student List (MM-001 to MM-300)</a>
        </div>

        <h2>Pending Password Resets</h2>
        <% if (requests.length === 0) { %>
            <p style="background: white; padding: 15px; border-radius: 8px;">No pending requests.</p>
        <% } else { %>
            <table>
                <thead>
                    <tr>
                        <th>Student ID</th>
                        <th>Reason</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% requests.forEach(req => { %>
                        <tr>
                            <td data-label="Student ID"><%= req.studentId %></td>
                            <td data-label="Reason"><%= req.reason %></td>
                            <td data-label="Action">
                                <form action="/admin-reset-password" method="POST">
                                    <input type="hidden" name="studentId" value="<%= req.studentId %>">
                                    <button type="submit">Reset to 123456</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>

        <h2>All Registered Students</h2>
        <ul>
            <% allUsers.forEach(user => { %>
                <li><%= user.name %> (ID: <%= user.studentId %>)</li>
            <% }) %>
        </ul>

        <a href="/dashboard" class="back-link">← Back to Main Dashboard</a>
    </div>
</body>
</html>