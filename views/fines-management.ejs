<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#FFD700">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/assets/img/logo.jpg">
    <title>Fines Management - BSBA Portal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body { 
            font-family: 'Segoe UI', sans-serif; 
            background: #121212;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
            padding: 0;
        }
        
        /* Sidebar */
        .sidebar { 
            display: none;
            width: 250px;
            background: #000;
            color: #ffcc00;
            height: 100vh;
            position: fixed;
            padding: 20px;
            border-right: 4px solid #ffcc00;
            overflow-y: auto;
        }

        .sidebar h2 {
            border-bottom: 2px solid #ffcc00;
            padding-bottom: 10px;
            text-align: center;
            margin-bottom: 20px;
        }

        .sidebar h3 {
            color: #ffcc00;
            margin-top: 20px;
            margin-bottom: 10px;
            font-size: 14px;
            text-transform: uppercase;
        }

        .sidebar a {
            color: white;
            padding: 12px;
            display: block;
            text-decoration: none;
            transition: all 0.2s;
        }

        .sidebar a:hover {
            color: #ffcc00;
            background: rgba(255, 204, 0, 0.1);
        }

        .sidebar-notification-badge {
            display: inline-block;
            background: #ff4444;
            color: white;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            line-height: 20px;
            text-align: center;
            font-size: 0.7em;
            font-weight: bold;
            margin-left: 8px;
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(255, 68, 68, 0.7); }
            50% { box-shadow: 0 0 0 8px rgba(255, 68, 68, 0); }
        }

        .logout-btn {
            background: #ffcc00;
            color: #000;
            border: none;
            padding: 12px;
            width: 100%;
            margin-top: 30px;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .logout-btn:hover {
            background: #e6b800;
        }

        /* Mobile Menu Toggle - Hide */
        .mobile-menu-toggle {
            display: none !important;
            position: relative;
            top: auto;
            left: auto;
        }
        
        /* Main Content */
        .content { 
            flex: 1; 
            margin-left: 0; 
            margin-top: 0;
            padding: 30px 30px 30px 30px;
            width: 100%;
            overflow-x: hidden;
            box-sizing: border-box;
        }
        
        /* Header */
        header {
            background: #FFD700;
            color: #000;
            padding: 20px;
            text-align: center;
            border-radius: 8px;
            margin: 0 0 15px 0;
            width: 100%;
        }

        header h1 {
            font-size: 28px;
            margin: 0 0 5px 0;
            color: #000;
            font-weight: bold;
        }

        header p {
            font-size: 14px;
            margin: 0;
        }

        /* Search Bar */
        .search-container {
            display: flex;
            gap: 10px;
            margin: 5px 0 30px 0;
            padding-top: 0;
            align-items: center;
        }

        /* Back Button */
        .back-menu-btn {
            background: #FFD700;
            color: #000;
            padding: 12px 25px;
            border: 2px solid #FFD700;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0;
            margin-left: 0;
            margin-right: 0;
            font-size: 14px;
            height: fit-content;
            line-height: 1;
        }

        .back-menu-btn:hover {
            background: #e6b800;
            border-color: #e6b800;
        }

        @media (max-width: 768px) {
            .back-menu-btn {
                padding: 10px 18px;
                font-size: 13px;
            }
        }

        @media (max-width: 480px) {
            .back-menu-btn {
                padding: 8px 14px;
                font-size: 12px;
            }
        }


        .search-container input {
            flex: 1;
            padding: 10px 12px;
            background: #222;
            color: white;
            border: 2px solid #FFD700;
            border-radius: 5px;
            font-size: 14px;
            height: 44px;
            box-sizing: border-box;
        }

        .search-container input::placeholder {
            color: #888;
        }

        .search-container button {
            background: #FFD700;
            color: #000;
            padding: 0 15px;
            border: 2px solid #FFD700;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 16px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 44px;
            box-sizing: border-box;
        }

        .search-container button:hover {
            background: #e6b800;
        }

        /* Table */
        table {
            width: 100%;
            border-collapse: collapse;
            background: #1a1a1a;
            margin-bottom: 30px;
            border-radius: 8px;
            overflow: hidden;
        }

        table thead {
            background: #800000;
            color: #FFD700;
            text-align: left;
        }

        table th {
            padding: 15px;
            font-weight: bold;
        }

        table td {
            padding: 12px 15px;
            border-bottom: 1px solid #333;
        }

        table tbody tr:hover {
            background: #252525;
        }

        /* Buttons */
        .btn {
            padding: 8px 15px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: bold;
            font-size: 12px;
        }

        .btn-verify {
            background: #4CAF50;
            color: white;
        }

        .btn-verify:hover {
            background: #45a049;
        }

        .btn-reject {
            background: #f44336;
            color: white;
        }

        .btn-reject:hover {
            background: #da190b;
        }

        .btn-records {
            background: #2196F3;
            color: white;
            padding: 6px 12px;
            font-size: 11px;
        }

        .btn-records:hover {
            background: #0b7dda;
        }

        /* Status Badge */
        .status-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: bold;
        }

        .status-pending {
            background: #ff9800;
            color: white;
        }

        .status-verified {
            background: #4CAF50;
            color: white;
        }

        .status-rejected {
            background: #f44336;
            color: white;
        }

        /* Remaining Balance - Red if greater than 0 */
        .balance-red {
            color: #e74c3c;
            font-weight: bold;
        }

        /* Initial Fine Column - Clickable */
        .initial-fine-display {
            color: #FFD700;
            cursor: pointer;
            font-weight: bold;
            padding: 4px 8px;
            border-radius: 4px;
            transition: all 0.2s ease;
            display: inline-block;
        }

        .initial-fine-display:hover {
            background: rgba(255, 215, 0, 0.2);
            text-decoration: underline;
        }

        .initial-cell,
        .verified-cell,
        .total-fine-cell,
        .pending-payment-cell {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .initial-edit-btn,
        .history-btn-cell,
        .override-btn,
        .verify-btn-cell {
            padding: 8px 10px;
            font-size: 12px;
            width: auto;
            min-width: 0;
        }

        /* Button styling */
        .btn-records {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: auto;
            text-align: center;
            background: #FFD700;
            color: #000;
            border: none;
            padding: 8px 10px;
            margin: 2px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
            font-weight: bold;
            transition: all 0.2s ease;
        }

        .btn-records:hover {
            background: #e6b800;
            transform: translateY(-2px);
            box-shadow: 0 2px 8px rgba(255, 215, 0, 0.3);
        }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.8);
        }

        .modal-content {
            background-color: #1a1a1a;
            margin: 10% auto;
            padding: 30px;
            border: 2px solid #FFD700;
            border-radius: 8px;
            width: 90%;
            max-width: 400px;
            color: white;
        }

        .modal-header {
            color: #FFD700;
            margin-bottom: 20px;
        }

        .modal-body {
            margin-bottom: 20px;
        }

        .modal-body textarea {
            width: 100%;
            padding: 10px;
            background: #222;
            color: white;
            border: 1px solid #444;
            border-radius: 4px;
            font-family: inherit;
            resize: vertical;
            min-height: 80px;
        }

        .modal-footer {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
        }

        .close {
            color: #FFD700;
            float: right;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
        }

        .close:hover {
            color: #e6b800;
        }

        /* No Payment Message */
        .no-payment {
            background: #222;
            color: #FFD700;
            padding: 20px;
            border-radius: 5px;
            text-align: center;
        }

        /* Stats Section */
        .stats-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-box {
            background: #222;
            padding: 20px;
            border-left: 4px solid #FFD700;
            border-radius: 5px;
        }

        .stat-box h3 {
            color: #FFD700;
            margin-bottom: 10px;
            font-size: 12px;
        }

        .stat-box p {
            color: white;
            font-size: 24px;
            font-weight: bold;
        }

        /* Table Wrapper for Overflow */
        .table-wrapper {
            overflow-x: auto;
            border-radius: 8px;
            margin-bottom: 30px;
        }

        /* Tab Navigation */
        .tab-navigation {
            display: flex;
            gap: 10px;
            margin-bottom: 30px;
            border-bottom: 3px solid #FFD700;
            flex-wrap: wrap;
        }

        .tab-button {
            background: #222;
            color: #FFD700;
            border: 2px solid #FFD700;
            padding: 12px 20px;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 4px 4px 0 0;
            transition: all 0.3s ease;
        }

        .tab-button:hover {
            background: #333;
            transform: translateY(-2px);
        }

        .tab-button.active {
            background: #FFD700;
            color: #000;
            border-color: #FFD700;
        }

        /* Year Level Tables - Hidden by default */
        .year-level-section {
            display: none;
        }

        .year-level-section.active {
            display: block;
        }

        /* Mobile Responsive Styles */
        @media (max-width: 1024px) {
            .sidebar {
                width: 200px;
                padding: 15px;
            }
            
            .content {
                margin-left: 220px;
                padding: 20px;
            }

            header h1 {
                font-size: 22px;
            }

            table th, table td {
                padding: 10px;
                font-size: 13px;
            }
        }

        @media (max-width: 768px) {
            .mobile-menu-toggle {
                display: block;
            }

            .sidebar {
                transform: translateX(-100%);
                transition: transform 0.3s ease;
                z-index: 1000;
                width: 250px;
                left: 0;
            }

            .sidebar.active {
                transform: translateX(0);
            }

            .content {
                margin-left: 0;
                padding: 20px 15px;
            }

            header {
                padding: 15px;
                margin-bottom: 20px;
            }

            header h1 {
                font-size: 20px;
                margin-bottom: 3px;
            }

            header p {
                font-size: 12px;
            }

            .search-container {
                flex-direction: row;
                gap: 8px;
                margin-bottom: 20px;
            }

            .search-container input {
                padding: 10px;
                font-size: 13px;
                flex: 1;
            }

            .search-container button {
                padding: 10px 12px;
                font-size: 13px;
                flex-shrink: 0;
            }

            .stats-section {
                grid-template-columns: 1fr;
                gap: 12px;
                margin-bottom: 20px;
            }

            .stat-box {
                padding: 15px;
            }

            .stat-box h3 {
                font-size: 11px;
            }

            .stat-box p {
                font-size: 20px;
            }

            table {
                font-size: 12px;
                margin-bottom: 20px;
            }

            table th, table td {
                padding: 8px 10px;
            }

            table th {
                padding: 10px 8px;
            }

            .btn {
                padding: 6px 10px;
                font-size: 11px;
            }

            .btn-records {
                padding: 5px 8px;
                font-size: 10px;
            }

            .status-badge {
                font-size: 10px;
                padding: 4px 8px;
            }

            /* Tab Navigation on Tablets */
            .tab-navigation {
                gap: 5px;
                margin-bottom: 20px;
            }

            .tab-button {
                padding: 10px 15px;
                font-size: 12px;
            }
        }

        @media (max-width: 768px) {
            /* Hide Attendance Fines column on tablets and below - use Total Fines for clarity */
            table th:nth-child(4),
            table td:nth-child(4) {
                display: none;
            }
        }

        @media (max-width: 480px) {
            .mobile-menu-toggle {
                padding: 10px 12px;
                font-size: 16px;
                top: 15px;
                left: 15px;
            }

            .content {
                padding: 15px 10px;
            }

            header {
                padding: 12px;
                margin-bottom: 15px;
            }

            header h1 {
                font-size: 18px;
            }

            .search-container button {
                padding: 8px 15px;
            }

            table {
                font-size: 10px;
            }

            table th, table td {
                padding: 5px 6px;
            }

            /* Hide Attendance Fines on phones - keep Remaining Balance visible */
            table th:nth-child(4),
            table td:nth-child(4) {
                display: none;
            }

            /* Compact action buttons for small screens */
            .btn, .btn-records {
                padding: 4px 6px;
                font-size: 9px;
                margin: 1px;
            }

            .initial-fine-display {
                padding: 2px 4px;
                font-size: 11px;
            }

            .no-payment {
                padding: 15px;
            }

            /* Tab Navigation on Mobile */
            .tab-navigation {
                gap: 3px;
                margin-bottom: 15px;
                overflow-x: auto;
                padding-bottom: 5px;
            }

            .tab-button {
                padding: 8px 12px;
                font-size: 11px;
                white-space: nowrap;
                flex-shrink: 0;
            }
        }
    </style>
</head>
<body>
    <!-- Mobile Menu Toggle -->
    <button class="mobile-menu-toggle" id="menuToggle">☰ Menu</button>

    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <button style="background: none; border: none; color: #ffcc00; font-size: 24px; cursor: pointer; display: block; margin-left: auto; margin-bottom: 15px;" onclick="closeMobileMenu()">✕</button>
        <h2>BSBA Portal</h2>
        
        <% if (user.role === 'student') { %>
            <h3>Account</h3>
            <a href="/dashboard"><i class="fas fa-home"></i> Dashboard</a>
            <a href="/attendance"><i class="fas fa-calendar"></i> Attendance</a>
            <a href="/wallet"><i class="fas fa-wallet"></i> Wallet & Fines</a>
            <a href="/my-account"><i class="fas fa-user"></i> My Account</a>
        <% } else if (user.role === 'adviser') { %>
            <h3>Class Management</h3>
            <a href="/dashboard"><i class="fas fa-home"></i> Dashboard</a>
            <a href="/folder-details"><i class="fas fa-folder"></i> Classes</a>
            <a href="/attendance"><i class="fas fa-calendar"></i> Attendance</a>
            <a href="/my-account"><i class="fas fa-user"></i> My Account</a>

            <h3>Finance</h3>
            <a href="/fines-management"><i class="fas fa-coins"></i> Fines Management</a>
        <% } else if (user.role === 'officer') { %>
            <h3>Dashboard</h3>
            <a href="/officer-dashboard"><i class="fas fa-home"></i> Dashboard</a>
            <a href="/master-student-list"><i class="fas fa-users"></i> Student List</a>
            
            <h3>Reports</h3>
            <a href="/report"><i class="fas fa-chart-bar"></i> Attendance Report</a>

            <h3>Finance</h3>
            <a href="/fines-management"><i class="fas fa-coins"></i> Fines Management</a>

            <h3>Account</h3>
            <a href="/my-account"><i class="fas fa-user"></i> My Account</a>
        <% } %>

        <form action="/logout" method="POST">
            <button class="logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</button>
        </form>
    </div>

    <!-- Main Content -->
    <div class="content">
        <header>
            <h1>💰 Fines Management</h1>
        </header>

        <!-- Back to Menu Button and History Button -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; gap: 10px; margin-top: 50px;">
            <button class="back-menu-btn" onclick="window.location.href='/dashboard'">← Back to Menu</button>
            <button class="history-btn" onclick="openHistoryModal()" title="View Audit History" style="background: transparent; border: 2px solid #FFD700; color: #FFD700; padding: 12px 15px; border-radius: 5px; cursor: pointer; font-size: 1.1em; transition: all 0.3s; height: fit-content; display: flex; align-items: center;">
                <i class="fas fa-history"></i>
            </button>
        </div>

        <!-- Search Bar -->
        <div class="search-container">
            <input type="text" id="searchInput" placeholder="Search by MM-ID or Student Name...">
            <button onclick="filterTable()" title="Search"><i class="fas fa-search"></i></button>
        </div>

        <!-- Stats -->
        <% 
            let totalPending = 0;
            let totalOutstanding = 0;
            students.forEach(s => {
                totalPending += s.pendingPayments.length;
                totalOutstanding += s.remainingBalance;
            });
        %>
        <div class="stats-section">
            <div class="stat-box">
                <h3>Total Students</h3>
                <p id="totalStudents"><%= students.length %></p>
            </div>
            <div class="stat-box">
                <h3>Pending Payments</h3>
                <p id="pendingPayments"><%= totalPending %></p>
            </div>
            <div class="stat-box">
                <h3>Total Outstanding</h3>
                <p>₱<%= totalOutstanding.toFixed(2) %></p>
            </div>
        </div>

        <!-- Tab Navigation -->
        <div class="tab-navigation">
            <button class="tab-button active" onclick="switchTab(1)">1st Year</button>
            <button class="tab-button" onclick="switchTab(2)">2nd Year</button>
            <button class="tab-button" onclick="switchTab(3)">3rd Year</button>
            <button class="tab-button" onclick="switchTab(4)">4th Year</button>
        </div>

        <!-- Student Tables by Year Level (Sheet-like) -->
        <% for (let year = 1; year <= 4; year++) { %>
            <% const yearStudents = students.filter(s => {
                const y = typeof s.yearLevel === 'number' ? s.yearLevel : parseInt(s.yearLevel);
                return y === year;
            }); %>
            <div class="year-level-section <%= year === 1 ? 'active' : '' %>" data-year="<%= year %>">
                <% if (yearStudents.length > 0) { %>
                    <div class="table-wrapper">
                    <table class="studentTable" data-year="<%= year %>">
                        <thead>
                            <tr>
                                <th>MM-ID</th>
                                <th>Name</th>
                                <th>Initial Fine</th>
                                <th>Attendance Fines</th>
                                <th>Total Fines</th>
                                <th>Requests to Verify</th>
                                <th>Verified Payments</th>
                                <th>Remaining Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% yearStudents.forEach(student => { %>
                                <tr data-student="<%= student.mmId %>" data-name="<%= student.name %>">
                                    <td><strong><%= student.mmId %></strong></td>
                                    <td><%= student.name %></td>
                                    <td>
                                        <div class="initial-cell">
                                            <div class="initial-fine-display">₱<%= student.initialFine.toFixed(2) %></div>
                                            <button class="btn btn-records initial-edit-btn" title="Edit Initial Fine" data-student-id="<%= student.mmId %>" data-student-name="<%= student.name %>" data-initial-fine="<%= student.initialFine %>" onclick="openEditInitialFineModal(this)">Initial</button>
                                        </div>
                                    </td>
                                    <td>₱<%= student.attendanceFines.toFixed(2) %></td>
                                    <td>
                                        <div class="total-fine-cell">
                                            <strong>₱<%= student.totalFines.toFixed(2) %></strong>
                                            <button class="btn btn-records override-btn" title="Override Fines" data-student-id="<%= student.mmId %>" data-student-name="<%= student.name %>" onclick="openOverrideModal(this)">Override</button>
                                        </div>
                                    </td>
                                    <td>
                                        <% if (student.pendingAmount > 0) { %>
                                            <div class="pending-payment-cell">
                                                <span style="color: #FF9800; font-weight: 600;">₱<%= student.pendingAmount.toFixed(2) %></span>
                                                <button class="btn btn-records verify-btn-cell" title="Verify Payment Request" data-student-id="<%= student.mmId %>" onclick="openPaymentRequestModal(this)">Verify</button>
                                                <script type="application/json" id="pending-payments-<%= student.mmId %>"><%- JSON.stringify(student.pendingPayments) %></script>
                                            </div>
                                        <% } else { %>
                                            No Request
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="verified-cell">
                                            <span style="color: #4CAF50; font-weight: bold;"><% if (student.verifiedAmount > 0) { %>₱<%= student.verifiedAmount.toFixed(2) %><% } else { %>₱0.00<% } %></span>
                                            <button class="btn btn-records history-btn-cell" title="View Payment History" data-student-id="<%= student.mmId %>" onclick="viewPaymentRecords(this)">History</button>
                                        </div>
                                    </td>
                                    <td><% if (student.remainingBalance > 0) { %><span class="balance-red">₱<%= student.remainingBalance.toFixed(2) %></span><% } else { %>₱<%= student.remainingBalance.toFixed(2) %><% } %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                    </div>
                <% } else { %>
                    <div class="no-payment">
                        <p>No students found for this year level.</p>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>

    <!-- Rejection Reason Modal -->
    <div id="rejectModal" class="modal" style="z-index: 2000;">
        <div class="modal-content">
            <span class="close" onclick="closeRejectModal()">&times;</span>
            <div class="modal-header">
                <h2>Reject Payment</h2>
            </div>
            <div class="modal-body">
                <p>Payment ID: <strong id="rejectPaymentId"></strong></p>
                <p style="margin-top: 10px; font-size: 13px;">Enter rejection reason (optional):</p>
                <textarea id="rejectReason" placeholder="Enter reason for rejection..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-reject" onclick="submitRejection()">Reject</button>
                <button type="button" class="btn" style="background: #444; color: white;" onclick="closeRejectModal()">Cancel</button>
            </div>
        </div>
    </div>

    <!-- Payment Request Modal -->
    <div id="paymentRequestModal" class="modal" style="z-index: 1500;">
        <div class="modal-content">
            <span class="close" onclick="closePaymentRequestModal()">&times;</span>
            <div class="modal-header">
                <h2>Payment Request Review</h2>
            </div>
            <div class="modal-body">
                <p>Student: <strong id="paymentRequestStudentName"></strong></p>
                <p>MM-ID: <strong id="paymentRequestStudentId"></strong></p>
                <div id="paymentRequestList" style="margin-top: 20px; display: flex; flex-direction: column; gap: 15px;"></div>
                <p id="noPendingMessage" style="color: #999; display: none;">No pending payment requests found.</p>
            </div>
            <div class="modal-footer">
                <button class="btn" style="background: #444; color: white;" onclick="closePaymentRequestModal()">Close</button>
            </div>
        </div>
    </div>

    <!-- Edit Initial Fine Modal -->
    <div id="editInitialFineModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeEditInitialFineModal()">&times;</span>
            <div class="modal-header">
                <h2>Edit Initial Fine</h2>
            </div>
            <div class="modal-body">
                <p>Student: <strong id="studentNameDisplay"></strong></p>
                <p>MM-ID: <strong id="studentIdDisplay"></strong></p>
                <p style="margin-top: 15px; font-size: 13px;">Initial Fine Amount (PHP):</p>
                <input type="number" id="initialFineAmount" placeholder="Enter amount" min="0" step="0.01" style="width: 100%; padding: 10px; background: #222; color: #FFD700; border: 1px solid #FFD700; border-radius: 4px; margin-bottom: 10px;">
                <p style="margin-top: 10px; font-size: 13px;">Notes (optional):</p>
                <textarea id="initialFineNotes" placeholder="Enter notes about this fine..." style="width: 100%; padding: 10px; background: #222; color: white; border: 1px solid #FFD700; border-radius: 4px; height: 80px;"></textarea>
            </div>
            <div class="modal-footer">
                <button class="btn btn-reject" onclick="submitInitialFine()" style="background: #FFD700; color: #000;">Save Fine</button>
                <button class="btn" style="background: #444; color: white;" onclick="closeEditInitialFineModal()">Cancel</button>
            </div>
        </div>
    </div>

    <!-- Success Modal -->
    <div id="successModal" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: #1a1a1a; border: 2px solid #4CAF50; border-radius: 8px; padding: 30px; text-align: center; z-index: 3000; box-shadow: 0 0 20px rgba(0,0,0,0.5); min-width: 250px;">
        <div style="display: flex; align-items: center; justify-content: center; gap: 10px; color: #4CAF50;">
            <i class="fas fa-check-circle" style="font-size: 2em;"></i>
            <p id="successMessage" style="margin: 0; font-size: 1.1em; font-weight: bold;">Success!</p>
        </div>
    </div>

    <!-- Override Fines Modal -->
    <div id="overrideModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeOverrideModal()">&times;</span>
            <div class="modal-header">
                <h2>Override Fines</h2>
            </div>
            <div class="modal-body" id="overrideModalBody">
                <p>Student: <strong id="overrideStudentName"></strong></p>
                <p style="margin-top: 15px; font-size: 13px; color: #FFD700;"><strong>⚠️ Warning:</strong> This action will reset all fines (Initial Fine + Attendance Fines) to ZERO for this student.</p>
                <p style="margin-top: 15px; font-size: 13px;">Enter Override Password (6 characters):</p>
                <input type="password" id="overridePassword" placeholder="Enter override password" maxlength="6" style="width: 100%; padding: 10px; background: #222; color: white; border: 1px solid #FFD700; border-radius: 4px; margin-bottom: 10px; font-size: 16px; letter-spacing: 2px;" onkeypress="handleOverridePasswordKeypress(event)">
            </div>
            <div class="modal-footer">
                <button class="btn btn-reject" onclick="submitOverride()" style="background: #FFD700; color: #000;">Submit</button>
                <button class="btn" style="background: #444; color: white;" onclick="closeOverrideModal()">Cancel</button>
            </div>
        </div>
    </div>

    <!-- History/Audit Log Modal -->
    <div id="historyModal" class="modal" style="display: none; z-index: 2000;">
        <div class="modal-content" style="width: 75%; height: 85vh; display: flex; flex-direction: column; max-width: 90vw;" id="historyModalContent">
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 20px; border-bottom: 2px solid #FFD700;">
                <h2 style="color: #FFD700; margin: 0; font-size: 1.5em;">📋 Audit History</h2>
                <span class="close" onclick="closeHistoryModal()" style="font-size: 2em; cursor: pointer; color: #FFD700;">&times;</span>
            </div>

            <!-- Filter Tabs -->
            <div style="display: flex; flex-wrap: wrap; gap: 8px; padding: 12px; background: #1a1a1a; border-bottom: 1px solid #333; justify-content: flex-start;">
                <button class="history-tab active" onclick="filterHistoryTab('all')" style="padding: 6px 12px; background: #FFD700; color: #000; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; transition: all 0.3s; font-size: 0.9em;">All</button>
                <button class="history-tab" onclick="filterHistoryTab('verify_payment')" style="padding: 6px 12px; background: transparent; color: #FFD700; border: 1px solid #FFD700; border-radius: 4px; cursor: pointer; font-weight: bold; transition: all 0.3s; font-size: 0.9em;">Verifications</button>
                <button class="history-tab" onclick="filterHistoryTab('initial_fine')" style="padding: 6px 12px; background: transparent; color: #FFD700; border: 1px solid #FFD700; border-radius: 4px; cursor: pointer; font-weight: bold; transition: all 0.3s; font-size: 0.9em; white-space: nowrap;">Fine Changes</button>
                <button class="history-tab" onclick="filterHistoryTab('override_fines')" style="padding: 6px 12px; background: transparent; color: #FFD700; border: 1px solid #FFD700; border-radius: 4px; cursor: pointer; font-weight: bold; transition: all 0.3s; font-size: 0.9em;">Overrides</button>
            </div>

            <!-- History Entries -->
            <div id="historyContainer" style="flex: 1; overflow-y: auto; padding: 20px; background: #121212;">
                <div id="historyList" style="display: flex; flex-direction: column; gap: 15px;">
                    <!-- Entries loaded here -->
                </div>
            </div>

            <!-- Load More Button -->
            <div style="padding: 15px; text-align: center; border-top: 1px solid #333;">
                <button id="loadMoreBtn" onclick="loadMoreHistory()" style="background: #FFD700; color: #000; border: none; padding: 10px 20px; border-radius: 4px; cursor: pointer; font-weight: bold; transition: all 0.3s; display: none;">Load More</button>
                <p id="loadingIndicator" style="color: #FFD700; display: none; margin: 0;">Loading...</p>
            </div>
        </div>
    </div>

    <script>
        let currentActiveYear = 1;

        function switchTab(year) {
            // Hide all year level sections
            document.querySelectorAll('.year-level-section').forEach(section => {
                section.classList.remove('active');
            });

            // Show the selected year level section
            document.querySelector(`.year-level-section[data-year="${year}"]`).classList.add('active');

            // Update tab button styles
            document.querySelectorAll('.tab-button').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');

            currentActiveYear = year;

            // Clear search when switching tabs
            document.getElementById('searchInput').value = '';
        }

        function filterTable() {
            const input = document.getElementById('searchInput').value.toUpperCase();
            const tables = document.querySelectorAll('.studentTable tbody');
            let totalMatches = 0;
            
            tables.forEach(tbody => {
                const rows = tbody.getElementsByTagName('tr');
                for (let i = 0; i < rows.length; i++) {
                    const studentId = rows[i].getAttribute('data-student') || '';
                    const studentName = rows[i].getAttribute('data-name') || '';
                    
                    if (studentId.toUpperCase().includes(input) || studentName.toUpperCase().includes(input)) {
                        rows[i].style.display = '';
                        totalMatches++;
                    } else {
                        rows[i].style.display = 'none';
                    }
                }
            });
        }

        function viewPaymentRecords(element) {
            const studentId = element.getAttribute('data-student-id');
            window.location.href = `/payment-records/${studentId}`;
        }

        function openPaymentRequestModal(button) {
            const studentId = button.getAttribute('data-student-id');
            const pendingData = document.getElementById(`pending-payments-${studentId}`);
            const pendingPayments = pendingData ? JSON.parse(pendingData.textContent || '[]') : [];

            document.getElementById('paymentRequestStudentId').innerText = studentId;
            document.getElementById('paymentRequestStudentName').innerText = button.closest('tr').getAttribute('data-name');

            const listContainer = document.getElementById('paymentRequestList');
            listContainer.innerHTML = '';

            if (pendingPayments.length === 0) {
                document.getElementById('noPendingMessage').style.display = 'block';
            } else {
                document.getElementById('noPendingMessage').style.display = 'none';
                pendingPayments.forEach(payment => {
                    const entry = document.createElement('div');
                    entry.style.cssText = 'background: #1a1a1a; border: 1px solid #444; border-radius: 8px; padding: 15px; display: flex; flex-direction: column; gap: 10px;';
                    const submittedAt = payment.submittedAt ? new Date(payment.submittedAt).toLocaleString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Unknown date';
                    entry.innerHTML = `
                        <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                            <div>
                                <p style="margin: 0; font-weight: bold; color: #FFD700;">₱${payment.amount.toFixed(2)}</p>
                                <p style="margin: 4px 0 0; color: #ccc; font-size: 0.95em;">Type: ${payment.paymentMethod === 'service' ? 'Service' : 'Cash'}</p>
                                <p style="margin: 4px 0 0; color: #ccc; font-size: 0.95em;">Description: ${payment.description || 'No description provided'}</p>
                                <p style="margin: 4px 0 0; color: #999; font-size: 0.85em;">Submitted: ${submittedAt}</p>
                            </div>
                            <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center; justify-content: flex-end;">
                                <button class="btn btn-records" style="background: #4CAF50; color: #000;" onclick="verifyPendingPayment('${payment._id}')">Verify</button>
                                <button class="btn btn-records" style="background: #ff4444; color: white;" onclick="openRejectModal('${payment._id}')">Reject</button>
                            </div>
                        </div>
                    `;
                    listContainer.appendChild(entry);
                });
            }

            document.getElementById('paymentRequestModal').style.display = 'block';
        }

        function closePaymentRequestModal() {
            document.getElementById('paymentRequestModal').style.display = 'none';
        }

        function verifyPendingPayment(paymentId) {
            fetch(`/verify-payment/${paymentId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    closePaymentRequestModal();
                    showSuccessMessage('Payment verified successfully');
                    setTimeout(() => {
                        document.getElementById('successModal').style.display = 'none';
                        location.reload();
                    }, 1400);
                } else {
                    showErrorMessage('Error verifying payment: ' + (data.message || 'Unknown error'));
                }
            })
            .catch(err => {
                console.error('Error verifying payment:', err);
                showErrorMessage('Error verifying payment');
            });
        }

        function showSuccessMessage(message) {
            const modal = document.getElementById('successModal');
            const messageEl = document.getElementById('successMessage');
            if (messageEl) {
                messageEl.textContent = message;
            }
            modal.style.display = 'flex';
        }

        function showErrorMessage(message) {
            const modal = document.getElementById('successModal');
            const messageEl = document.getElementById('successMessage');
            if (messageEl) {
                messageEl.textContent = message;
            }
            modal.style.borderColor = '#ff4444';
            modal.style.display = 'flex';
            setTimeout(() => {
                modal.style.display = 'none';
                modal.style.borderColor = '#4CAF50';
            }, 1800);
        }

        function openRejectModal(paymentId) {
            document.getElementById('paymentRequestModal').style.display = 'none';
            document.getElementById('rejectModal').style.display = 'flex';
            document.getElementById('rejectPaymentId').innerText = paymentId;
            document.getElementById('rejectReason').value = '';
            document.getElementById('rejectReason').focus();
        }

        function closeRejectModal() {
            document.getElementById('rejectModal').style.display = 'none';
            document.getElementById('paymentRequestModal').style.display = 'block';
        }

        function submitRejection() {
            const paymentId = document.getElementById('rejectPaymentId').innerText;
            const reason = document.getElementById('rejectReason').value;
            const rejectButton = document.querySelector('#rejectModal .btn.btn-reject');

            rejectButton.disabled = true;
            rejectButton.textContent = 'Rejecting...';

            fetch(`/reject-payment/${paymentId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ rejectionReason: reason })
            })
            .then(response => response.json())
            .then(data => {
                rejectButton.disabled = false;
                rejectButton.textContent = 'Reject';
                if (data.success) {
                    // Close all modals
                    document.getElementById('rejectModal').style.display = 'none';
                    document.getElementById('paymentRequestModal').style.display = 'none';
                    
                    // Show success message
                    showSuccessMessage('Payment rejected successfully');
                    
                    // Reload page after success modal timeout
                    setTimeout(() => {
                        document.getElementById('successModal').style.display = 'none';
                        location.reload();
                    }, 1400);
                } else {
                    alert('Error rejecting payment: ' + (data.message || 'Unknown error'));
                }
            })
            .catch(err => {
                rejectButton.disabled = false;
                rejectButton.textContent = 'Reject';
                console.error('Error:', err);
                alert('Error rejecting payment');
            });
        }

        // Override Modal Functions
        let currentOverrideStudentId = null;
        let currentOverridePassword = null;

        function openOverrideModal(element) {
            const studentId = element.getAttribute('data-student-id');
            const studentName = element.getAttribute('data-student-name');
            
            currentOverrideStudentId = studentId;
            document.getElementById('overrideStudentName').innerText = studentName;
            document.getElementById('overridePassword').value = '';
            document.getElementById('overrideModal').style.display = 'block';
            
            // Focus on password input
            setTimeout(() => document.getElementById('overridePassword').focus(), 100);
        }

        function closeOverrideModal() {
            document.getElementById('overrideModal').style.display = 'none';
            document.getElementById('overridePassword').value = '';
            currentOverrideStudentId = null;
        }

        // History Modal Functions
        let currentHistoryFilter = 'all';
        let historyPage = 1;

        function openHistoryModal() {
            document.getElementById('historyModal').style.display = 'flex';
            historyPage = 1;
            currentHistoryFilter = 'all';
            loadHistory();
            
            // Update tab styles
            document.querySelectorAll('.history-tab').forEach(tab => {
                tab.style.background = 'transparent';
                tab.style.color = '#FFD700';
                tab.style.border = '1px solid #FFD700';
            });
            document.querySelector('.history-tab.active').style.background = '#FFD700';
            document.querySelector('.history-tab.active').style.color = '#000';
            document.querySelector('.history-tab.active').style.border = 'none';
        }

        function closeHistoryModal() {
            document.getElementById('historyModal').style.display = 'none';
        }

        function filterHistoryTab(filterType) {
            currentHistoryFilter = filterType;
            historyPage = 1;

            // Update active tab styling
            document.querySelectorAll('.history-tab').forEach(tab => {
                tab.style.background = 'transparent';
                tab.style.color = '#FFD700';
                tab.style.border = '1px solid #FFD700';
            });
            event.target.style.background = '#FFD700';
            event.target.style.color = '#000';
            event.target.style.border = 'none';
            event.target.classList.add('active');

            loadHistory();
        }

        function loadHistory() {
            const container = document.getElementById('historyList');
            const loadMoreBtn = document.getElementById('loadMoreBtn');
            const loadingIndicator = document.getElementById('loadingIndicator');

            if (historyPage === 1) {
                container.innerHTML = '';
                loadMoreBtn.style.display = 'none';
            }

            const filterParam = currentHistoryFilter === 'all' ? 'all' : currentHistoryFilter;
            
            fetch(`/api/audit-logs?page=${historyPage}&type=${filterParam}`)
                .then(response => response.json())
                .then(data => {
                    loadingIndicator.style.display = 'none';

                    if (data.success && data.logs.length > 0) {
                        data.logs.forEach(log => {
                            const entry = createHistoryEntry(log);
                            container.appendChild(entry);
                        });

                        loadMoreBtn.style.display = data.hasMore ? 'block' : 'none';
                    } else if (historyPage === 1) {
                        container.innerHTML = '<p style="color: #999; text-align: center; padding: 20px;">No records found</p>';
                        loadMoreBtn.style.display = 'none';
                    } else if (historyPage > 1 && data.logs.length === 0) {
                        loadMoreBtn.style.display = 'none';
                        const noMoreMsg = document.createElement('p');
                        noMoreMsg.style.cssText = 'color: #999; text-align: center; padding: 20px; margin: 0;';
                        noMoreMsg.textContent = 'No more records to load';
                        container.appendChild(noMoreMsg);
                    }
                })
                .catch(err => {
                    console.error('Error loading history:', err);
                    loadingIndicator.style.display = 'none';
                    if (historyPage === 1) {
                        container.innerHTML = '<p style="color: #ff6b6b; text-align: center; padding: 20px;">Error loading history</p>';
                    }
                });
        }

        function createHistoryEntry(log) {
            const entry = document.createElement('div');
            entry.style.cssText = 'background: #1e1e1e; border-left: 4px solid #FFD700; padding: 15px; border-radius: 6px; color: #e0e0e0;';

            const timestamp = new Date(log.timestamp).toLocaleString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            });

            let actionDetail = '';
            let actionIcon = '';

            if (log.actionType === 'override_fines') {
                actionIcon = '🔓';
                const oldFine = log.details?.oldInitialFine || 0;
                actionDetail = `Reset fines from ₱${oldFine.toFixed(2)} to ₱0.00`;
            } else if (log.actionType === 'verify_payment') {
                actionIcon = '✓';
                const amount = log.details?.amount || 0;
                actionDetail = `Verified payment of ₱${amount.toFixed(2)}`;
            } else if (log.actionType === 'undo_verify_payment') {
                actionIcon = '↩️';
                const amount = log.details?.amount || 0;
                actionDetail = `Reverted verified payment of ₱${amount.toFixed(2)} back to pending`;
            } else if (log.actionType === 'initial_fine') {
                actionIcon = '✏️';
                const oldFine = log.details?.oldAmount || 0;
                const newFine = log.details?.newAmount || 0;
                actionDetail = `Changed initial fine from ₱${oldFine.toFixed(2)} to ₱${newFine.toFixed(2)}`;
            }

            entry.innerHTML = `
                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 10px;">
                    <div>
                        <p style="margin: 0 0 5px 0; color: #FFD700; font-weight: bold;">
                            ${actionIcon} ${log.actionType === 'override_fines' ? 'Fines Override' : log.actionType === 'initial_fine' ? 'Initial Fine Change' : log.actionType === 'undo_verify_payment' ? 'Undo Verification' : 'Payment Verification'}
                        </p>
                        <p style="margin: 0 0 3px 0; color: #999; font-size: 0.9em;">
                            <strong>Officer/Adviser:</strong> ${log.performedByName} (${log.performedByRole})
                        </p>
                        <p style="margin: 0 0 3px 0; color: #999; font-size: 0.9em;">
                            <strong>Student:</strong> ${log.studentName} (${log.studentId})
                        </p>
                        <p style="margin: 0; color: #FFD700; font-weight: bold;">
                            ${actionDetail}
                        </p>
                    </div>
                    <p style="margin: 0; color: #999; font-size: 0.85em; white-space: nowrap; margin-left: 15px;">
                        ${timestamp}
                    </p>
                </div>
            `;

            return entry;
        }

        function loadMoreHistory() {
            historyPage++;
            loadHistory();
        }

        function handleOverridePasswordKeypress(event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                submitOverride();
            }
        }

        function submitOverride() {
            const password = document.getElementById('overridePassword').value.trim();
            
            if (!password) {
                alert('Please enter the password');
                return;
            }

            if (password.length !== 6) {
                alert('Password must be 6 characters long');
                return;
            }

            const studentName = document.getElementById('overrideStudentName').innerText;

            // Show confirmation dialog
            if (confirm(`⚠️ WARNING!\n\nAre you sure you want to reset the fines of ${studentName} to ZERO?\n\nThis action cannot be undone.`)) {
                // Proceed with override
                fetch(`/api/override-fines/${currentOverrideStudentId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ password: password })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(`✓ Success!\n\nFines for ${data.studentName} have been reset to zero.`);
                        closeOverrideModal();
                        location.reload();
                    } else {
                        alert('Error: ' + (data.message || 'Failed to override fines'));
                    }
                })
                .catch(err => {
                    console.error('Error:', err);
                    alert('Error overriding fines');
                });
            }
        }

        // Sort each year level table by last name on page load
        window.addEventListener('load', function() {
            const tables = document.querySelectorAll('.studentTable tbody');
            tables.forEach(tbody => {
                const rows = Array.from(tbody.getElementsByTagName('tr'));
                rows.sort((a, b) => {
                    const aName = a.getAttribute('data-name').toLowerCase();
                    const bName = b.getAttribute('data-name').toLowerCase();
                    return aName.localeCompare(bName);
                });
                rows.forEach(row => tbody.appendChild(row));
            });
        });

        // Allow Enter to search
        document.getElementById('searchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                filterTable();
            }
        });

        // Mobile Menu Toggle
        document.getElementById('menuToggle').addEventListener('click', function() {
            document.getElementById('sidebar').classList.toggle('active');
        });

        function closeMobileMenu() {
            document.getElementById('sidebar').classList.remove('active');
        }

        // Close sidebar when clicking on a link
        document.querySelectorAll('.sidebar a').forEach(link => {
            link.addEventListener('click', closeMobileMenu);
        });

        // Edit Initial Fine Functions
        function openEditInitialFineModal(element) {
            const studentId = element.getAttribute('data-student-id');
            const studentName = element.getAttribute('data-student-name');
            const currentAmount = parseFloat(element.getAttribute('data-initial-fine')) || 0;
            
            document.getElementById('studentNameDisplay').textContent = studentName;
            document.getElementById('studentIdDisplay').textContent = studentId;
            document.getElementById('initialFineAmount').value = currentAmount;
            document.getElementById('initialFineNotes').value = '';
            document.getElementById('editInitialFineModal').style.display = 'block';
            document.getElementById('initialFineAmount').focus();
        }

        function closeEditInitialFineModal() {
            document.getElementById('editInitialFineModal').style.display = 'none';
        }

        function submitInitialFine() {
            const studentId = document.getElementById('studentIdDisplay').textContent;
            const amount = parseFloat(document.getElementById('initialFineAmount').value);
            const notes = document.getElementById('initialFineNotes').value;

            if (isNaN(amount) || amount < 0) {
                alert('Please enter a valid amount');
                return;
            }

            fetch('/api/update-initial-fine', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    studentId: studentId,
                    amount: amount,
                    notes: notes
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showSuccessModal('Initial fine updated successfully');
                    closeEditInitialFineModal();
                    setTimeout(() => {
                        location.reload();
                    }, 1000);
                } else {
                    alert('Error: ' + data.error);
                }
            })
            .catch(err => {
                console.error('Error:', err);
                alert('Error updating fine');
            });
        }

        function showSuccessModal(message) {
            const modal = document.getElementById('successModal');
            const messageEl = document.getElementById('successMessage');
            messageEl.textContent = message;
            modal.style.display = 'block';
            
            setTimeout(() => {
                modal.style.display = 'none';
            }, 1000);
        }

        // Close modal when clicking outside
        window.addEventListener('click', function(event) {
            const rejectModal = document.getElementById('rejectModal');
            const fineModal = document.getElementById('editInitialFineModal');
            const overrideModal = document.getElementById('overrideModal');
            const historyModal = document.getElementById('historyModal');
            if (event.target === rejectModal) {
                rejectModal.style.display = 'none';
            }
            if (event.target === fineModal) {
                fineModal.style.display = 'none';
            }
            if (event.target === overrideModal) {
                closeOverrideModal();
            }
            if (event.target === historyModal) {
                closeHistoryModal();
            }
        });
    </script>

    <style>
        @media (max-width: 768px) {
            #historyModalContent {
                width: 95vw !important;
                height: 90vh !important;
                max-width: 95vw !important;
            }
            
            .history-tab {
                font-size: 0.85em !important;
                padding: 5px 10px !important;
            }
        }

        @media (max-width: 480px) {
            #historyModalContent {
                width: 98vw !important;
                height: 92vh !important;
                max-width: 98vw !important;
            }
            
            .history-tab {
                font-size: 0.8em !important;
                padding: 4px 8px !important;
            }

            #historyModalContent h2 {
                font-size: 1.2em !important;
            }
        }
    </style>
</body>
</html>
