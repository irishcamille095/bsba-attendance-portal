<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Master Student List - BSBA Portal</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f4f4f4;
            display: flex;
        }

        /* Mobile Header */
        .mobile-header {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: #ffcc00;
            color: #000;
            padding: 12px 15px;
            z-index: 1001;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .mobile-header.active {
            display: flex;
        }

        .hamburger-btn {
            background: none;
            border: none;
            font-size: 1.5em;
            cursor: pointer;
            color: #000;
            padding: 5px;
        }

        .mobile-header h1 {
            font-size: 1.1em;
            margin: 0;
            flex: 1;
            text-align: center;
        }

        /* Sidebar */
        .sidebar {
            width: 250px;
            background: #000;
            color: #ffcc00;
            height: 100vh;
            position: fixed;
            padding: 20px;
            border-right: 4px solid #ffcc00;
            overflow-y: auto;
        }

        .sidebar h2 {
            border-bottom: 2px solid #ffcc00;
            padding-bottom: 10px;
            text-align: center;
            margin-bottom: 20px;
        }

        .sidebar p {
            color: #fff;
            margin-bottom: 8px;
        }

        .logout-btn {
            background: #ffcc00;
            color: #000;
            border: none;
            padding: 12px;
            width: 100%;
            margin-top: 30px;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .logout-btn:hover {
            background: #e6b800;
        }

        /* Main Content */
        .content {
            flex: 1;
            margin-left: 290px;
            padding: 30px;
        }

        header {
            background: #ffcc00;
            color: #000;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 30px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        header p {
            font-size: 1.1em;
            opacity: 0.9;
        }

        /* Controls */
        .controls {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            font-size: 1em;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 600;
        }

        .btn-primary {
            background: #000;
            color: #ffcc00;
            border: 2px solid #ffcc00;
        }

        .btn-primary:hover {
            background: #ffcc00;
            color: #000;
            transform: translateY(-2px);
        }

        .btn-secondary {
            background: #6c757d;
            color: white;
        }

        .btn-secondary:hover {
            background: #5a6268;
            transform: translateY(-2px);
        }

        .search-box {
            flex: 1;
            min-width: 250px;
        }

        .search-box input {
            width: 100%;
            padding: 12px;
            border: 2px solid #000;
            border-radius: 8px;
            font-size: 1em;
            background: white;
            color: #1a1a1a;
            transition: all 0.3s ease;
        }

        .search-box input::placeholder {
            color: #999;
        }

        .search-box input:focus {
            outline: none;
            border-color: #ffcc00;
            box-shadow: 0 0 0 3px rgba(255, 204, 0, 0.1);
            background: #fffcf0;
        }

        /* Table Styles */
        .table-container {
            background: white;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 900px;
        }

        thead {
            background: #000;
            color: #ffcc00;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        th {
            padding: 15px;
            text-align: left;
            font-weight: 600;
            border-bottom: 2px solid #ffcc00;
            white-space: nowrap;
        }

        td {
            padding: 12px 15px;
            border-bottom: 1px solid #e0e0e0;
        }

        tbody tr:hover {
            background: #f8f9fa;
        }

        tbody tr.assigned {
            background: #fffbf0;
        }

        tbody tr.assigned:hover {
            background: #fff5e6;
        }

        .student-id {
            font-family: 'Courier New', monospace;
            font-weight: 700;
            color: #800000;
            font-size: 1.1em;
        }

        .student-name {
            font-weight: 500;
            color: #333;
        }

        .empty-slot {
            color: #999;
            font-style: italic;
        }

        .role-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.85em;
            font-weight: 600;
        }

        .role-student {
            background: #d1ecf1;
            color: #0c5460;
        }

        .role-officer {
            background: #cce5ff;
            color: #004085;
        }

        .role-adviser {
            background: #f8d7da;
            color: #721c24;
        }

        .qr-code {
            width: 40px;
            height: 40px;
            border: 1px solid #ddd;
            border-radius: 5px;
            cursor: pointer;
            transition: transform 0.3s ease;
        }

        .qr-code:hover {
            transform: scale(1.2);
        }

        .qr-placeholder {
            width: 40px;
            height: 40px;
            background: #f0f0f0;
            border: 1px dashed #ddd;
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #999;
            font-size: 0.8em;
        }

        select, .btn-sm {
            padding: 6px 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 0.9em;
            cursor: pointer;
        }

        select {
            background: white;
            color: #333;
        }

        .btn-sm {
            background: none;
            border: none;
            color: #dc3545;
            font-weight: 600;
            padding: 5px 10px;
            transition: all 0.3s ease;
        }

        .btn-sm:hover {
            background: #f8d7da;
            border-color: #dc3545;
        }

        .back-btn {
            background: #000;
            color: #ffcc00;
            border: 2px solid #ffcc00;
            padding: 12px 20px;
            cursor: pointer;
            margin-bottom: 15px;
            display: inline-block;
            font-weight: bold;
            border-radius: 8px;
            font-size: 1em;
            transition: all 0.3s;
            max-width: 200px;
        }

        .back-btn:hover {
            background: #ffcc00;
            color: #000;
        }

        .stats {
            background: white;
            padding: 15px;
            border-radius: 8px;
            margin-top: 20px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
        }

        .stat-card {
            padding: 15px;
            background: #f8f9fa;
            border-left: 4px solid #ffcc00;
            border-radius: 5px;
        }

        .stat-label {
            color: #666;
            font-size: 0.8em;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stat-value {
            font-size: 1.8em;
            font-weight: 700;
            color: #000;
            margin-top: 5px;
        }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            animation: fadeIn 0.3s ease;
        }

        .modal-content {
            background-color: white;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            padding: 30px;
            border-radius: 10px;
            width: 80%;
            max-width: 500px;
            text-align: center;
            box-shadow: 0 5px 30px rgba(0, 0, 0, 0.3);
        }

        .modal-content img {
            max-width: 100%;
            height: auto;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
            transition: color 0.3s ease;
        }

        .close:hover {
            color: #000;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        #searchResults table {
            width: 100%;
            border-collapse: collapse;
        }

        #searchResults th {
            background: #000;
            color: #ffcc00;
            padding: 12px;
            text-align: left;
            border-bottom: 2px solid #ffcc00;
        }

        #searchResults td {
            padding: 12px;
            border-bottom: 1px solid #e0e0e0;
        }

        #searchResults tr:hover {
            background: #f8f9fa;
        }

        @media (max-width: 768px) {
            .mobile-header.active {
                display: flex;
            }

            .sidebar {
                position: fixed;
                left: 0;
                top: 50px;
                width: 100%;
                height: auto;
                max-height: calc(100vh - 50px);
                transform: translateX(-100%);
                transition: transform 0.3s ease;
                z-index: 2000;
                padding: 15px;
                border-right: none;
                border-bottom: 2px solid #ffcc00;
                overflow-y: auto;
            }

            .sidebar.active {
                transform: translateX(0);
            }

            .content {
                margin-left: 0 !important;
                width: 100%;
                padding: 15px;
                margin-top: 50px;
            }

            header {
                padding: 15px;
                margin-bottom: 15px;
            }

            header h1 {
                font-size: 1.5em;
                margin-bottom: 5px;
            }

            header p {
                font-size: 0.95em;
            }

            .controls {
                gap: 8px;
                margin-bottom: 15px;
                flex-direction: column;
            }

            .search-box {
                min-width: unset;
            }

            .btn {
                padding: 11px 15px;
                font-size: 0.95em;
                width: 100%;
                text-align: center;
            }

            .table-container {
                overflow-x: auto;
                margin-bottom: 15px;
            }

            table {
                font-size: 0.9em;
                min-width: 700px;
            }

            th, td {
                padding: 8px 10px;
                white-space: nowrap;
            }

            .qr-code {
                width: 30px;
                height: 30px;
            }
        }

        @media (max-width: 480px) {
            .content {
                padding: 10px;
            }

            header {
                padding: 12px;
            }

            header h1 {
                font-size: 1.2em;
            }

            header p {
                font-size: 0.9em;
            }

            .controls {
                gap: 5px;
            }

            .btn {
                padding: 10px 12px;
                font-size: 0.9em;
            }

            table {
                font-size: 0.8em;
                min-width: 600px;
            }

            th, td {
                padding: 6px 8px;
            }

            .qr-code {
                width: 25px;
                height: 25px;
            }
        }
    </style>
</head>
<body>
    <!-- Mobile Header -->
    <div class="mobile-header" id="mobileHeader">
        <button class="hamburger-btn" onclick="toggleSidebar()">☰</button>
        <h1>BSBA-MM</h1>
    </div>

    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <h2 style="color: #ffcc00;">BSBA-MM</h2>
        <p>Admin Panel</p>
        <p style="color: #fff;">User: <strong><%= user.name %></strong></p>
        <p style="color: #fff;">Role: <strong><%= user.role %></strong></p>
        
        <hr style="border: 1px solid #ffcc00; margin: 15px 0;">
        
        <form action="/logout" method="POST" style="margin-top: 20px;">
            <button type="submit" class="logout-btn">🚪 Logout</button>
        </form>
    </div>

    <!-- Main Content -->
    <div class="content">
        <header>
            <h1>👥 Master Student List</h1>
            <p>Manage all 300 student ID slots (MM-001 to MM-300)</p>
        </header>

        <a href="/dashboard" class="back-btn" style="text-decoration: none; display: inline-block;">⬅️ Back to Menu</a>

        <!-- Controls -->
        <div class="controls">
            <div class="search-box">
                <input 
                    type="text" 
                    id="searchInput" 
                    placeholder="Search by Student ID or Name..."
                    onkeyup="filterTable()"
                >
            </div>
            <a href="/download-all-qrs" class="btn btn-primary" style="display:inline-block; text-decoration:none; text-align:center;">📄 Download All Student QR Cards</a>
        </div>

        <!-- Search Results Container -->
        <div id="searchResults" style="display: none; background: white; border-radius: 10px; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1); margin-bottom: 20px; overflow: hidden;"></div>

        <!-- Table -->
        <div class="table-container">
            <table id="studentTable">
                <thead>
                    <tr>
                        <th style="width: 12%;">Student ID</th>
                        <th style="width: 22%;">Name</th>
                        <th style="width: 15%;">Role</th>
                        <th style="width: 12%;">QR Code</th>
                        <th style="width: 12%;">COR</th>
                        <th style="width: 27%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% students.forEach((student) => { %>
                        <tr class="<%= student.isAssigned ? 'assigned' : '' %>" data-id="<%= student.mmId %>" data-name="<%= student.name || '' %>">
                            <td class="student-id"><%= student.mmId %></td>
                            <td>
                                <span class="<%= student.isAssigned ? 'student-name' : 'empty-slot' %>">
                                    <%= student.isAssigned ? student.name : '(Empty Slot)' %>
                                </span>
                            </td>
                            <td>
                                <% if (student.isAssigned) { %>
                                    <span class="role-badge role-<%= student.role.toLowerCase() %>">
                                        <%= student.role %>
                                    </span>
                                <% } else { %>
                                    <span class="empty-slot">—</span>
                                <% } %>
                            </td>
                            <td>
                                <div class="qr-placeholder" data-mmid="<%= student.mmId %>" onclick="loadAndShowQR('<%= student.mmId %>')">
                                    <span style="cursor: pointer; color: #ffcc00;">Click to load</span>
                                </div>
                            </td>
                            <td>
                                <% if (student.isAssigned && student.corPath) { %>
                                    <a href="/download-cor/<%= student._id %>" class="btn-sm" style="color: #28a745; text-decoration: none; font-weight: 600;" title="Download COR">
                                        📄 Download
                                    </a>
                                <% } else { %>
                                    <span class="empty-slot">—</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (student.isAssigned) { %>
                                    <select onchange="changeRole('<%= student.mmId %>', this.value)" style="margin-right: 5px;">
                                        <option value="">Change Role</option>
                                        <option value="student" <%= student.role === 'student' ? 'selected' : '' %>>Student</option>
                                        <option value="officer" <%= student.role === 'officer' ? 'selected' : '' %>>Officer</option>
                                        <option value="adviser" <%= student.role === 'adviser' ? 'selected' : '' %>>Adviser</option>
                                    </select>
                                    <button class="btn-sm" onclick="removeStudent('<%= student.mmId %>', '<%= student.name %>')">🗑️ Remove</button>
                                <% } else { %>
                                    <span class="empty-slot">No actions</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <!-- Statistics -->
        <div class="stats">
            <div class="stat-card">
                <div class="stat-label">Total Slots</div>
                <div class="stat-value">300</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Assigned</div>
                <div class="stat-value"><%= totalAssigned %></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Available</div>
                <div class="stat-value"><%= 300 - totalAssigned %></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Page</div>
                <div class="stat-value"><%= page %> / <%= totalPages %></div>
            </div>
        </div>

        <!-- Pagination Controls -->
        <div style="margin-top: 20px; display: flex; justify-content: center; gap: 10px; flex-wrap: wrap;">
            <% if (page > 1) { %>
                <a href="/admin/students?page=1" class="btn btn-secondary">⏮️ First</a>
                <a href="/admin/students?page=<%= page - 1 %>" class="btn btn-secondary">◀ Previous</a>
            <% } %>
            
            <span style="padding: 12px 24px; background: #f0f0f0; border-radius: 8px; align-self: center;">
                Page <%= page %> of <%= totalPages %> (50 students per page)
            </span>
            
            <% if (page < totalPages) { %>
                <a href="/admin/students?page=<%= page + 1 %>" class="btn btn-secondary">Next ▶</a>
                <a href="/admin/students?page=<%= totalPages %>" class="btn btn-secondary">Last ⏭️</a>
            <% } %>
        </div>
    </div>

    <!-- QR Modal -->
    <div id="qrModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeQRModal()">&times;</span>
            <h2 id="qrModalTitle"></h2>
            <img id="qrModalImage" src="" alt="QR Code">
            <p style="color: #666; margin-top: 15px;">Right-click to save image</p>
        </div>
    </div>

    <script>
        // QR Code cache to avoid fetching the same code twice
        const qrCache = {};

        // Lazy-load QR code on demand
        async function loadAndShowQR(mmId) {
            try {
                // Check cache first
                if (qrCache[mmId]) {
                    showQRModal(qrCache[mmId], mmId);
                    return;
                }

                // Fetch QR code from server
                const response = await fetch(`/api/student-qr/${mmId}`);
                if (!response.ok) {
                    alert('Error loading QR code');
                    return;
                }

                const data = await response.json();
                qrCache[mmId] = data.qrCode; // Cache it
                
                // Update the placeholder with actual image
                const placeholder = document.querySelector(`[data-mmid="${mmId}"]`);
                if (placeholder) {
                    const img = document.createElement('img');
                    img.src = data.qrCode;
                    img.alt = `QR ${mmId}`;
                    img.className = 'qr-code';
                    img.onclick = function() { showQRModal(data.qrCode, mmId); };
                    img.title = 'Click to expand';
                    placeholder.replaceWith(img);
                }

                // Show QR in modal
                showQRModal(data.qrCode, mmId);
            } catch (error) {
                console.error('Error loading QR code:', error);
                alert('Error loading QR code');
            }
        }

        // QR Modal functions
        function showQRModal(qrCode, mmId) {
            document.getElementById('qrModal').style.display = 'block';
            document.getElementById('qrModalImage').src = qrCode;
            document.getElementById('qrModalTitle').textContent = `QR Code: ${mmId}`;
        }

        function closeQRModal() {
            document.getElementById('qrModal').style.display = 'none';
        }

        window.onclick = function(event) {
            const modal = document.getElementById('qrModal');
            if (event.target === modal) {
                modal.style.display = 'none';
            }
        }

        // Change role
        async function changeRole(mmId, newRole) {
            if (!newRole) return;

            try {
                const response = await fetch('/admin/update-student-role', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mmId, newRole })
                });

                const data = await response.json();

                if (!response.ok) {
                    alert('Error: ' + data.error);
                    location.reload();
                    return;
                }

                alert(data.message);
                location.reload();
            } catch (error) {
                console.error('Error:', error);
                alert('Error updating role');
            }
        }

        // Remove student
        function removeStudent(mmId, studentName) {
            if (!confirm(`Are you sure you want to remove ${studentName || 'this student'}? Their profile will be wiped clean but the ID will be available for a new student.`)) {
                return;
            }

            fetch('/admin/remove-student', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ mmId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert('Error: ' + data.error);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error removing student');
            });
        }

        // Filter table
        function filterTable() {
            const input = document.getElementById('searchInput');
            const filter = input.value.toLowerCase();
            
            // If search box is empty, show all rows on current page
            if (!filter) {
                const table = document.getElementById('studentTable');
                const rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');
                for (let i = 0; i < rows.length; i++) {
                    rows[i].style.display = '';
                }
                document.getElementById('searchResults').style.display = 'none';
                document.querySelector('.table-container').style.display = 'block';
                return;
            }

            // Search across all 300 slots using API
            fetch(`/api/search-students?q=${encodeURIComponent(filter)}`)
                .then(response => response.json())
                .then(data => {
                    console.log('Search results:', data);
                    const resultsDiv = document.getElementById('searchResults');
                    
                    if (data.results.length === 0) {
                        resultsDiv.innerHTML = '<div style="padding: 20px; text-align: center; color: #666; font-size: 1.1em;">No results found for "' + filter + '"</div>';
                        resultsDiv.style.display = 'block';
                        document.querySelector('.table-container').style.display = 'none';
                        return;
                    }

                    // Build results HTML with proper table styling
                    let html = '<div style="padding: 20px;">' +
                               '<div style="margin-bottom: 15px; font-weight: bold; font-size: 1.1em; color: #000;">Search Results: Found ' + data.results.length + ' match(es)</div>' +
                               '<div style="overflow-x: auto;">' +
                               '<table style="width: 100%; border-collapse: collapse; background: white;">' +
                               '<thead>' +
                               '<tr style="background: #000; color: #ffcc00;">' +
                               '<th style="padding: 12px; text-align: left; border-bottom: 2px solid #ffcc00;">MM-ID</th>' +
                               '<th style="padding: 12px; text-align: left; border-bottom: 2px solid #ffcc00;">Name</th>' +
                               '<th style="padding: 12px; text-align: center; border-bottom: 2px solid #ffcc00;">Page</th>' +
                               '<th style="padding: 12px; text-align: left; border-bottom: 2px solid #ffcc00;">Action</th>' +
                               '</tr>' +
                               '</thead>' +
                               '<tbody>';
                    
                    data.results.forEach((result, index) => {
                        const bgColor = index % 2 === 0 ? '#ffffff' : '#f8f9fa';
                        html += '<tr style="background: ' + bgColor + '; border-bottom: 1px solid #ddd;">' +
                                '<td style="padding: 12px; font-weight: bold; color: #800000;">' + result.mmId + '</td>' +
                                '<td style="padding: 12px; color: #333;">' + (result.name || '(Empty Slot)') + '</td>' +
                                '<td style="padding: 12px; text-align: center; color: #333;">' + result.page + '</td>' +
                                '<td style="padding: 12px;"><a href="/admin/students?page=' + result.page + '" style="background: #000; color: #ffcc00; padding: 10px 15px; border-radius: 5px; text-decoration: none; font-weight: bold; display: inline-block; border: 2px solid #ffcc00; transition: all 0.3s ease;">Go to Page</a></td>' +
                                '</tr>';
                    });
                    
                    html += '</tbody></table></div></div>';
                    resultsDiv.innerHTML = html;
                    resultsDiv.style.display = 'block';
                    document.querySelector('.table-container').style.display = 'none';
                    
                    console.log('Results displayed successfully');
                })
                .catch(error => {
                    console.error('Search error:', error);
                    document.getElementById('searchResults').innerHTML = '<div style="padding: 20px; color: #c00;">Error performing search: ' + error.message + '</div>';
                    document.getElementById('searchResults').style.display = 'block';
                });
        }

        // Mobile sidebar and header functionality
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('active');
        }

        // Close sidebar when clicking outside
        document.addEventListener('click', function(event) {
            const sidebar = document.getElementById('sidebar');
            const hamburger = document.querySelector('.hamburger-btn');
            
            if (window.innerWidth <= 768 && 
                sidebar.classList.contains('active') && 
                !sidebar.contains(event.target) && 
                !hamburger.contains(event.target)) {
                sidebar.classList.remove('active');
            }
        });

        // Show mobile header on mobile screens
        function updateMobileHeader() {
            const mobileHeader = document.getElementById('mobileHeader');
            if (window.innerWidth <= 768) {
                mobileHeader.classList.add('active');
            } else {
                mobileHeader.classList.remove('active');
                const sidebar = document.getElementById('sidebar');
                sidebar.classList.remove('active');
            }
        }

        // Initialize on load and on resize
        window.addEventListener('load', updateMobileHeader);
        window.addEventListener('resize', updateMobileHeader);
    </script>
</body>
</html>
