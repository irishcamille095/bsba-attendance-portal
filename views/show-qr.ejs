<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendance QR - BSBA-MM</title>
    <style>
        body { font-family: sans-serif; background: #000; color: #ffcc00; text-align: center; padding: 50px; }
        .qr-container { background: white; padding: 30px; display: inline-block; border-radius: 20px; border: 5px solid #ffcc00; }
        .info { margin-top: 20px; font-size: 1.2em; }
        .back-link { display: inline-block; margin-top: 30px; color: #ffcc00; text-decoration: none; font-weight: bold; border: 1px solid #ffcc00; padding: 10px 20px; border-radius: 5px; }
    </style>
</head>
<body>

    <h1>SCAN FOR ATTENDANCE</h1>
    <p class="info">Session: <strong><%= session.type.replace('_', ' ') %></strong></p>
    
    <div class="qr-container">
        <img src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=<%= session.token %>" alt="Attendance QR">
    </div>

    <p>Date: <%= new Date(session.date).toDateString() %></p>
    
    <a href="/dashboard" class="back-link">⬅️ Back to Dashboard</a>

</body>
</html>

<div style="margin-top: 50px; border-top: 1px dashed #ffcc00; padding-top: 20px;">
    <p style="color: #ff4444;">Made a mistake? (e.g. wrong session type)</p>
    <form action="/delete-session" method="POST" onsubmit="return confirm('Are you sure you want to delete this session? All scans for this QR will be lost.');">
        <input type="hidden" name="sessionId" value="<%= session._id %>">
        <button type="submit" style="background: #ff4444; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; font-weight: bold;">
            🗑️ Void & Delete This QR
        </button>
    </form>
</div>