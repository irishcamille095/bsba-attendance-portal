<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0, user-scalable=no">
    <title>Attendance Scanner</title>
    <script src="https://unpkg.com/html5-qrcode"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* Show-QR-specific overrides */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        html, body { 
            width: 100%; 
            height: 100%; 
            overflow: hidden;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #000;
        }

        .scanner-container {
            display: flex;
            flex-direction: column;
            height: 100vh;
            background: #000;
            color: #fff;
        }

        .scanner-header {
            background: #ffcc00;
            color: #000;
            padding: 15px;
            text-align: center;
            flex-shrink: 0;
        }

        .scanner-header h1 {
            font-family: 'Poppins', sans-serif;
            font-size: 1.5em;
            font-weight: 800;
            margin-bottom: 12px;
            font-weight: bold;
            letter-spacing: 0.5px;
        }

        .session-info {
            font-size: 0.9em;
            color: #333;
            line-height: 1.6;
            font-family: 'Inter', sans-serif;
        }

        .session-info div {
            margin: 4px 0;
        }

        .event-name {
            font-family: 'Poppins', sans-serif;
            font-size: 1.15em;
            font-weight: 700;
            color: #800000;
            margin-bottom: 2px;
        }

        .scanner-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
        }

        #reader {
            width: 100% !important;
            height: 100% !important;
            flex: 1;
        }

        .status-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(0,0,0,0.85);
            color: #fff;
            padding: 20px;
            text-align: center;
            z-index: 100;
            display: none;
        }

        .status-overlay.show {
            display: block;
        }

        .status-overlay.success {
            background: rgba(0, 128, 0, 0.9);
        }

        .status-overlay.error {
            background: rgba(200, 0, 0, 0.9);
        }

        .status-message {
            font-family: 'Poppins', sans-serif;
            font-size: 1.4em;
            font-weight: 700;
            margin-bottom: 10px;
            letter-spacing: 0.5px;
        }

        .continue-link {
            display: inline-block;
            margin-top: 10px;
            padding: 12px 20px;
            background: #ffcc00;
            color: #000;
            text-decoration: none;
            border-radius: 5px;
            font-weight: 600;
            font-family: 'Poppins', sans-serif;
        }

        .scanner-footer {
            background: #1a1a1a;
            padding: 15px;
            display: flex;
            gap: 10px;
            flex-shrink: 0;
        }

        .btn {
            flex: 1;
            padding: 15px;
            border: none;
            border-radius: 8px;
            font-size: 1em;
            font-weight: 700;
            cursor: pointer;
            font-family: 'Poppins', sans-serif;
            letter-spacing: 0.3px;
        }

        .btn-end {
            background: #800000;
            color: white;
        }

        .btn-end:active {
            background: #600000;
        }

        .btn-info {
            background: #ffcc00;
            color: #000;
            flex: 0;
            padding: 15px 20px;
        }

        .scanning-indicator {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 2.5em;
            opacity: 0.6;
            pointer-events: none;
        }
    </style>
</head>
<body>

    <div class="scanner-container">
        <div class="scanner-header">
            <h1>SCANNER</h1>
            <div class="session-info">
                <div class="event-name"><%= session.eventName %></div>
                <div><%= session.type.replace('_', ' ') %></div>
                <div><%= new Date(session.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></div>
            </div>
        </div>

        <div class="scanner-body">
            <div id="reader"></div>
            <div class="scanning-indicator">SCAN</div>
            <div class="status-overlay" id="statusOverlay"></div>
        </div>

        <div class="scanner-footer">
            <button class="btn btn-end" onclick="endScanning()">END SESSION</button>
            <button class="btn btn-info" onclick="showAbout()">INFO</button>
        </div>
    </div>

    <script>
        const sessionId = '<%= session._id %>';

        function showStatus(message, subtext, type = 'success') {
            const overlay = document.getElementById('statusOverlay');
            overlay.className = `status-overlay show ${type}`;
            overlay.innerHTML = `
                <div class="status-message">${message}</div>
                ${subtext ? `<div>${subtext}</div>` : ''}
                <a href="/attendance?sessionId=${sessionId}" class="continue-link">Next Student</a>
            `;
            
            if (type === 'success') {
                setTimeout(() => overlay.classList.remove('show'), 3000);
            }
        }

        function onScanSuccess(decodedText) {
            fetch(`/mark-attendance?code=${decodedText}&sessionId=${sessionId}`)
                .then(response => response.text())
                .then(html => {
                    if (html.includes('Success')) {
                        const match = html.match(/<p>(.*?)<\/p>/);
                        const text = match ? match[1] : 'Student recorded';
                        showStatus('SUCCESS', text, 'success');
                    } else {
                        const match = html.match(/<p>(.*?)<\/p>/);
                        const text = match ? match[1] : 'Error scanning';
                        showStatus('ERROR', text, 'error');
                    }
                })
                .catch(error => {
                    showStatus('ERROR', 'Failed to record', 'error');
                });
        }

        function onScanError(error) { }

        let html5QrcodeScanner = new Html5QrcodeScanner("reader", {
            fps: 10,
            qrbox: { width: 250, height: 250 },
            formatsToSupport: [ Html5QrcodeSupportedFormats.QR_CODE ]
        });

        html5QrcodeScanner.render(onScanSuccess, onScanError);

        function endScanning() {
            if (confirm('End scanning session?')) {
                window.location.href = '/dashboard';
            }
        }

        function showAbout() {
            alert('Event: <%= session.eventName %>\nType: <%= session.type.replace("_", " ") %>\n\nPoint camera at MM-ID QR codes.');
        }

        if ('wakeLock' in navigator) {
            navigator.wakeLock.request('screen').catch(() => {});
        }
    </script>

</body>
</html>