<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Details - BSBA Portal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #000 0%, #1a1a1a 100%);
            color: #e0e0e0;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            width: 100%;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding: 20px;
            background: #111;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

        .header h1 {
            color: #FFD700;
            font-size: 2em;
        }

        .back-btn {
            display: inline-block;
            color: #FFD700;
            text-decoration: none;
            font-weight: 700;
            font-size: 1em;
            transition: all 0.3s ease;
            background: #000;
            border: 2px solid #FFD700;
            padding: 12px 20px;
            border-radius: 8px;
            cursor: pointer;
        }

        .back-btn:hover {
            background: #FFD700;
            color: #000;
        }

        .details-card {
            background: #1e1e1e;
            padding: 30px;
            border-radius: 12px;
            border-left: 5px solid #FFD700;
            border: 1px solid #2d2d2d;
            margin-bottom: 30px;
        }

        .details-card h2 {
            color: #FFD700;
            margin-bottom: 20px;
            font-size: 1.5em;
        }

        .detail-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }

        .detail-item {
            background: #252525;
            padding: 15px;
            border-radius: 8px;
            border-left: 4px solid #FFD700;
        }

        .detail-label {
            color: #FFD700;
            font-weight: bold;
            font-size: 0.9em;
            text-transform: uppercase;
            margin-bottom: 8px;
            display: block;
        }

        .detail-value {
            color: #e0e0e0;
            font-size: 1.1em;
            word-break: break-word;
        }

        .empty-value {
            color: #999;
            font-style: italic;
        }

        @media (max-width: 768px) {
            .header {
                flex-direction: column;
                gap: 15px;
                text-align: left;
                align-items: flex-start;
            }

            .header h1 {
                font-size: 1.5em;
            }

            .detail-row {
                grid-template-columns: 1fr;
            }

            .details-card {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1><i class="fas fa-user-circle"></i> Student Details</h1>
            <button onclick="window.location.href='/admin/students'" class="back-btn"><i class="fas fa-arrow-left"></i> Back</button>
        </div>

        <div class="details-card">
            <h2>Personal Information</h2>
            <div class="detail-row">
                <div class="detail-item">
                    <span class="detail-label">Student ID (MM-ID)</span>
                    <span class="detail-value"><%= student.mmId %></span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Username</span>
                    <span class="detail-value"><%= student.username || 'N/A' %></span>
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-item">
                    <span class="detail-label">First Name</span>
                    <span class="detail-value"><%= student.firstName || 'N/A' %></span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Middle Name</span>
                    <span class="detail-value"><%= student.middleName || 'N/A' %></span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Last Name</span>
                    <span class="detail-value"><%= student.lastName || 'N/A' %></span>
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-item">
                    <span class="detail-label">Email</span>
                    <span class="detail-value"><%= student.email || 'N/A' %></span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Contact Number</span>
                    <span class="detail-value"><%= student.contactNumber || 'N/A' %></span>
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-item">
                    <span class="detail-label">Age</span>
                    <span class="detail-value"><%= student.age || 'N/A' %></span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Gender</span>
                    <span class="detail-value"><%= student.gender || 'N/A' %></span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Date of Birth</span>
                    <span class="detail-value"><%= student.dateOfBirth ? new Date(student.dateOfBirth).toLocaleDateString() : 'N/A' %></span>
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-item">
                    <span class="detail-label">Year Level</span>
                    <span class="detail-value"><%= student.yearLevel || '1st Year' %></span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Role</span>
                    <span class="detail-value" style="text-transform: capitalize;"><%= student.role || 'N/A' %></span>
                </div>
            </div>
        </div>

        <div class="details-card">
            <h2>Account Information</h2>
            <div class="detail-row">
                <div class="detail-item">
                    <span class="detail-label">Email Verified</span>
                    <span class="detail-value"><%= student.emailVerified ? 'Yes' : 'No' %></span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Account Created</span>
                    <span class="detail-value"><%= student.createdAt ? new Date(student.createdAt).toLocaleDateString() : 'N/A' %></span>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.documentElement.setAttribute('data-user-role', '<%= user.role %>');
    </script>
</body>
</html>
