<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendance System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #000 0%, #1a1a1a 100%);
            color: #e0e0e0;
            padding: 20px;
            display: flex;
            flex-direction: column;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
            flex: 1;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding: 20px;
            background: #111;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

        .header h1 {
            color: #FFD700;
            font-size: 2em;
        }

        .back-btn {
            display: inline-block;
            margin-bottom: 20px;
            color: #FFD700;
            text-decoration: none;
            font-weight: 700;
            font-size: 1em;
            transition: all 0.3s ease;
            background: #000;
            border: 2px solid #FFD700;
            padding: 12px 20px;
            border-radius: 8px;
        }

        .back-btn:hover {
            background: #FFD700;
            color: #000;
        }

        /* Section Styling */
        .section {
            background: #1e1e1e;
            padding: 20px;
            border-radius: 12px;
            border-left: 5px solid #FFD700;
            border: 1px solid #2d2d2d;
            margin-bottom: 30px;
        }

        .section h3 {
            color: #FFD700;
            margin-bottom: 20px;
        }

        /* Form Styling */
        form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
            color: #e0e0e0;
        }

        select, input {
            width: 100%;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #2d2d2d;
            background: #252525;
            color: #e0e0e0;
        }

        select:focus, input:focus {
            outline: none;
            border-color: #FFD700;
            box-shadow: 0 0 5px rgba(255, 215, 0, 0.3);
        }

        .form-group {
            display: flex;
            gap: 15px;
        }

        .form-group > div {
            flex: 1;
        }

        .btn {
            background: #FFD700;
            color: #000;
            border: none;
            padding: 12px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
        }

        .btn:hover {
            background: #FFC107;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(255, 215, 0, 0.3);
        }

        .btn-scanner {
            background: #1e1e1e;
            color: #FFD700;
            border: 2px solid #FFD700;
        }

        .btn-scanner:hover {
            background: #FFD700;
            color: #000;
        }

        /* Folder Grid */
        .folder-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 15px;
        }

        .folder-card {
            background: #252525;
            border-left: 5px solid #FFD700;
            border: 1px solid #2d2d2d;
            padding: 15px;
            border-radius: 12px;
            text-align: center;
            transition: all 0.3s;
        }

        .folder-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(255, 215, 0, 0.2);
        }

        .folder-icon {
            font-size: 2.5rem;
            display: block;
            color: #FFD700;
            margin-bottom: 10px;
        }

        .folder-name {
            font-size: 0.9rem;
            color: #e0e0e0;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .folder-actions {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            gap: 5px;
        }

        .folder-actions a {
            color: #FFD700;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s;
        }

        .folder-actions a:hover {
            color: #FFC107;
        }

        .delete-link {
            color: #ff6b6b !important;
        }

        .delete-link:hover {
            color: #ff5252 !important;
        }

        /* Create Folder Form */
        .create-form {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .create-form input {
            flex: 1;
        }

        .create-form button {
            background: #FFD700;
            color: #121212;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            white-space: nowrap;
        }

        .create-form button:hover {
            background: #FFC107;
        }

        /* QR Code Styling */
        .qr-container {
            display: flex;
            justify-content: center;
            padding: 15px;
            background: #121212;
            border-radius: 8px;
            margin: 15px 0;
        }

        .info-box {
            text-align: center;
            padding: 20px;
            background: #1e1e1e;
            border-radius: 12px;
            border-left: 5px solid #FFD700;
            border: 1px solid #2d2d2d;
            margin-bottom: 20px;
        }

        .info-box h3 {
            color: #FFD700;
            margin-bottom: 10px;
        }

        .info-box p {
            color: #e0e0e0;
            font-size: 1.1em;
        }

        .info-box .mm-id {
            color: #FFD700;
            font-weight: bold;
        }

        @media (max-width: 768px) {
            body {
                padding: 10px;
            }

            .header {
                flex-direction: column;
                gap: 15px;
                text-align: left;
                align-items: flex-start;
            }

            .header h1 {
                font-size: 1.5em;
            }

            .form-group {
                flex-direction: column;
            }

            .folder-grid {
                grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            }

            .create-form {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>📸 Attendance System</h1>
            <a href="/dashboard" class="back-btn">← Back to Menu</a>
        </div>

        <% if (user.role === 'officer' || user.role === 'adviser') { %>
            <!-- Officer Section: Scanning Form -->
            <div class="section">
                <h3><i class="fas fa-mobile-alt"></i> Start Scanning Students</h3>
                
                <form id="scanForm">
                    <div class="form-group">
                        <div>
                            <label>Semester/Folder:</label>
                            <select id="folderSelect" required>
                                <option value="" disabled selected>-- Select a Folder --</option>
                                <% folders.forEach(folder => { %>
                                    <option value="<%= folder._id %>"><%= folder.name %></option>
                                <% }); %>
                            </select>
                        </div>

                        <div>
                            <label>Event:</label>
                            <select id="eventSelect" name="eventName" required disabled>
                                <option value="" disabled selected>-- Select Folder First --</option>
                            </select>
                        </div>

                        <div>
                            <label>Session Type:</label>
                            <select name="sessionType" required>
                                <option value="AM_IN">Morning Check-In (AM IN)</option>
                                <option value="AM_OUT">Morning Check-Out (AM OUT)</option>
                                <option value="PM_IN">Afternoon Check-In (PM IN)</option>
                                <option value="PM_OUT">Afternoon Check-Out (PM OUT)</option>
                            </select>
                        </div>
                    </div>

                    <input type="hidden" id="folderIdInput" name="folderId">
                    <button type="submit" class="btn btn-scanner">
                        <i class="fas fa-search"></i> OPEN SCANNER
                    </button>
                </form>
            </div>

            <!-- Master Attendance Filing -->
            <div class="section">
                <h3><i class="fas fa-folder"></i> Master Attendance Filing</h3>
                
                <form action="/create-folder" method="POST" class="create-form">
                    <input type="text" name="folderName" placeholder="New Semester/Folder Name" required>
                    <button type="submit">+ Create</button>
                </form>

                <div class="folder-grid">
                    <% folders.forEach(folder => { %>
                        <div class="folder-card">
                            <span class="folder-icon"><i class="fas fa-folder"></i></span>
                            <div class="folder-name"><%= folder.name %></div>
                            
                            <div class="folder-actions">
                                <a href="/folder-details/<%= folder._id %>">View</a>
                                <a href="#" class="delete-link" onclick="showDeleteFolderConfirmation('<%= folder._id %>', '<%= folder.name %>'); return false;">Delete</a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>

        <% } else { %>
            <!-- Student Section: How to Mark Attendance -->
            <div class="info-box">
                <h3><i class="fas fa-list"></i> How to Mark Attendance</h3>
                <p>Simply show your <strong>MM-ID Card</strong> to the officer when they scan attendance.</p>
                <p>Your MM-ID is: <span class="mm-id"><%= user.mmId %></span></p>
            </div>
            
            <!-- Student QR Code -->
            <div class="info-box">
                <h3><i class="fas fa-mobile-alt"></i> Your Attendance QR Code</h3>
                <p style="color: #808080; margin-bottom: 15px;">Show this QR code to the officer for scanning:</p>
                <div class="qr-container" id="qrCodeContainer"></div>
                <p style="color: #808080;">An officer will scan your QR code to record your attendance.</p>
            </div>

            <!-- My Attendance Records -->
            <div class="section">
                <h3><i class="fas fa-chart-bar"></i> My Attendance Records</h3>
                <div class="folder-grid">
                    <% folders.forEach(folder => { %>
                        <div class="folder-card">
                            <span class="folder-icon"><i class="fas fa-folder"></i></span>
                            <div class="folder-name"><%= folder.name %></div>
                            <div class="folder-actions">
                                <a href="/my-attendance/<%= folder._id %>">View Records</a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </div>

    <script src="/delete-confirmation.js"></script>
    <script>
        const userRole = '<%= user.role %>';
        const folderId = document.getElementById('folderIdInput');
        const folderSelect = document.getElementById('folderSelect');
        const eventSelect = document.getElementById('eventSelect');
        const scanForm = document.getElementById('scanForm');

        // Load events when folder is selected
        if (folderSelect) {
            folderSelect.addEventListener('change', async (e) => {
                const selectedFolderId = e.target.value;
                folderId.value = selectedFolderId;

                if (selectedFolderId) {
                    eventSelect.innerHTML = '<option value="" disabled selected>Loading events...</option>';
                    eventSelect.disabled = true;

                    try {
                        const response = await fetch(`/api/folder-events/${selectedFolderId}`);
                        const data = await response.json();

                        if (Array.isArray(data) && data.length > 0) {
                            eventSelect.innerHTML = '<option value="" disabled selected>-- Select Event --</option>';
                            data.forEach(event => {
                                const option = document.createElement('option');
                                option.value = event.eventName;
                                option.textContent = event.eventName;
                                option.dataset.eventType = event.eventType || 'Whole Day';
                                eventSelect.appendChild(option);
                            });
                            eventSelect.disabled = false;
                        } else {
                            eventSelect.innerHTML = '<option value="" disabled selected>No events in this folder</option>';
                            eventSelect.disabled = true;
                        }
                    } catch (err) {
                        console.error('Error loading events:', err);
                        eventSelect.innerHTML = '<option value="" disabled selected>Error loading events</option>';
                        eventSelect.disabled = true;
                    }
                }
            });

            const sessionTypeSelect = document.querySelector('select[name="sessionType"]');
            const renderSessionOptions = (eventType) => {
                const sessionOptions = [
                    { value: 'AM_IN', label: 'Morning Check-In (AM IN)' },
                    { value: 'AM_OUT', label: 'Morning Check-Out (AM OUT)' }
                ];

                if (eventType === 'Whole Day') {
                    sessionOptions.push(
                        { value: 'PM_IN', label: 'Afternoon Check-In (PM IN)' },
                        { value: 'PM_OUT', label: 'Afternoon Check-Out (PM OUT)' }
                    );
                }

                sessionTypeSelect.innerHTML = '';
                sessionOptions.forEach(opt => {
                    const option = document.createElement('option');
                    option.value = opt.value;
                    option.textContent = opt.label;
                    sessionTypeSelect.appendChild(option);
                });
            };

            eventSelect.addEventListener('change', () => {
                const selectedOption = eventSelect.options[eventSelect.selectedIndex];
                const selectedEventType = selectedOption?.dataset?.eventType || 'Whole Day';
                renderSessionOptions(selectedEventType);
            });

            scanForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const folderIdVal = folderId.value;
                const eventName = eventSelect.value;
                const sessionType = sessionTypeSelect.value;

                if (!eventName) {
                    alert('Please select an event before opening the scanner.');
                    return;
                }

                window.location.href = `/scanner?folderId=${folderIdVal}&eventName=${encodeURIComponent(eventName)}&sessionType=${sessionType}`;
            });
        }

        // Generate QR code for students
        if (userRole === 'student') {
            const qrContainer = document.getElementById('qrCodeContainer');
            const mmId = '<%= user.mmId %>';
            if (qrContainer && mmId) {
                fetch(`/api/student-qr/${mmId}`)
                    .then(res => res.json())
                    .then(data => {
                        const img = document.createElement('img');
                        img.src = data.qrCode;
                        img.alt = `QR Code for ${mmId}`;
                        img.style.maxWidth = '300px';
                        qrContainer.appendChild(img);
                    })
                    .catch(err => {
                        console.error('Error loading QR code:', err);
                        qrContainer.innerHTML = '<p style="color: #ff6b6b;">Failed to load QR code</p>';
                    });
            }
        }
    </script>
</body>
</html>
