<!DOCTYPE html>
<html>
<head>
    <title>BSBA-MM Sign Up</title>
    <style>
        body { font-family: sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; background: #f0f2f5; margin: 0; }
        .box { background: white; padding: 30px; border-radius: 12px; box-shadow: 0 8px 20px rgba(0,0,0,0.1); width: 320px; border-top: 6px solid #800000; text-align: center; }
        h2 { color: #800000; }
        input { width: 100%; padding: 12px; margin: 10px 0; border: 1px solid #ddd; border-radius: 6px; box-sizing: border-box; }
        button { width: 100%; padding: 12px; background: #800000; color: gold; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; width: 100%; }
    </style>
</head>
<body>
    <div class="box">
        <h2>Create Student Account</h2>
        <form action="/signup" method="POST">
            <input type="text" name="name" placeholder="Full Name (ex. Juan Dela Cruz)" required>
            <input type="text" name="studentId" placeholder="Student ID (ex. 2024-001)" required>
            <input type="password" name="password" placeholder="Create Password" required>
            <button type="submit">Register Now</button>
        </form>
        <p><a href="/login" style="text-decoration:none; color:#555; font-size:0.8em;">Back to Login</a></p>
    </div>
</body>
</html>