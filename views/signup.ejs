<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="BSBA Portal">
    <meta name="theme-color" content="#FFD700">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/assets/img/logo.jpg">
    <title>BSBA-MM Sign Up</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* Signup-specific overrides */
        body { 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            min-height: 100vh; 
            padding: 10px; 
        }
        .login-box { border-top: 6px solid #800000; }
        h2 { color: #800000; }
        input:focus, select:focus { border-color: #800000; }
        button { background: #800000; color: gold; }
        button:hover { background: #600000; }
        .info-box { background: #e3f2fd; border-left: 4px solid #2196F3; color: #1976d2; }
        .info-box div { font-family: 'Courier New', monospace; font-size: 1.3em; font-weight: 700; color: #000; }
        .input-group { margin-bottom: 15px; }
        .signup-link a { color: #800000; }
    </style>
</head>
<body>
    <div class="login-box">
        <h2>Create Account</h2>
        <form action="/signup" method="POST">
    
            <div class="info-box">
                <label>Your Assigned Student ID:</label>
                <div><%= mmId %></div>
                <small>This ID has been automatically assigned to you</small>
            </div>
            
            <input type="hidden" name="mmId" value="<%= mmId %>">
            
            <div class="input-group">
                <label for="name">Full Name</label>
                <input type="text" id="name" name="name" placeholder="Enter your full name" required>
            </div>
            
            <div class="input-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="Enter your email" required>
            </div>
            
            <div class="input-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="Enter password" required>
            </div>
            
            <div class="input-group">
                <label for="role">Select Your Role</label>
                <select id="role" name="role" required>
                    <option value="">-- Select a Role --</option>
                    <option value="student">Student</option>
                    <option value="officer">Officer</option>
                    <option value="adviser">Adviser</option>
                </select>
            </div>
            
            <button type="submit">Register</button>
        </form>
        
        <div class="signup-link">
            <p>Already have an account? <a href="/login">Back to Login</a></p>
        </div>
    </div>
    <script src="/pwa-install.js"></script>
</body>

</html>