<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="BSBA Portal">
    <meta name="theme-color" content="#FFD700">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/assets/img/logo.jpg">
    <title>BSBA-MM Sign Up</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* Signup-specific overrides */
        body { 
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            padding: 10px;
            overflow-x: hidden;
        }
        .login-box { 
            border-top: 6px solid #800000;
            width: 100%;
            max-width: 500px;
            margin: auto;
            overflow-y: auto;
        }
        h2 { color: #800000; }
        input:focus, select:focus { border-color: #800000; }
        button { background: #800000; color: gold; }
        button:hover { background: #600000; }
        .password-container {
            position: relative;
            display: flex;
            align-items: center;
        }
        .password-container input {
            flex: 1;
            padding-right: 40px;
        }
        .password-toggle-btn {
            position: absolute;
            right: 10px;
            background: none;
            border: none;
            color: #FFD700;
            cursor: pointer;
            font-size: 1.2em;
            padding: 0;
            margin: 0;
        }
        .password-toggle-btn:hover {
            background: none;
            color: #FFF;
        }
        .info-box { background: #e3f2fd; border-left: 4px solid #2196F3; color: #1976d2; }
        .info-box div { font-family: 'Courier New', monospace; font-size: 1.3em; font-weight: 700; color: #000; }
        .input-group { margin-bottom: 15px; }
        .signup-link a { color: #800000; }
        .privacy-box {
            max-width: 100%;
        }
        .privacy-box label {
            display: flex;
            align-items: center;
            gap: 10px;
            line-height: 1.4;
        }
        .modal-overlay {
            position: fixed;
            inset: 0;
            display: none;
            justify-content: center;
            align-items: center;
            background: rgba(0, 0, 0, 0.65);
            z-index: 9999;
            padding: 20px;
        }
        .modal-box {
            background: #111;
            border: 1px solid #FFD700;
            border-radius: 14px;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);
            max-width: 420px;
            width: 100%;
            padding: 24px;
            color: #fff;
            text-align: center;
        }
        .modal-box h2 {
            margin-top: 0;
            color: #FFD700;
        }
        .modal-box p {
            margin: 16px 0;
            line-height: 1.5;
            color: #e8e8e8;
        }
        .modal-actions {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 20px;
        }
        .modal-actions button {
            min-width: 130px;
            border: none;
            border-radius: 6px;
            padding: 10px 16px;
            cursor: pointer;
            font-weight: 700;
        }
        .modal-close-btn {
            background: #444;
            color: #fff;
        }
        .modal-login-btn {
            background: #FFD700;
            color: #000;
        }
        .privacy-box input[type="checkbox"] {
            width: 18px;
            height: 18px;
            min-width: 18px;
            min-height: 18px;
            margin-top: 0;
            accent-color: #FFD700;
            flex-shrink: 0;
        }
        
        /* Mobile responsive */
        @media (max-width: 480px) {
            body {
                padding: 5px;
            }
            .login-box {
                padding: 20px 15px;
                border-radius: 8px;
            }
            input, select, label {
                font-size: 16px;
            }
            .input-group {
                margin-bottom: 12px;
            }
            .info-box {
                padding: 12px;
                margin-bottom: 15px;
            }
            .privacy-box {
                max-width: 300px;
                margin: 0 auto 15px auto;
            }
            .privacy-box label {
                gap: 5px !important;
            }
            .privacy-box input[type="checkbox"] {
                margin-left: 0 !important;
                margin-right: 0 !important;
                flex-shrink: 0;
            }
        }
    </style>
</head>
<body>
    <div class="login-box">
        <% if (error) { %>
            <div style="background-color: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; padding: 12px; border-radius: 4px; margin-bottom: 15px; font-size: 0.95em;">
                <%= error %>
            </div>
        <% } %>
        
        <!-- MM-ID Display Box -->
        <div style="background: #e3f2fd; border-left: 4px solid #FFD700; color: #1976d2; padding: 12px; margin-bottom: 20px; border-radius: 4px;">
            <label style="display: block; font-weight: bold; margin-bottom: 5px;">Your Assigned Student ID:</label>
            <div style="font-family: 'Courier New', monospace; font-size: 1.3em; font-weight: 700; color: #000; margin-bottom: 5px;"><%= mmId %></div>
            <small style="color: #666;">This ID has been automatically assigned to you. Keep it safe!</small>
        </div>
        
        <form action="/signup" method="POST">
            <input type="hidden" name="mmId" value="<%= mmId %>">
            <input type="text" name="firstName" placeholder="First Name" required value="<%= typeof firstName !== 'undefined' ? firstName : '' %>">
            <input type="text" name="lastName" placeholder="Last Name" required value="<%= typeof lastName !== 'undefined' ? lastName : '' %>">
            <input type="email" name="email" placeholder="Email Address" required value="<%= typeof email !== 'undefined' ? email : '' %>">

            <select name="yearLevel" required style="background: #222; color: #FFD700;">
                <option value="" disabled <%= typeof yearLevel === 'undefined' || !yearLevel ? 'selected' : '' %>>Select your year level</option>
                <option value="1st Year" <%= typeof yearLevel !== 'undefined' && yearLevel === '1st Year' ? 'selected' : '' %>>1st Year</option>
                <option value="2nd Year" <%= typeof yearLevel !== 'undefined' && yearLevel === '2nd Year' ? 'selected' : '' %>>2nd Year</option>
                <option value="3rd Year" <%= typeof yearLevel !== 'undefined' && yearLevel === '3rd Year' ? 'selected' : '' %>>3rd Year</option>
                <option value="4th Year" <%= typeof yearLevel !== 'undefined' && yearLevel === '4th Year' ? 'selected' : '' %>>4th Year</option>
            </select>

            <div class="password-container">
                <input type="password" id="passwordInput" name="password" placeholder="Create a password" required>
                <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility()" title="Show/Hide password">
                    <i class="fas fa-eye" id="passwordIcon"></i>
                </button>
            </div>
            <select name="role" required style="background: #222; color: #FFD700;">
                <option value="" disabled <%= typeof role === 'undefined' || !role ? 'selected' : '' %>>Select your role</option>
                <option value="student" <%= typeof role !== 'undefined' && role === 'student' ? 'selected' : '' %>>Student</option>
                <option value="officer" <%= typeof role !== 'undefined' && role === 'officer' ? 'selected' : '' %>>Officer</option>
                <option value="adviser" <%= typeof role !== 'undefined' && role === 'adviser' ? 'selected' : '' %>>Adviser</option>
            </select>

            <!-- Privacy & Consent -->
            <h3 style="color: #FFD700; margin-top: 20px; margin-bottom: 15px;">Privacy & Terms</h3>
            <div class="privacy-box" style="background: #222; padding: 12px; border-radius: 4px; margin-bottom: 15px; border-left: 3px solid #FFD700;">
                <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; color: #e0e0e0; font-size: 0.95em;">
                    <input type="checkbox" name="privacyConsent" value="true" required style="width: 18px; height: 18px; accent-color: #FFD700;">
                    <span>I have read and agree to the <a href="/privacy-policy" target="_blank" style="color: #FFD700; text-decoration: none;">Privacy Policy</a>. I consent to the collection and processing of my personal data as described.</span>
                </label>
            </div>

            <button type="submit" style="display: block; margin: 25px auto 0; padding: 12px 40px; background: #FFD700; color: #000; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 1em; text-align: center;">Create Account</button>
        </form>

        <div class="signup-link" style="margin-top: 20px; text-align: center;">
            <span style="color: #666;">Already have an account?</span>
            <a href="/login" style="color: #FFD700; text-decoration: none; font-weight: bold;">Login here</a>
        </div>
    </div>

    <div id="duplicateAccountModal" class="modal-overlay" aria-hidden="true">
        <div class="modal-box">
            <h2>Account Already Exists</h2>
            <p>An account for <strong id="duplicateStudentName"><%= typeof duplicateName !== 'undefined' ? duplicateName : '' %></strong> already exists.</p>
            <p id="duplicateModalMessage"><%= typeof duplicateModalMessage !== 'undefined' && duplicateModalMessage ? duplicateModalMessage : 'Please log in if this is your account.' %></p>
            <div class="modal-actions">
                <button type="button" class="modal-close-btn" onclick="closeDuplicateAccountModal()">Close</button>
                <button type="button" class="modal-login-btn" onclick="window.location.href='/login'">Go to Login</button>
            </div>
        </div>
    </div>

    <script src="/pwa-install.js"></script>
    <script>
        const duplicateSignupName = <%- JSON.stringify(typeof duplicateName !== 'undefined' ? duplicateName : null) %>;
        const duplicateSignupMessage = <%- JSON.stringify(typeof duplicateModalMessage !== 'undefined' ? duplicateModalMessage : '') %>;

        function openDuplicateAccountModal() {
            const overlay = document.getElementById('duplicateAccountModal');
            if (!overlay) return;
            overlay.style.display = 'flex';
            overlay.setAttribute('aria-hidden', 'false');
        }

        function closeDuplicateAccountModal() {
            const overlay = document.getElementById('duplicateAccountModal');
            if (!overlay) return;
            overlay.style.display = 'none';
            overlay.setAttribute('aria-hidden', 'true');
        }

        function togglePasswordVisibility() {
            const passwordInput = document.getElementById('passwordInput');
            const passwordIcon = document.getElementById('passwordIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                passwordIcon.classList.remove('fa-eye');
                passwordIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                passwordIcon.classList.remove('fa-eye-slash');
                passwordIcon.classList.add('fa-eye');
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            if (duplicateSignupName) {
                document.getElementById('duplicateStudentName').textContent = duplicateSignupName;
                document.getElementById('duplicateModalMessage').textContent = duplicateSignupMessage || 'Please log in if this is your account.';
                openDuplicateAccountModal();
            }
        });
    </script>
<%- include('./_footer.ejs') %>
</body>
</html>
