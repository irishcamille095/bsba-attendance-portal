<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="BSBA Portal">
    <meta name="theme-color" content="#FFD700">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/assets/img/logo.jpg">
    <title>BSBA-MM Sign Up</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* Signup-specific overrides */
        body { 
            display: flex; 
            justify-content: center; 
            align-items: flex-start; 
            min-height: 100vh; 
            padding: 10px; 
            overflow-x: hidden;
        }
        .login-box { 
            border-top: 6px solid #800000;
            width: 100%;
            max-width: 500px;
            overflow-y: auto;
        }
        h2 { color: #800000; }
        input:focus, select:focus { border-color: #800000; }
        button { background: #800000; color: gold; }
        button:hover { background: #600000; }
        .info-box { background: #e3f2fd; border-left: 4px solid #2196F3; color: #1976d2; }
        .info-box div { font-family: 'Courier New', monospace; font-size: 1.3em; font-weight: 700; color: #000; }
        .input-group { margin-bottom: 15px; }
        .signup-link a { color: #800000; }
        
        /* Mobile responsive */
        @media (max-width: 480px) {
            body {
                align-items: flex-start;
                padding: 5px;
            }
            .login-box {
                padding: 20px 15px;
                border-radius: 8px;
            }
            input, select, label {
                font-size: 16px;
            }
            .input-group {
                margin-bottom: 12px;
            }
            .info-box {
                padding: 12px;
                margin-bottom: 15px;
            }
        }
    </style>
</head>
<body>
    <div class="login-box">
        <h2>Create Account</h2>
        <form action="/signup" method="POST">
    
            <div class="info-box">
                <label>Your Assigned Student ID:</label>
                <div><%= mmId %></div>
                <small>This ID has been automatically assigned to you</small>
            </div>
            
            <input type="hidden" name="mmId" value="<%= mmId %>">
            
            <div class="input-group">
                <label for="firstName">First Name</label>
                <input type="text" id="firstName" name="firstName" placeholder="Enter your first name" required>
            </div>
            
            <div class="input-group">
                <label for="lastName">Last Name</label>
                <input type="text" id="lastName" name="lastName" placeholder="Enter your last name" required>
            </div>
            
            <div class="input-group">
                <label for="middleName">Middle Name (Optional)</label>
                <input type="text" id="middleName" name="middleName" placeholder="Enter your middle name (optional)">
            </div>
            
            <div class="input-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="Enter your email" required>
            </div>
            
            <div class="input-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="Enter password" required>
            </div>
            
            <div class="input-group">
                <label for="role">Select Your Role</label>
                <select id="role" name="role" required onchange="updateYearLevelRequirement()">
                    <option value="">-- Select a Role --</option>
                    <option value="student">Student</option>
                    <option value="officer">Officer</option>
                    <option value="adviser">Adviser</option>
                </select>
            </div>
            
            <div class="input-group">
                <label for="yearLevel">Year Level <span id="yearLevelRequired" style="color: red;">*</span></label>
                <select id="yearLevel" name="yearLevel" required>
                    <option value="">-- Select Year Level --</option>
                    <option value="1st Year">1st Year</option>
                    <option value="2nd Year">2nd Year</option>
                    <option value="3rd Year">3rd Year</option>
                    <option value="4th Year">4th Year</option>
                </select>
                <small id="yearLevelHint" style="color: #666;">Select your academic year level</small>
            </div>
            
            <button type="submit">Register</button>
        </form>
        
        <div class="signup-link">
            <p>Already have an account? <a href="/login">Back to Login</a></p>
        </div>
    </div>
    <script src="/pwa-install.js"></script>
    <script>
        function updateYearLevelRequirement() {
            const role = document.getElementById('role').value;
            const yearLevelSelect = document.getElementById('yearLevel');
            const yearLevelRequired = document.getElementById('yearLevelRequired');
            const yearLevelHint = document.getElementById('yearLevelHint');

            if (role === 'adviser') {
                // Advisers don't need to select a year level
                yearLevelSelect.disabled = true;
                yearLevelSelect.value = '';
                yearLevelSelect.required = false;
                yearLevelRequired.style.display = 'none';
                yearLevelHint.textContent = 'Not applicable for advisers';
                yearLevelHint.style.color = '#999';
            } else if (role === 'student' || role === 'officer') {
                // Students and Officers must select a year level
                yearLevelSelect.disabled = false;
                yearLevelSelect.required = true;
                yearLevelRequired.style.display = 'inline';
                yearLevelHint.textContent = 'Select your academic year level';
                yearLevelHint.style.color = '#666';
            } else {
                // No role selected yet
                yearLevelSelect.disabled = true;
                yearLevelSelect.required = false;
                yearLevelRequired.style.display = 'inline';
                yearLevelHint.textContent = 'Select your role first';
                yearLevelHint.style.color = '#999';
            }
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', updateYearLevelRequirement);
    </script>

</html>