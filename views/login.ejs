<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="BSBA Portal">
    <meta name="theme-color" content="#FFD700">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/assets/img/logo.jpg">
    <title>BSBA-MM Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* Login-specific overrides */
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .login-box {
            margin: auto;
            width: 100%;
            max-width: 400px;
        }
        .signup-link { margin-top: 20px; font-size: 0.95em; }
        .signup-link a { color: #ffcc00; font-weight: bold; }

        /* Password visibility toggle */
        .password-input-group {
            position: relative;
            display: flex;
            align-items: center;
        }

        .password-input-group input {
            flex: 1;
            padding-right: 40px;
        }

        .password-toggle-btn {
            position: absolute;
            right: 12px;
            background: none;
            border: none;
            color: #666;
            cursor: pointer;
            padding: 5px 10px;
            font-size: 1.2em;
            transition: color 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .password-toggle-btn:hover {
            color: #ffcc00;
        }
    </style>
</head>
<body>

    <div class="login-box">
    <h2>BSBA-MM Portal</h2>
    <% if (error) { %>
        <div style="background-color: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; padding: 12px; border-radius: 4px; margin-bottom: 15px; font-size: 0.95em;">
            <%= error %>
        </div>
    <% } %>
    <form action="/login" method="POST">
        <input type="email" name="username" placeholder="Email Address" required>
        <div class="password-input-group">
            <input type="password" id="passwordInput" name="password" placeholder="Password" required>
            <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility()">
                <i class="fas fa-eye" id="passwordIcon"></i>
            </button>
        </div>
        <button type="submit">Login</button>
    </form>
    <div class="signup-link">
        <span style="color: #666;">No account?</span>
        <a href="/signup">Sign up here</a>
    </div>
    <p>Forgot password? 
   <a href="/request-reset" style="color: #007bff; text-decoration: none;">Click here to notify an Officer</a>
</p>


</div>

<script src="/pwa-install.js"></script>
<script>
    function togglePasswordVisibility() {
        const passwordInput = document.getElementById('passwordInput');
        const passwordIcon = document.getElementById('passwordIcon');

        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            passwordIcon.classList.remove('fa-eye');
            passwordIcon.classList.add('fa-eye-slash');
        } else {
            passwordInput.type = 'password';
            passwordIcon.classList.remove('fa-eye-slash');
            passwordIcon.classList.add('fa-eye');
        }
    }
</script>
<%- include('./_footer.ejs') %>
</body>

</html>
