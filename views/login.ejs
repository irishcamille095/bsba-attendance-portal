<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="BSBA Portal">
    <meta name="theme-color" content="#FFD700">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/assets/img/logo.png">
    <title>BSBA-MM Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* Login-specific overrides */
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }
        .signup-link { margin-top: 20px; font-size: 0.95em; }
        .signup-link a { color: #ffcc00; font-weight: bold; }
    </style>
</head>
<body>

    <div class="login-box">
    <h2>BSBA-MM Portal</h2>
    <form action="/login" method="POST">
        <input type="email" name="username" placeholder="Email Address" required>
        <input type="password" name="password" placeholder="Password" required>
        <button type="submit">Login</button>
    </form>
    <div class="signup-link">
        <span style="color: #666;">No account?</span>
        <a href="/signup">Sign up here</a>
    </div>
    <p>Forgot password? 
   <a href="/request-reset" style="color: #007bff; text-decoration: none;">Click here to notify an Officer</a>
</p>


</div>
<script src="/pwa-install.js"></script>
</body>

</html>
