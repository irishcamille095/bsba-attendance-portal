        <div style="background: #1a1a1a; border: 2px solid #FF9800; padding: 30px; border-radius: 8px; max-width: 400px; width: 90%; color: #e0e0e0;">
            <h3 style="color: #FF9800; margin-bottom: 15px;"><i class="fas fa-handshake"></i> Manage Your Consent</h3>
            <div id="consentStatusContainer" style="background: #222; padding: 15px; border-radius: 4px; margin-bottom: 20px;">
                <p style="margin: 0 0 10px 0; color: #999;">Status: <span id="consentStatus" style="color: #FF9800; font-weight: bold;">Loading...</span></p>
                <p id="consentDateInfo" style="margin: 0; color: #999; font-size: 0.9em;"></p>
            </div>
            <p style="margin-bottom: 15px; font-size: 0.95em;">
                Your data processing consent under the Data Privacy Act allows us to:
            </p>
            <ul style="margin: 0 0 15px 20px; padding: 0; color: #999; font-size: 0.9em;">
                <li style="margin-bottom: 5px;">Store and manage your personal information</li>
                <li style="margin-bottom: 5px;">Track attendance and event participation</li>
