<script>
    function toggleSidebar() {
        // This looks for the div with class="sidebar" and toggles the "active" style
        const sidebar = document.querySelector('.sidebar');
        sidebar.classList.toggle('active');
    }

    // This closes the sidebar if you tap anywhere on the page while it's open
    document.addEventListener('click', function(event) {
        const sidebar = document.querySelector('.sidebar');
        const headerBtn = document.querySelector('header button');
        
        if (window.innerWidth <= 768 && 
            sidebar.classList.contains('active') && 
            !sidebar.contains(event.target) && 
            !headerBtn.contains(event.target)) {
            sidebar.classList.remove('active');
        }
    });

    // 1. Get the current URL search parameters
    const params = new URLSearchParams(window.location.search);
    
    // 2. Check if 'success' is equal to 'true'
    if (params.has('success') && params.get('success') === 'true') {
        // 4. Remove the '?success=true' from the URL without reloading the page
        const cleanUrl = window.location.origin + window.location.pathname;
        window.history.replaceState({}, document.title, cleanUrl);
    }

    function toggleNameSection() {
        const section = document.getElementById('nameSection');
        if (!section) {
            alert('Error: nameSection not found');
            return;
        }
        
        if (section.style.display === 'none' || section.style.display === '') {
            section.style.display = 'block';
            console.log('Name section is now VISIBLE');
        } else {
            section.style.display = 'none';
            console.log('Name section is now HIDDEN');
        }
    }

    function togglePasswordSection() {
        const section = document.getElementById('passwordSection');
        if (!section) {
            alert('Error: passwordSection not found');
            return;
        }
        
        if (section.style.display === 'none' || section.style.display === '') {
            section.style.display = 'block';
            console.log('Password section is now VISIBLE');
        } else {
            section.style.display = 'none';
            console.log('Password section is now HIDDEN');
        }
    }

    function toggleEditMode() {
        const displayView = document.getElementById('displayView');
        const editView = document.getElementById('editView');
        
        if (editView.style.display === 'none' || editView.style.display === '') {
            displayView.style.display = 'none';
            editView.style.display = 'block';
        } else {
            displayView.style.display = 'block';
            editView.style.display = 'none';
        }
    }

    // Profile photo preview
    document.addEventListener('DOMContentLoaded', function() {
        const profilePhotoInput = document.getElementById('profilePhoto');
        if (profilePhotoInput) {
            profilePhotoInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(event) {
                        const preview = document.getElementById('profilePhotoPreview');
                        if (!preview) return;

                        const imageSrc = event.target.result;
                        if (preview.tagName === 'IMG') {
                            preview.src = imageSrc;
                        } else {
                            preview.innerHTML = '<img src="' + imageSrc + '" alt="Profile Photo" style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover; border: 3px solid #FFD700;">';
                        }
                    };
                    reader.readAsDataURL(file);
                }
            });
        }
    });

    function validateEditForm(event) {
        const newPass = document.getElementById('newPass');
        const confirmPass = document.getElementById('confirmPass');
        
        if (newPass && confirmPass) {
            const newPassValue = newPass.value.trim();
            const confirmPassValue = confirmPass.value.trim();
            
            // If one password field is filled, both must be filled
            if ((newPassValue || confirmPassValue) && (!newPassValue || !confirmPassValue)) {
                alert('Please fill in both password fields or leave both blank.');
                event.preventDefault();
                return false;
            }
            
            // If both are filled, they must match
            if (newPassValue && confirmPassValue && newPassValue !== confirmPassValue) {
                alert('Passwords do not match.');
                event.preventDefault();
                return false;
            }
            
            // If both are filled, check minimum length
            if (newPassValue && newPassValue.length < 6) {
                alert('Password must be at least 6 characters long.');
                event.preventDefault();
                return false;
            }
        }
        
        return true;
    }

    function validatePasswords() {
        const newPass = document.getElementById('newPass').value;
        const confirmPass = document.getElementById('confirmPass').value;
        
        if (newPass !== confirmPass) {
            alert('Passwords do not match!');
            return false;
        }
        
        if (newPass.length < 6) {
            alert('Password must be at least 6 characters long!');
            return false;
        }
        
        return true;
    }

    // Toggle password visibility for adviser override password
    let passwordVisible = false;
    function togglePasswordVisibility() {
        const passwordInput = document.getElementById('passwordDisplay');
        const eyeIcon = document.getElementById('eyeIcon');
        const button = event.target.closest('button');
        
        passwordVisible = !passwordVisible;
        
        if (passwordVisible) {
            passwordInput.type = 'text';
            eyeIcon.classList.remove('fa-eye');
            eyeIcon.classList.add('fa-eye-slash');
            button.innerHTML = '<i class="fas fa-eye-slash"></i> Hide';
        } else {
            passwordInput.type = 'password';
            eyeIcon.classList.remove('fa-eye-slash');
            eyeIcon.classList.add('fa-eye');
            button.innerHTML = '<i class="fas fa-eye"></i> Show';
        }
    }

</script>

<!-- Privacy & Data Rights Section -->
<div style="background: linear-gradient(135deg, #1a1a1a 0%, #222 100%); padding: 25px; border-radius: 8px; border-left: 5px solid #FFD700; margin-top: 30px; margin-bottom: 30px;">
    <h2 style="color: #FFD700; margin-bottom: 20px;"><i class="fas fa-shield-alt"></i> Privacy & Data Rights</h2>
    <p style="color: #e0e0e0; margin-bottom: 20px;">
        Under the Data Privacy Act of the Philippines, you have the right to access, correct, delete, and control your personal data. Use the options below to manage your privacy.
    </p>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
        <!-- Access Data -->
        <button onclick="openDataAccessModal()" style="background: #1e1e1e; border: 2px solid #4CAF50; color: #4CAF50; padding: 15px; border-radius: 6px; cursor: pointer; font-weight: bold; transition: all 0.3s; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; min-height: 100px;">
            <i class="fas fa-download" style="font-size: 1.5em;"></i>
            <span>Download My Data</span>
            <small style="color: #999; font-size: 0.8em;">Get a copy of your info</small>
        </button>

        <!-- Consent Management -->
        <button onclick="openConsentModal()" style="background: #1e1e1e; border: 2px solid #FF9800; color: #FF9800; padding: 15px; border-radius: 6px; cursor: pointer; font-weight: bold; transition: all 0.3s; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; min-height: 100px;">
            <i class="fas fa-handshake" style="font-size: 1.5em;"></i>
            <span>Manage Consent</span>
            <small style="color: #999; font-size: 0.8em;">Control data processing</small>
        </button>

        <!-- Delete Account -->
        <button onclick="openDeletionModal()" style="background: #1e1e1e; border: 2px solid #f44336; color: #f44336; padding: 15px; border-radius: 6px; cursor: pointer; font-weight: bold; transition: all 0.3s; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; min-height: 100px;">
            <i class="fas fa-trash-alt" style="font-size: 1.5em;"></i>
            <span>Delete Account</span>
            <small style="color: #999; font-size: 0.8em;">Permanent account removal</small>
        </button>

        <!-- Privacy Policy -->
        <button onclick="window.open('/privacy-policy', '_blank')" style="background: #1e1e1e; border: 2px solid #FFD700; color: #FFD700; padding: 15px; border-radius: 6px; cursor: pointer; font-weight: bold; transition: all 0.3s; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; min-height: 100px;">
            <i class="fas fa-file-alt" style="font-size: 1.5em;"></i>
            <span>Privacy Policy</span>
            <small style="color: #999; font-size: 0.8em;">View our data practices</small>
        </button>
    </div>

    <p style="color: #999; font-size: 0.85em; margin-top: 20px; text-align: center;">For questions about your data, contact: <strong>psunarrabsbamm@psu.palawan.edu.ph</strong></p>
</div>

<script src="/document-notifications.js"></script>
<script>
    document.documentElement.setAttribute('data-user-role', '<%= user.role %>');

    // Privacy & Data Rights Modal Functions
    function openDataAccessModal() {
        document.getElementById('dataAccessModal').style.display = 'flex';
    }

    function closeDataAccessModal() {
        document.getElementById('dataAccessModal').style.display = 'none';
    }

    function openDeletionModal() {
        // Reset form fields
        document.getElementById('deleteConfirmEmail').value = '';
        document.getElementById('deleteConfirmPhrase').value = '';
        document.getElementById('deleteValidationMessage').innerHTML = '';
        
        // Reset button state
        const submitBtn = document.getElementById('deletionConfirmBtn');
        submitBtn.disabled = true;
        submitBtn.style.background = '#999';
        submitBtn.style.cursor = 'not-allowed';
        submitBtn.style.opacity = '0.5';
        
        // Show modal
        document.getElementById('deletionModal').style.display = 'flex';
    }

    function closeDeletionModal() {
        // Clear form fields
        document.getElementById('deleteConfirmEmail').value = '';
        document.getElementById('deleteConfirmPhrase').value = '';
        document.getElementById('deleteValidationMessage').innerHTML = '';
        document.getElementById('deletionModal').style.display = 'none';
    }

    function openConsentModal() {
        document.getElementById('consentModal').style.display = 'flex';
        loadConsentStatus();
    }

    function closeConsentModal() {
        document.getElementById('consentModal').style.display = 'none';
    }

    function submitDataAccessRequest() {
        fetch('/api/submit-data-request', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ requestType: 'data_access' })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showSuccessNotification('Data Access Request Submitted', 'Your request has been submitted. You will receive your personal data at your registered email within 30 days.');
                closeDataAccessModal();
                loadDataRequests();
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(err => {
            console.error('Error:', err);
            alert('Error submitting request');
        });
    }

    function validateDeletionForm() {
        const email = document.getElementById('deleteConfirmEmail').value.trim();
        const phrase = document.getElementById('deleteConfirmPhrase').value.trim().toUpperCase();
        const userEmail = '<%= user.email %>';
        const messageEl = document.getElementById('deleteValidationMessage');
        const submitBtn = document.getElementById('deletionConfirmBtn');
        
        let isValid = false;
        let validationMessages = [];
        
        // Validate email
        if (!email) {
            validationMessages.push('❌ Enter your email address');
        } else if (email !== userEmail) {
            validationMessages.push('❌ Email does not match');
        } else {
            validationMessages.push('✓ Email verified');
        }
        
        // Validate confirmation phrase
        if (!phrase) {
            validationMessages.push('❌ Type the confirmation phrase');
        } else if (phrase !== 'DELETE MY ACCOUNT') {
            validationMessages.push('❌ Confirmation phrase is incorrect');
        } else {
            validationMessages.push('✓ Confirmation phrase verified');
        }
        
        // Check if all validations pass
        isValid = email === userEmail && phrase === 'DELETE MY ACCOUNT';
        
        // Update message display
        messageEl.innerHTML = validationMessages.map(msg => 
            `<div style="color: ${msg.includes('✓') ? '#4CAF50' : '#f44336'}; margin-bottom: 3px;">${msg}</div>`
        ).join('');
        
        // Update button state
        if (isValid) {
            submitBtn.disabled = false;
            submitBtn.style.background = '#f44336';
            submitBtn.style.cursor = 'pointer';
            submitBtn.style.opacity = '1';
        } else {
            submitBtn.disabled = true;
            submitBtn.style.background = '#999';
            submitBtn.style.cursor = 'not-allowed';
            submitBtn.style.opacity = '0.5';
        }
    }

    function submitDeletionRequest() {
        const email = document.getElementById('deleteConfirmEmail').value.trim();
        const phrase = document.getElementById('deleteConfirmPhrase').value.trim().toUpperCase();
        const userEmail = '<%= user.email %>';
        
        // Final validation
        if (!email || email !== userEmail) {
            alert('❌ Email verification failed. Please check your email address.');
            return;
        }

        if (!phrase || phrase !== 'DELETE MY ACCOUNT') {
            alert('❌ Confirmation phrase is incorrect. Please type exactly: DELETE MY ACCOUNT');
            return;
        }

        // Show final confirmation modal instead of browser confirm
        document.getElementById('finalDeletionConfirmModal').style.display = 'flex';
    }

    function cancelFinalDeletion() {
        // Close the final confirmation modal
        document.getElementById('finalDeletionConfirmModal').style.display = 'none';
    }

    function confirmDeletion() {
        const submitBtn = document.getElementById('finalDeleteBtn');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

        fetch('/api/submit-data-request', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ requestType: 'data_deletion' })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Close both modals
                document.getElementById('finalDeletionConfirmModal').style.display = 'none';
                document.getElementById('deletionModal').style.display = 'none';
                
                // Clear form
                document.getElementById('deleteConfirmEmail').value = '';
                document.getElementById('deleteConfirmPhrase').value = '';
                
                showSuccessNotification('Deletion Request Submitted', 'Your account deletion request has been submitted. Your account will be deleted within 30 days. Until then, you can log in with your credentials.');
                loadDataRequests();
            } else {
                alert('Error: ' + data.message);
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        })
        .catch(err => {
            console.error('Error:', err);
            alert('Error submitting request');
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        });
    }

    function showSuccessNotification(title, message) {
        const notification = document.createElement('div');
        notification.style.cssText = `
            position: fixed;
            top: 20px;
            right: 20px;
            background: #1a1a1a;
            border: 2px solid #4CAF50;
            border-radius: 8px;
            padding: 20px;
            color: #e0e0e0;
            z-index: 5000;
            max-width: 300px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        `;
        notification.innerHTML = `
            <p style="margin: 0 0 10px 0; color: #4CAF50; font-weight: bold;">✓ ${title}</p>
            <p style="margin: 0; font-size: 0.9em; color: #999;">${message}</p>
        `;
        document.body.appendChild(notification);
        setTimeout(() => {
            notification.remove();
        }, 4000);
    }

    function loadConsentStatus() {
        fetch('/api/consent-status')
            .then(response => response.json())
            .then(data => {
                const statusSpan = document.getElementById('consentStatus');
                const dateInfo = document.getElementById('consentDateInfo');
                const actionBtn = document.getElementById('consentActionBtn');

                if (data.consentRevoked) {
                    statusSpan.textContent = 'WITHDRAWN';
                    statusSpan.style.color = '#f44336';
                    dateInfo.textContent = `Withdrawn: ${new Date(data.revokedDate).toLocaleDateString()}`;
                    actionBtn.textContent = '✓ Re-Accept Consent';
                    actionBtn.style.background = '#4CAF50';
                } else if (data.hasConsent) {
                    statusSpan.textContent = 'ACTIVE';
                    statusSpan.style.color = '#4CAF50';
                    dateInfo.textContent = `Accepted: ${new Date(data.consentDate).toLocaleDateString()}`;
                    actionBtn.textContent = '✗ Withdraw Consent';
                    actionBtn.style.background = '#f44336';
                } else {
                    statusSpan.textContent = 'NO CONSENT';
                    statusSpan.style.color = '#FF9800';
                    dateInfo.textContent = 'You have not provided consent yet';
                    actionBtn.textContent = '✓ Accept Consent';
                    actionBtn.style.background = '#4CAF50';
                }
            })
            .catch(err => {
                console.error('Error loading consent status:', err);
                document.getElementById('consentStatus').textContent = 'ERROR';
            });
    }

    function toggleConsent() {
        const statusSpan = document.getElementById('consentStatus');
        const isWithdrawn = statusSpan.textContent === 'WITHDRAWN';

        if (isWithdrawn) {
            // Re-accept consent
            fetch('/api/accept-consent', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showSuccessNotification('Consent Accepted', data.message);
                    setTimeout(() => loadConsentStatus(), 500);
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(err => {
                console.error('Error:', err);
                alert('Error accepting consent');
            });
        } else {
            // Withdraw consent
            const reason = prompt('Why are you withdrawing your consent? (optional)', '');
            if (reason === null) return; // User cancelled

            fetch('/api/withdraw-consent', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason: reason })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showSuccessNotification('Consent Withdrawn', data.message);
                    setTimeout(() => loadConsentStatus(), 500);
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(err => {
                console.error('Error:', err);
                alert('Error withdrawing consent');
            });
        }
    }

    function loadDataRequests() {
        fetch('/api/my-data-requests')
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Optionally refresh the page or update a requests list
                    console.log('Data requests loaded:', data.requests);
                }
            })
            .catch(err => console.error('Error loading requests:', err));
    }

    // Close modals when clicking outside
    window.addEventListener('click', function(event) {
        const dataAccessModal = document.getElementById('dataAccessModal');
        const deletionModal = document.getElementById('deletionModal');
        const consentModal = document.getElementById('consentModal');

        if (event.target === dataAccessModal) {
            closeDataAccessModal();
        }
        if (event.target === deletionModal) {
            closeDeletionModal();
        }
        if (event.target === consentModal) {
            closeConsentModal();
        }
    });
</script>

</body>

</html>
