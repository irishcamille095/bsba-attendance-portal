<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Account</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* My-account-specific overrides */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body { 
            font-family: 'Inter', 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #121212;
            display: flex;
        }

        /* Sidebar */
        .sidebar { 
            width: 250px;
            background: #000;
            color: #FFD700;
            height: 100vh;
            position: fixed;
            padding: 20px;
            border-right: 4px solid #FFD700;
            overflow-y: auto;
        }

        .sidebar h2 {
            border-bottom: 2px solid #FFD700;
            padding-bottom: 10px;
            text-align: center;
            margin-bottom: 20px;
        }

        .sidebar p {
            color: #fff;
            margin-bottom: 8px;
        }

        .logout-btn {
            background: #FFD700;
            color: #000;
            border: none;
            padding: 12px;
            width: 100%;
            margin-top: 30px;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .logout-btn:hover {
            background: #ffd700;
        }

        /* Main Content */
        .content {
            flex: 1;
            margin-left: 290px;
            padding: 30px;
        }
        
        .card { 
            max-width: 600px;
            margin: 20px auto;
            background: #1e1e1e;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
            border: 1px solid #FFD700;
        }
        
        .info-group { 
            margin-bottom: 20px;
        }
        
        label { 
            font-weight: 700;
            color: #FFD700;
            display: block;
            margin-bottom: 8px;
            font-size: 0.95em;
        }
        
        input[type="text"], 
        input[type="password"],
        input[type="file"] { 
            width: 100%;
            padding: 12px;
            border: 2px solid #2d2d2d;
            border-radius: 8px;
            box-sizing: border-box;
            font-family: inherit;
            font-size: 1em;
            transition: all 0.3s ease;
            background-color: #252525;
            color: #E0E0E0;
        }
        
        input[type="text"]:focus,
        input[type="password"]:focus,
        input[type="file"]:focus {
            outline: none;
            border-color: #FFD700;
            box-shadow: 0 0 0 3px rgba(255, 215, 0, 0.2);
            background-color: #2a2a2a;
        }
        
        input[type="text"]:disabled {
            background: #1a1a1a;
            cursor: not-allowed;
            color: #E0E0E0;
        }
        
        .btn-update { 
            background: #FFD700;
            color: #000;
            border: none;
            padding: 14px;
            width: 100%;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 700;
            margin-top: 10px;
            transition: all 0.3s ease;
            font-size: 1em;
        }
        
        .btn-update:hover {
            background: #ffd700;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(255, 215, 0, 0.3);
        }
        
        .btn-back { 
            display: inline-block;
            margin-bottom: 20px;
            color: #FFD700;
            text-decoration: none;
            font-weight: 700;
            font-size: 1em;
            transition: all 0.3s ease;
            background: #000;
            border: 2px solid #FFD700;
            padding: 12px 20px;
            border-radius: 8px;
        }
        
        .btn-back:hover {
            background: #FFD700;
            color: #000;
        }
        
        h2 {
            color: #E0E0E0;
            margin-bottom: 15px;
            margin-top: 15px;
            font-size: 1.8em;
        }
        
        h3 {
            color: #E0E0E0;
            font-size: 1.1em;
            margin-top: 25px;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 2px solid #FFD700;
        }
        
        .role-badge {
            display: inline-block;
            background: #FFD700;
            color: #000;
            padding: 8px 16px;
            border-radius: 25px;
            font-size: 0.85rem;
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 20px;
        }
        
        .success-message {
            background-color: rgba(76, 175, 80, 0.2);
            color: #90EE90;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            border: 2px solid #4CAF50;
            text-align: center;
            font-weight: 600;
            animation: slideDown 0.3s ease;
        }
        
        .section-divider {
            border: 0;
            border-top: 2px solid #2d2d2d;
            margin: 30px 0;
        }
        
        .file-input-label {
            display: inline-block;
            padding: 12px 20px;
            background: #FFD700;
            color: #000;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            margin-top: 8px;
        }
        
        .file-input-label:hover {
            background: #ffd700;
            transform: translateY(-2px);
        }
        
        input[type="file"] {
            display: none;
        }
        
        .file-name {
            display: block;
            margin-top: 10px;
            color: #A0A0A0;
            font-size: 0.9em;
        }
        
        .cor-info {
            background: rgba(255, 215, 0, 0.1);
            padding: 15px;
            border-radius: 8px;
            border-left: 4px solid #FFD700;
            margin-bottom: 15px;
            font-size: 0.95em;
            color: #E0E0E0;
        }

        .cor-uploaded {
            background: rgba(76, 175, 80, 0.1);
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 15px;
            border-left: 4px solid #4CAF50;
            color: #E0E0E0;
        }

        .cor-uploaded a {
            color: #FFD700;
            font-weight: 600;
        }

        .cor-uploaded a:hover {
            text-decoration: underline;
        }

        @media (max-width: 768px) {
            body { 
                display: block; 
            }

            .sidebar {
                position: fixed;
                left: 0;
                top: 50px;
                width: 100%;
                height: auto;
                max-height: calc(100vh - 50px);
                transform: translateX(-100%);
                transition: transform 0.3s ease;
                z-index: 2000;
                padding: 15px;
                border-right: none;
                border-bottom: 2px solid #FFD700;
                overflow-y: auto;
            }

            .sidebar.active {
                transform: translateX(0);
            }

            .content {
                margin-left: 0;
                padding: 0;
            }

            .card {
                padding: 20px;
                margin: 20px auto;
            }
            
            h2 {
                font-size: 1.5em;
            }

            .btn-back {
                max-width: 100%;
            }
        }

        /* On Desktop: Show sidebar normally */
        @media (min-width: 769px) {
            .sidebar {
                transform: translateX(0) !important;
                position: fixed !important;
            }
            header button {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="sidebar" id="sidebar">
        <h2 style="color: #FFD700;">BSBA-MM</h2>
        <p style="color: #fff;">User: <strong><%= user.name %></strong></p>
        <p style="color: #fff;">Role: <strong><%= user.role %></strong></p>
        
        <hr style="border: 1px solid #FFD700;">
        
        <form action="/logout" method="POST" style="margin-top: 30px; display: block !important;">
            <button type="submit" class="logout-btn" style="width: 100%; padding: 12px; background: #FFD700; color: #000; border: none; border-radius: 5px; font-weight: bold; cursor: pointer; display: block;">
                Logout
            </button>
        </form>
    </div>

    <div class="content">
        <header style="background: #FFD700; color: #121212; padding: 12px 15px; display: flex; align-items: center; z-index: 1000; box-shadow: 0 2px 8px rgba(0,0,0,0.2); position: sticky; top: 0; margin: -30px -30px 0 -30px; padding: 12px 45px;">
            <button onclick="toggleSidebar()" style="background: rgba(18,18,18,0.15); border: 1px solid rgba(18,18,18,0.3); color: #121212; padding: 8px 12px; border-radius: 8px; cursor: pointer; margin-right: 15px; font-size: 1.2rem;">
                <i class="fas fa-bars"></i>
            </button>
            <h1 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: #121212;">Marketing Management Portal</h1>
        </header>
        <div class="card">
            <a href="/dashboard" class="btn-back">← Back to Menu</a>
            <h2>My Account Details</h2>
        
        <div class="role-badge">
            <%= user.role %>
        </div>

        <div class="info-group">
            <label>Account Name:</label>
            <input type="text" value="<%= user.name %>" disabled>
        </div>

        <div class="info-group">
            <label>Email Address:</label>
            <input type="text" value="<%= user.username %>" disabled>
        </div>

        <div class="info-group">
            <label>Student ID (MM-ID):</label>
            <input type="text" value="<%= user.mmId || 'N/A' %>" disabled>
        </div>

        <% if (showSuccess) { %>
            <div class="success-message">
                ✓ Password updated successfully!
            </div>
        <% } %>

        <% if (cor_success) { %>
            <div class="success-message">
                ✓ Certificate of Registration (COR) uploaded successfully!
            </div>
        <% } %>

        <hr class="section-divider">

        <!-- Password Update Section -->
        <h3>Change Password</h3>
        <form action="/update-password" method="POST" onsubmit="return validatePasswords()">
            <div class="info-group">
                <label>New Password:</label>
                <input type="password" id="newPass" name="newPassword" placeholder="Enter new password" required>
            </div>

            <div class="info-group">
                <label>Confirm New Password:</label>
                <input type="password" id="confirmPass" placeholder="Re-type password" required>
            </div>

            <button type="submit" class="btn-update">Update Password</button>
        </form>

        <hr class="section-divider">

        <!-- COR Upload Section -->
        <h3>Certificate of Registration (COR)</h3>
        <div class="cor-info">
            Please upload a PDF or image of your Certificate of Registration. This will be visible to Officers and Advisers for verification purposes.
        </div>

        <% if (user.corPath) { %>
            <div class="cor-uploaded">
                ✓ COR already uploaded: <a href="<%= user.corPath %>" target="_blank">View File</a>
            </div>
        <% } %>

        <form action="/upload-cor" method="POST" enctype="multipart/form-data">
            <div class="info-group">
                <label for="cor-file">Upload COR (PDF or Image):</label>
                <input type="file" id="cor-file" name="cor" accept=".pdf,.jpg,.jpeg,.png,.gif" required>
                <label for="cor-file" class="file-input-label">Choose File</label>
                <span class="file-name" id="file-name">No file selected</span>
            </div>

            <button type="submit" class="btn-update">Upload COR</button>
        </form>
    </div>
    </div>

<script>
    function toggleSidebar() {
        // This looks for the div with class="sidebar" and toggles the "active" style
        const sidebar = document.querySelector('.sidebar');
        sidebar.classList.toggle('active');
    }

    // This closes the sidebar if you tap anywhere on the page while it's open
    document.addEventListener('click', function(event) {
        const sidebar = document.querySelector('.sidebar');
        const headerBtn = document.querySelector('header button');
        
        if (window.innerWidth <= 768 && 
            sidebar.classList.contains('active') && 
            !sidebar.contains(event.target) && 
            !headerBtn.contains(event.target)) {
            sidebar.classList.remove('active');
        }
    });

    // Show file name when selected
    document.getElementById('cor-file').addEventListener('change', function(e) {
        const fileName = e.target.files[0]?.name || 'No file selected';
        document.getElementById('file-name').textContent = fileName;
    });

    // 1. Get the current URL search parameters
    const params = new URLSearchParams(window.location.search);
    
    // 2. Check if 'success' is equal to 'true'
    if (params.has('success') && params.get('success') === 'true') {
        // 4. Remove the '?success=true' from the URL without reloading the page
        const cleanUrl = window.location.origin + window.location.pathname;
        window.history.replaceState({}, document.title, cleanUrl);
    }

    function validatePasswords() {
        const newPass = document.getElementById('newPass').value;
        const confirmPass = document.getElementById('confirmPass').value;
        
        if (newPass !== confirmPass) {
            alert('Passwords do not match!');
            return false;
        }
        
        if (newPass.length < 6) {
            alert('Password must be at least 6 characters long!');
            return false;
        }
        
        return true;
    }
</script>

</body>

</html>
