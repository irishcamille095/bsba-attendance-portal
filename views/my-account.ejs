            <div style="display: flex; gap: 12px; flex-direction: column;">
                <button onclick="cancelFinalDeletion()" style="width: 100%; background: #444; color: white; padding: 12px; border: 2px solid #555; border-radius: 4px; cursor: pointer; font-weight: bold; transition: all 0.3s; font-size: 1em;">← No, Cancel Deletion</button>
