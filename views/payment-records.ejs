<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#FFD700">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/assets/img/logo.jpg">
    <title>Payment Records - BSBA Portal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body { 
            font-family: 'Segoe UI', sans-serif; 
            background: #121212;
            display: flex;
        }
        
        /* Sidebar */
        .sidebar { 
            display: none;
            width: 250px;
            background: #000;
            color: #ffcc00;
            height: 100vh;
            position: fixed;
            padding: 20px;
            border-right: 4px solid #ffcc00;
            overflow-y: auto;
        }

        .sidebar h2 {
            border-bottom: 2px solid #ffcc00;
            padding-bottom: 10px;
            text-align: center;
            margin-bottom: 20px;
        }

        .sidebar h3 {
            color: #ffcc00;
            margin-top: 20px;
            margin-bottom: 10px;
            font-size: 14px;
            text-transform: uppercase;
        }

        .sidebar a {
            color: white;
            padding: 12px;
            display: block;
            text-decoration: none;
            transition: all 0.2s;
        }

        .sidebar a:hover {
            color: #ffcc00;
            background: rgba(255, 204, 0, 0.1);
        }

        .sidebar-notification-badge {
            display: inline-block;
            background: #ff4444;
            color: white;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            line-height: 20px;
            text-align: center;
            font-size: 0.7em;
            font-weight: bold;
            margin-left: 8px;
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(255, 68, 68, 0.7); }
            50% { box-shadow: 0 0 0 8px rgba(255, 68, 68, 0); }
        }

        .logout-btn {
            background: #ffcc00;
            color: #000;
            border: none;
            padding: 12px;
            width: 100%;
            margin-top: 30px;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .logout-btn:hover {
            background: #e6b800;
        }

        /* Mobile Menu Toggle */
        .mobile-menu-toggle {
            display: none !important;
            background: #FFD700;
            color: #000;
            border: none;
            padding: 12px 15px;
            cursor: pointer;
            font-size: 18px;
            border-radius: 5px;
            position: fixed;
            top: 20px;
            left: 20px;
            z-index: 1001;
            font-weight: bold;
        }
        
        /* Main Content */
        .content { 
            flex: 1; 
            margin-left: 0; 
            padding: 30px;
            width: 100%;
        }
        
        /* Header */
        header {
            background: #FFD700;
            color: #000;
            padding: 20px;
            text-align: center;
            border-radius: 8px;
            margin-bottom: 30px;
        }

        header h1 {
            font-size: 28px;
            margin-bottom: 5px;
            color: #000 !important;
        }

        header p {
            display: none;
        }

        .header-info {
            background: #222;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 30px;
            border-left: 4px solid #FFD700;
        }

        .header-info p {
            color: white;
            margin: 8px 0;
        }

        .header-info strong {
            color: #FFD700;
        }

        /* Back Button */
        .back-btn {
            display: inline-block;
            background: #FFD700;
            color: #000;
            padding: 12px 25px;
            border: 2px solid #FFD700;
            border-radius: 5px;
            text-decoration: none;
            margin-bottom: 20px;
            font-weight: bold;
            transition: all 0.3s;
            margin-top: 50px;
            font-size: 14px;
        }

        .back-btn:hover {
            background: #e6b800;
            border-color: #e6b800;
        }

        /* Table */
        table {
            width: 100%;
            border-collapse: collapse;
            background: #1a1a1a;
            margin-bottom: 30px;
            border-radius: 8px;
            overflow: hidden;
        }

        table thead {
            background: #800000;
            color: #FFD700;
            text-align: left;
        }

        table th {
            padding: 15px;
            font-weight: bold;
        }

        table td {
            padding: 12px 15px;
            border-bottom: 1px solid #333;
            color: white;
        }

        table tbody tr:hover {
            background: #252525;
        }

        /* Status Badge */
        .status-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: bold;
        }

        .status-pending {
            background: #ff9800;
            color: white;
        }

        .status-verified {
            background: #4CAF50;
            color: white;
        }

        .status-rejected {
            background: #f44336;
            color: white;
        }

        /* No Records Message */
        .no-records {
            background: #222;
            color: #FFD700;
            padding: 30px;
            border-radius: 5px;
            text-align: center;
        }

        /* Officer Info */
        .officer-info {
            background: #222;
            padding: 15px;
            border-radius: 5px;
            font-size: 12px;
            margin-top: 10px;
        }

        .officer-info p {
            color: #ccc;
            margin: 5px 0;
        }

        .officer-info strong {
            color: #FFD700;
        }

        /* Rejection Reason */
        .rejection-reason {
            background: rgba(244, 67, 54, 0.1);
            border-left: 3px solid #f44336;
            padding: 10px 15px;
            border-radius: 3px;
            font-size: 12px;
            margin-top: 8px;
        }

        .rejection-reason p {
            color: white;
            margin: 5px 0;
        }

        /* Table Wrapper for Overflow */
        .table-wrapper {
            overflow-x: auto;
            border-radius: 8px;
            margin-bottom: 30px;
        }

        /* Mobile Responsive Styles */
        @media (max-width: 1024px) {
            .sidebar {
                width: 200px;
                padding: 15px;
            }
            
            .content {
                margin-left: 220px;
                padding: 20px;
            }

            header h1 {
                font-size: 22px;
            }

            table th, table td {
                padding: 10px;
                font-size: 13px;
            }
        }

        @media (max-width: 768px) {
            .mobile-menu-toggle {
                display: block;
            }

            .sidebar {
                transform: translateX(-100%);
                transition: transform 0.3s ease;
                z-index: 1000;
                width: 250px;
                left: 0;
            }

            .sidebar.active {
                transform: translateX(0);
            }

            .content {
                margin-left: 0;
                padding: 20px 15px;
            }

            header {
                padding: 15px;
                margin-bottom: 20px;
            }

            header h1 {
                font-size: 20px;
                margin-bottom: 3px;
            }

            header p {
                font-size: 12px;
            }

            .back-btn {
                display: inline-block;
                padding: 8px 15px;
                font-size: 12px;
                margin-bottom: 15px;
            }

            .header-info {
                padding: 15px;
                margin-bottom: 20px;
            }

            .header-info p {
                font-size: 13px;
                margin: 6px 0;
            }

            table {
                font-size: 12px;
                margin-bottom: 20px;
            }

            table th, table td {
                padding: 8px 10px;
            }

            table th {
                padding: 10px 8px;
            }

            .status-badge {
                font-size: 10px;
                padding: 4px 8px;
            }
        }

        @media (max-width: 480px) {
            .mobile-menu-toggle {
                padding: 10px 12px;
                font-size: 16px;
                top: 15px;
                left: 15px;
            }

            .content {
                padding: 15px 10px;
            }

            header {
                padding: 12px;
                margin-bottom: 15px;
            }

            header h1 {
                font-size: 18px;
            }

            .back-btn {
                padding: 6px 12px;
                font-size: 11px;
            }

            .header-info {
                padding: 12px;
                margin-bottom: 15px;
            }

            .header-info p {
                font-size: 12px;
                margin: 5px 0;
            }

            table {
                font-size: 11px;
            }

            table th, table td {
                padding: 6px 8px;
            }

            .no-records {
                padding: 20px 15px;
            }
        }
    </style>
</head>
<body>
    <!-- Mobile Menu Toggle -->
    <button class="mobile-menu-toggle" id="menuToggle">☰ Menu</button>

    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <button style="background: none; border: none; color: #ffcc00; font-size: 24px; cursor: pointer; display: block; margin-left: auto; margin-bottom: 15px;" onclick="closeMobileMenu()">✕</button>
        <h2>BSBA Portal</h2>
        
        <% if (user.role === 'student') { %>
            <h3>Account</h3>
            <a href="/dashboard"><i class="fas fa-home"></i> Dashboard</a>
            <a href="/attendance"><i class="fas fa-calendar"></i> Attendance</a>
            <a href="/wallet"><i class="fas fa-wallet"></i> Wallet & Fines</a>
            <a href="/my-account"><i class="fas fa-user"></i> My Account</a>
        <% } else if (user.role === 'adviser') { %>
            <h3>Class Management</h3>
            <a href="/dashboard"><i class="fas fa-home"></i> Dashboard</a>
            <a href="/folder-details"><i class="fas fa-folder"></i> Classes</a>
            <a href="/attendance"><i class="fas fa-calendar"></i> Attendance</a>
            <a href="/my-account"><i class="fas fa-user"></i> My Account</a>

            <h3>Finance</h3>
            <a href="/fines-management"><i class="fas fa-coins"></i> Fines Management</a>
        <% } else if (user.role === 'officer') { %>
            <h3>Dashboard</h3>
            <a href="/officer-dashboard"><i class="fas fa-home"></i> Dashboard</a>
            <a href="/master-student-list"><i class="fas fa-users"></i> Student List</a>
            
            <h3>Reports</h3>
            <a href="/report"><i class="fas fa-chart-bar"></i> Attendance Report</a>

            <h3>Finance</h3>
            <a href="/fines-management"><i class="fas fa-coins"></i> Fines Management</a>

            <h3>Account</h3>
            <a href="/my-account"><i class="fas fa-user"></i> My Account</a>
        <% } %>

        <form action="/logout" method="POST">
            <button class="logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</button>
        </form>
    </div>

    <!-- Main Content -->
    <div class="content">
        <a href="/fines-management" class="back-btn">← Back to Fines Management</a>

        <header>
            <h1>📋 Transaction History</h1>
        </header>

        <!-- Student Information -->
        <% 
            const verifiedAmount = paymentRecords.filter(p => p.status === 'verified').reduce((sum, p) => sum + p.amount, 0);
            const totalFine = paymentRecords.reduce((sum, p) => sum + p.amount, 0) + (paymentRecords.filter(p => p.status !== 'verified').reduce((sum, p) => sum + p.amount, 0) * 0);
        %>
        <div class="header-info">
            <p><strong>Student ID:</strong> <%= student.mmId %></p>
            <p><strong>Student Name:</strong> <%= student.firstName %> <%= student.lastName %></p>
            <p><strong>Your Pending/Total Fines:</strong> ₱<%= paymentRecords.filter(p => p.status === 'pending').reduce((sum, p) => sum + p.amount, 0).toFixed(2) %></p>
            <p><strong>Verified Amount:</strong> ₱<%= verifiedAmount.toFixed(2) %></p>
            <p><strong>Remaining Balance:</strong> ₱<%= (paymentRecords.filter(p => p.status === 'pending').reduce((sum, p) => sum + p.amount, 0)).toFixed(2) %></p>
        </div>

        <!-- Payment Records Table -->
        <% if (paymentRecords && paymentRecords.length > 0) { %>
            <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Date Submitted</th>
                        <th>Amount</th>
                        <th>Payment Method</th>
                        <th>Status</th>
                        <th>Verified/Rejected By</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    <% paymentRecords.forEach(payment => { %>
                        <tr>
                            <td><strong><%= new Date(payment.submittedAt).toLocaleDateString('en-US', {year: 'numeric', month: 'short', day: 'numeric'}) %></strong></td>
                            <td>₱<%= payment.amount.toFixed(2) %></td>
                            <td>
                                <% if (payment.paymentMethod === 'cash') { %>
                                    💵 Cash
                                <% } else if (payment.paymentMethod === 'service') { %>
                                    🔧 Service
                                <% } else { %>
                                    <%= payment.paymentMethod %>
                                <% } %>
                            </td>
                            <td>
                                <% if (payment.status === 'pending') { %>
                                    <span class="status-badge status-pending">Pending</span>
                                <% } else if (payment.status === 'verified') { %>
                                    <span class="status-badge status-verified">Verified</span>
                                <% } else if (payment.status === 'rejected') { %>
                                    <span class="status-badge status-rejected">Rejected</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (payment.verifiedBy) { %>
                                    <strong><%= payment.verifiedBy %></strong>
                                    <% if (payment.verifiedAt) { %>
                                        <br><small><%= new Date(payment.verifiedAt).toLocaleDateString('en-US', {year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'}) %></small>
                                    <% } %>
                                <% } else { %>
                                    <small style="color: #999;">Pending verification</small>
                                <% } %>
                            </td>
                            <td>
                                <% if (payment.status === 'rejected' && payment.rejectionReason) { %>
                                    <div class="rejection-reason">
                                        <p><strong>Rejection Reason:</strong></p>
                                        <p><%= payment.rejectionReason %></p>
                                    </div>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
            </div>
        <% } else { %>
            <div class="no-records">
                <p>No payment records found for this student.</p>
            </div>
        <% } %>
    </div>

    <script>
        // Optional: Add print functionality
        function printRecords() {
            window.print();
        }

        // Mobile Menu Toggle
        document.getElementById('menuToggle').addEventListener('click', function() {
            document.getElementById('sidebar').classList.toggle('active');
        });

        function closeMobileMenu() {
            document.getElementById('sidebar').classList.remove('active');
        }

        // Close sidebar when clicking on a link
        document.querySelectorAll('.sidebar a').forEach(link => {
            link.addEventListener('click', closeMobileMenu);
        });
    </script>
<%- include('./_footer.ejs') %>
</body>
</html>
